index 0000000000000000000000000000000000000000..804fa46a40f49da9270b941253f2cacb1915e757
--- /dev/null
+++ b/crates/jxl-oxide-tests/tests/ma_table_bound_overflow.rs
@@ -0,0 +1,16 @@
+//! Regression test: An MA tree split value of i32::MIN or i32::MAX overflowed the lookup table bounds.
+
+use jxl_oxide::{AllocTracker, JxlImage};
+
+#[test]
+fn ma_table_bound_overflow() {
+    let data = include_bytes!("fuzz_findings/ma_table_bound_overflow.fuzz");
+    let image = JxlImage::builder()
+        .alloc_tracker(AllocTracker::with_limit(128 * 1024 * 1024)) // 128 MiB
+        .read(std::io::Cursor::new(data));
+    if let Ok(image) = image {
+        for keyframe_idx in 0..image.num_loaded_keyframes() {
+            let _ = image.render_frame(keyframe_idx);
+        }
+    }
+}
