filter: skip the edge-preserving filter when the padded color region is not inside the frame buffer,
instead of assert!(region.contains(color_padded_region)) (epf.rs). Test: epf_region_contains
(crates/jxl-oxide-tests/tests/epf_region_contains.rs).

Upstream: not reported; the code is unchanged at upstream HEAD (c0cc4c7, 2026-08-15).

diff --git a/crates/jxl-render/src/filter/epf.rs b/crates/jxl-render/src/filter/epf.rs
index 4f4f4dc..34333cf 100644
--- a/crates/jxl-render/src/filter/epf.rs
+++ b/crates/jxl-render/src/filter/epf.rs
@@ -22,7 +22,9 @@ pub fn apply_epf<S: Sample>(
     let _guard = span.enter();
 
     let region = fb_image.regions_and_shifts()[0].0;
-    assert!(region.contains(color_padded_region));
+    if !region.contains(color_padded_region) {
+        return;
+    }
     let left = region.left.abs_diff(color_padded_region.left) as usize;
     let top = region.top.abs_diff(color_padded_region.top) as usize;
     let right = left + color_padded_region.width as usize;
diff --git a/crates/jxl-oxide-tests/tests/epf_region_contains.rs b/crates/jxl-oxide-tests/tests/epf_region_contains.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5102deb27ef5e0c7d34fc540a0581e8757419f81
--- /dev/null
+++ b/crates/jxl-oxide-tests/tests/epf_region_contains.rs
@@ -0,0 +1,16 @@
+//! Regression test: The edge-preserving filter on a region outside the frame buffer hit an assert.
+
+use jxl_oxide::{AllocTracker, JxlImage};
+
+#[test]
+fn epf_region_contains() {
+    let data = include_bytes!("fuzz_findings/epf_region_contains.fuzz");
+    let image = JxlImage::builder()
+        .alloc_tracker(AllocTracker::with_limit(128 * 1024 * 1024)) // 128 MiB
+        .read(std::io::Cursor::new(data));
+    if let Ok(image) = image {
+        for keyframe_idx in 0..image.num_loaded_keyframes() {
+            let _ = image.render_frame(keyframe_idx);
+        }
+    }
+}
