+/// Bounds spline coordinates and accumulated deltas, as libjxl does. Rendering works in `f32`,
+/// which can't step along a spline by unit arc lengths at larger coordinates.
+fn validate_spline_point_pos(x: i64, y: i64) -> std::result::Result<(), jxl_bitstream::Error> {
+    const SPLINE_POS_LIMIT: i64 = 1 << 23;
+    if x.abs() >= SPLINE_POS_LIMIT || y.abs() >= SPLINE_POS_LIMIT {
+        tracing::error!(x, y, "Spline coordinates out of bounds");
+        return Err(jxl_bitstream::Error::ValidationFailed(
+            "spline coordinates out of bounds",
+        ));
+    }
+    Ok(())
+}
