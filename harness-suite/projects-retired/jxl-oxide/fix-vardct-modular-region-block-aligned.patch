+//! Regression test: A VarDCT frame with a palette or squeeze modular image hit a size assert.
+
+use jxl_oxide::{AllocTracker, JxlImage};
+
+#[test]
+fn vardct_modular_region_block_aligned() {
+    let data = include_bytes!("fuzz_findings/vardct_modular_region_block_aligned.fuzz");
+    let image = JxlImage::builder()
+        .alloc_tracker(AllocTracker::with_limit(128 * 1024 * 1024)) // 128 MiB
+        .read(std::io::Cursor::new(data));
+    if let Ok(image) = image {
+        for keyframe_idx in 0..image.num_loaded_keyframes() {
+            let _ = image.render_frame(keyframe_idx);
+        }
+    }
+}
