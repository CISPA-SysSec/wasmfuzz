+++ b/crates/jxl-grid/src/alloc_tracker.rs
@@ -28,7 +28,11 @@ impl AllocTracker {
     ///
     /// Returns an error if the allocation exceeds the current limit.
     pub fn alloc<T>(&self, count: usize) -> Result<AllocHandle, crate::OutOfMemory> {
-        let bytes = count * std::mem::size_of::<T>();
+        // Unchecked on 32-bit targets this wraps, so a huge request passes the limit and the
