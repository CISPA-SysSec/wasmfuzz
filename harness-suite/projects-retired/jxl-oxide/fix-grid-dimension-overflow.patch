index 0000000000000000000000000000000000000000..890ac172a73d040c11440ba182a8d8600ca577ae
--- /dev/null
+++ b/crates/jxl-oxide-tests/tests/grid_dimension_overflow.rs
@@ -0,0 +1,17 @@
+//! Regression test: Grid dimensions whose product overflows usize panicked.
+//! Only fails on 32-bit targets.
+
+use jxl_oxide::{AllocTracker, JxlImage};
+
+#[test]
+fn grid_dimension_overflow() {
+    let data = include_bytes!("fuzz_findings/grid_dimension_overflow.fuzz");
+    let image = JxlImage::builder()
+        .alloc_tracker(AllocTracker::with_limit(128 * 1024 * 1024)) // 128 MiB
+        .read(std::io::Cursor::new(data));
+    if let Ok(image) = image {
+        for keyframe_idx in 0..image.num_loaded_keyframes() {
+            let _ = image.render_frame(keyframe_idx);
+        }
+    }
+}
