frame: use checked arithmetic for the spline control point counts. On 32-bit targets
acc_control_points + num_points wrapped past the "too many spline points" check and
Vec::with_capacity(1 + num_points) panicked (capacity overflow). Test: spline_point_count_overflow
(crates/jxl-oxide-tests/tests/spline_point_count_overflow.rs). The input only fails on 32-bit
targets (upstream CI runs the tests on armv7).

Upstream: not reported; the code is unchanged at upstream HEAD (c0cc4c7, 2026-08-15).

diff --git a/crates/jxl-frame/src/data/spline.rs b/crates/jxl-frame/src/data/spline.rs
index 1cf3ac0..3bf3e1f 100644
--- a/crates/jxl-frame/src/data/spline.rs
+++ b/crates/jxl-frame/src/data/spline.rs
@@ -167,14 +167,24 @@ impl Bundle<QuantSplineParams<'_>> for QuantSpline {
         } = params;
 
         let num_points = decoder.read_varint(bitstream, 3)? as usize;
-        let acc_num_points = acc_control_points + num_points;
+        let acc_num_points = acc_control_points
+            .checked_add(num_points)
+            .ok_or(jxl_bitstream::Error::ValidationFailed(
+                "spline control point count overflowed",
+            ))?;
         let max_num_points = usize::min(MAX_NUM_CONTROL_POINTS, num_pixels / 2);
         if acc_num_points > max_num_points {
             tracing::error!(num_points, max_num_points, "Too many spline points");
             return Err(jxl_bitstream::Error::ProfileConformance("too many spline points").into());
         }
 
-        let mut quant_points = Vec::with_capacity(1 + num_points);
+        let mut quant_points = Vec::with_capacity(
+            num_points
+                .checked_add(1)
+                .ok_or(jxl_bitstream::Error::ValidationFailed(
+                    "spline point vector capacity overflowed",
+                ))?,
+        );
         let mut cur_value = start_point;
         let mut cur_delta = (0, 0);
         let mut manhattan_distance = 0u64;
