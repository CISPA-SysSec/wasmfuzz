+//! Regression test: A varblock larger than 8x8 in a chroma-subsampled frame indexed past its group.
+
+use jxl_oxide::{AllocTracker, JxlImage};
+
+#[test]
+fn varblock_chroma_subsampling() {
+    let data = include_bytes!("fuzz_findings/varblock_chroma_subsampling.fuzz");
+    let image = JxlImage::builder()
+        .alloc_tracker(AllocTracker::with_limit(128 * 1024 * 1024))
+        .read(std::io::Cursor::new(data));
+    if let Ok(image) = image {
+        for keyframe_idx in 0..image.num_loaded_keyframes() {
+            let _ = image.render_frame(keyframe_idx);
+        }
+    }
+}
