diff --git a/crates/ruff_linter/src/rules/pylint/rules/empty_comment.rs b/crates/ruff_linter/src/rules/pylint/rules/empty_comment.rs
index e48e89f45f379d091550011b29c6c6ee49b9be19..517ae47a4dbf64fab60d0a945706e859bb712cf9 100644
--- a/crates/ruff_linter/src/rules/pylint/rules/empty_comment.rs
+++ b/crates/ruff_linter/src/rules/pylint/rules/empty_comment.rs
@@ -69,12 +69,14 @@ pub(crate) fn empty_comments(
 
 /// Return a [`Diagnostic`] if the comment at the given [`TextRange`] is empty.
 fn empty_comment(context: &LintContext, range: TextRange, locator: &Locator, indexer: &Indexer) {
-    // Check: is the comment empty?
+    // Check: is the comment empty? Any whitespace counts, not only Python whitespace: the
+    // formatter strips all trailing whitespace from comments (like Black), so e.g. `#\x0b`
+    // would otherwise only be reported once it has been formatted.
     if !locator
         .slice(range)
         .chars()
         .skip(1)
-        .all(is_python_whitespace)
+        .all(char::is_whitespace)
     {
         return;
     }
