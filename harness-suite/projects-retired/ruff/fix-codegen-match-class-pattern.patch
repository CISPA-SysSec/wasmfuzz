+    fn unparse_pattern_parenthesized(&mut self, ast: &Pattern, parenthesize: bool) {
+        // A bare capture pattern (`case x as y`) doesn't need parentheses.
+        let parenthesize = parenthesize
+            && !matches!(
+                ast,
+                Pattern::MatchAs(ast::PatternMatchAs { pattern: None, .. })
+            );
+        self.p_if(parenthesize, "(");
+        self.unparse_pattern(ast);
+        self.p_if(parenthesize, ")");
+    }
+
