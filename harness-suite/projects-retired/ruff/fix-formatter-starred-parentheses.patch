diff --git a/crates/ruff_python_formatter/src/expression/expr_starred.rs b/crates/ruff_python_formatter/src/expression/expr_starred.rs
index 57dd3c7affb8ee49c36c8cd90cfa3737097ae838..e274749320c49606eb6d94ace33985656939c5b2 100644
--- a/crates/ruff_python_formatter/src/expression/expr_starred.rs
+++ b/crates/ruff_python_formatter/src/expression/expr_starred.rs
@@ -32,6 +32,8 @@ impl NeedsParentheses for ExprStarred {
         _parent: AnyNodeRef,
         _context: &PyFormatContext,
     ) -> OptionalParentheses {
-        OptionalParentheses::Multiline
+        // A parenthesized starred expression is never valid syntax: `x = (*a)` is a syntax error,
+        // whereas `x = *a` is only rejected by the compiler (and `x = *a, b` is fine).
+        OptionalParentheses::Never
     }
 }
