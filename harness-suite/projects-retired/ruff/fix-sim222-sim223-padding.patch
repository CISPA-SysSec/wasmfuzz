+/// Pads the replacement with whitespace where it would otherwise merge with the surrounding
+/// tokens, e.g. `if() and x:` must become `if False:`, not `ifFalse:`.
+fn pad_short_circuit_edit(edit: Edit, checker: &Checker) -> Edit {
+    let range = edit.range();
+    let content = edit.content().unwrap_or_default().to_string();
+    Edit::range_replacement(pad(content, range, checker.locator()), range)
+}
+
 fn get_short_circuit_edit(
     expr: &Expr,
     range: TextRange,
@@ -841,7 +849,7 @@ pub(crate) fn expr_or_true(checker: &Checker, expr: &Expr) {
             },
             edit.range(),
         );
-        diagnostic.set_fix(Fix::unsafe_edit(edit));
+        diagnostic.set_fix(Fix::unsafe_edit(pad_short_circuit_edit(edit, checker)));
     }
 }
 
