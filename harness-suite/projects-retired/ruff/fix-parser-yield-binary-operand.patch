@@ -294,6 +294,18 @@ impl<'src> Parser<'src> {
                 break;
             }
 
+            // test_err yield_expr_binary_operand
+            // (yield >> x)
+            // (yield < x)
+            // (yield or x)
+            // lambda: (yield >= x)
+
+            // A `yield` expression can't be an operand without its own parentheses, e.g.
+            // `(yield >> x)`: a bare `yield` stops before an operator that can't start its value.
+            if !left.is_parenthesized && matches!(left.expr, Expr::Yield(_) | Expr::YieldFrom(_)) {
+                self.add_error(ParseErrorType::InvalidYieldExpressionUsage, &left.expr);
+            }
+
             left.expr = match operator {
                 BinaryLikeOperator::Boolean(bool_op) => {
                     Expr::BoolOp(self.parse_boolean_expression(left.expr, start, bool_op, context))
