+            // A single tuple context manager keeps an extra pair of parentheses: `with (a, b):` has
+            // two context managers.
+            // ```python
+            // with ((a, b)):
+            //     pass
+            // ```
+            // Unless an element can't be a context manager, which makes it a tuple anyway:
+            // `with (a, *b):` and `with (x := a, y := b):`.
+            if single.optional_vars.is_none()
+                && single.context_expr.as_tuple_expr().is_some_and(|tuple| {
+                    !tuple.is_empty()
+                        && tuple.iter().all(|element| match element {
+                            Expr::Starred(_) => false,
+                            Expr::Named(_) => context.is_expression_parenthesized(element.into()),
+                            _ => true,
+                        })
+                })
+            {
+                return Ok(Self::Parenthesized);
+            }
+
