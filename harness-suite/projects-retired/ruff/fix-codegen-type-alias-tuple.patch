Codegen: `type Foo = (int, str)` was unparsed without the parentheses (a syntax error).
Regression test included; fuzz repro: repro/fix-codegen-type-alias-tuple.py (ruff_parse_idempotency).

diff --git a/crates/ruff_python_codegen/src/generator.rs b/crates/ruff_python_codegen/src/generator.rs
index ffece40fa2285f0ce7d3202ace997a69445e77e1..a3cde95b27c21e3f7fe2629d005322ef0d85d183 100644
--- a/crates/ruff_python_codegen/src/generator.rs
+++ b/crates/ruff_python_codegen/src/generator.rs
@@ -563,7 +563,8 @@ impl<'a> Generator<'a> {
                         self.unparse_type_params(type_params);
                     }
                     self.p(" = ");
-                    self.unparse_expr(value, precedence::ASSIGN);
+                    // The value is an `expression`: a tuple has to be parenthesized.
+                    self.unparse_expr(value, precedence::COMMA);
                 });
             }
             Stmt::Raise(ast::StmtRaise {
@@ -1907,6 +1908,9 @@ class Foo:
         assert_round_trip!(r"type Foo[*Ts = *int] = ...");
         assert_round_trip!(r"type Foo[**P = int] = ...");
         assert_round_trip!(r"type Foo[T, U, *Ts, **P] = ...");
+        // The value is an `expression`, not an `expressions` list.
+        assert_round_trip!(r"type Foo = (int, str)");
+        assert_round_trip!(r"type Foo = (yield)");
         // https://github.com/astral-sh/ruff/issues/6498
         assert_round_trip!(r"f(a=1, *args, **kwargs)");
         assert_round_trip!(r"f(*args, a=1, **kwargs)");
