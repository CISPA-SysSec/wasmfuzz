 pub(super) fn pattern_to_expr(pattern: Pattern) -> Expr {
+    // The conversion recurses once per nesting level of the pattern, and the parser accepts
+    // arbitrarily deep patterns (it grows the stack while parsing them), so grow the stack here
+    // as well. Without this, an invalid deeply nested pattern such as `case [[[...]]]():`
+    // overflows the stack.
+    stacker::maybe_grow(STACK_RED_ZONE, STACK_SIZE, || pattern_to_expr_impl(pattern))
+}
