+#[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+#[test]
+fn nested_invalid_pattern_to_expr_grows_stack() {
+    // An invalid class pattern (`[...]()`) or complex literal pattern (`[...]+1j`) converts the
+    // whole deeply nested pattern to an expression during error recovery (fuzz: ruff_parse_simple).
+    let depth = 100_000;
+    for suffix in ["()", "+1j"] {
+        let src = format!(
+            "match x:\n    case {}{}{}:\n        pass\n",
+            "[".repeat(depth),
+            "]".repeat(depth),
+            suffix
+        );
+        let parsed = crate::parse_unchecked(&src, ParseOptions::from(Mode::Module));
+        assert!(!parsed.errors().is_empty());
+        // Dropping the AST is recursive too; do it on a large stack so the test checks the parser.
+        stacker::grow(256 * 1024 * 1024, move || drop(parsed));
+    }
+}
