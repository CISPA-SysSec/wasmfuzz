+///
+/// When the unary expression is the rightmost operand of an unparenthesized binary-like
+/// expression (`a < +x`, `a + +x`, `a and not x`), attaching the comment as dangling on the
+/// unary node puts `expand_parent` inside the binary-like group. That forces the group to
+/// split on the first pass; after formatting, the comment sits after the whole expression
+/// (and any following list comma), so the second pass does not split — a stability failure.
+/// Re-parent those comments onto the enclosing binary-like expression so they are formatted
+/// outside that group.
 fn handle_unary_op_comment<'a>(
     comment: DecoratedComment<'a>,
     unary_op: &'a ast::ExprUnaryOp,
+    trivia: &TriviaRanges,
     source: &str,
 ) -> CommentPlacement<'a> {
     let mut tokenizer = SimpleTokenizer::new(
@@ -1957,12 +1968,38 @@ fn handle_unary_op_comment<'a>(
         .find(|token| token.kind == SimpleTokenKind::LParen)
         .map_or(unary_op.operand.start(), |lparen| lparen.start());
     if comment.end() < up_to && comment.line_position().is_end_of_line() {
+        if !trivia.parenthesized().contains(unary_op.range())
+            && let Some(parent) = comment.enclosing_parent()
+            && is_rightmost_operand_of_binary_like(unary_op, parent)
+        {
+            return CommentPlacement::trailing(parent, comment);
+        }
         CommentPlacement::dangling(unary_op, comment)
     } else {
         CommentPlacement::Default(comment)
     }
 }
 
+/// Returns `true` if `unary_op` is the rightmost operand of `parent` when `parent` is a
+/// compare, binary, or boolean operation.
+fn is_rightmost_operand_of_binary_like(
+    unary_op: &ast::ExprUnaryOp,
+    parent: AnyNodeRef<'_>,
+) -> bool {
+    match parent {
+        AnyNodeRef::ExprCompare(compare) => compare
+            .comparators()
+            .last()
+            .is_some_and(|comparator| comparator.range() == unary_op.range()),
+        AnyNodeRef::ExprBinOp(bin_op) => bin_op.right.range() == unary_op.range(),
+        AnyNodeRef::ExprBoolOp(bool_op) => bool_op
+            .values
+            .last()
+            .is_some_and(|value| value.range() == unary_op.range()),
+        _ => false,
+    }
+}
