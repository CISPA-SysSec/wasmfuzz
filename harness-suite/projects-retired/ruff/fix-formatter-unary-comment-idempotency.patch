+    /// Fuzz regression: list item `a < +Mte5` with an end-of-line comment between
+    /// unary `+` and its operand must be idempotent, including at the harness line width.
+    #[test]
+    fn unary_compare_comment_in_list_is_idempotent() -> Result<()> {
+        use ruff_formatter::LineWidth;
+
+        let input = "[a\n\n\n\n\n\n\n\n\n\n\n<+#\nMte5,d]";
+        let options = PyFormatOptions::default().with_line_width(LineWidth::try_from(400).unwrap());
+        let formatted = format_module_source(input, options.clone())?
+            .as_code()
+            .to_string();
+        let reformatted = format_module_source(&formatted, options)?
+            .as_code()
+            .to_string();
+        assert_eq!(formatted, reformatted);
+        assert_eq!(formatted, "[\n    a < +Mte5,  #\n    d,\n]\n");
+        Ok(())
+    }
