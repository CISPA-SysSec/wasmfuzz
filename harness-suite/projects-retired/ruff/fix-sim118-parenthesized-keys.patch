@@ -60,7 +60,7 @@ impl AlwaysFixableViolation for InDictKeys {
 fn key_in_dict(checker: &Checker, left: &Expr, right: &Expr, operator: CmpOp, parent: AnyNodeRef) {
     let Expr::Call(ast::ExprCall {
         func,
-        arguments: Arguments { args, keywords, .. },
+        arguments: arguments @ Arguments { args, keywords, .. },
         range_start: _,
         node_index: _,
     }) = &right
@@ -132,29 +132,28 @@ fn key_in_dict(checker: &Checker, left: &Expr, right: &Expr, operator: CmpOp, pa
             }
         };
 
+        // Delete `.keys` and the call parentheses separately: the attribute may be parenthesized,
+        // as in `key in (foo.keys)()`.
+        let keys_edit = Edit::deletion(dot.start(), func.end());
+
         // If the `.keys()` is followed by (e.g.) a keyword, we need to insert a space,
         // since we're removing parentheses, which could lead to invalid syntax, as in:
         // ```python
         // if key in foo.keys()and bar:
         // ```
-        let range = TextRange::new(dot.start(), right.end());
-        if checker
+        let range = arguments.range();
+        let call_edit = if checker
             .locator()
             .after(range.end())
             .chars()
             .next()
             .is_some_and(|char| char.is_ascii_alphabetic())
         {
-            diagnostic.set_fix(Fix::applicable_edit(
-                Edit::range_replacement(" ".to_string(), range),
-                applicability,
-            ));
+            Edit::range_replacement(" ".to_string(), range)
         } else {
-            diagnostic.set_fix(Fix::applicable_edit(
-                Edit::range_deletion(range),
-                applicability,
-            ));
-        }
+            Edit::range_deletion(range)
+        };
+        diagnostic.set_fix(Fix::applicable_edits(keys_edit, [call_edit], applicability));
     }
 }
 
