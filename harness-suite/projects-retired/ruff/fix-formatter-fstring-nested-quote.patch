@@ -946,12 +949,19 @@ pub(super) fn is_fstring_with_quoted_debug_expression(
 /// ```python
 /// f"{'''other " '''}'
 /// ```
+///
+/// `quote` is the quote that the outer f-string would use: it must not appear in the nested
+/// literals. In valid pre-3.12 code, the nested literals use the opposite quote of the outer
+/// f-string, but the input can be 3.12+ code that reuses the outer quote (`f'{''''a'''}'`):
+/// checking the nested literal's own quote made the quotes oscillate between runs.
 pub(super) fn is_fstring_with_triple_quoted_literal_expression_containing_quotes(
     fstring: &FString,
+    quote: Quote,
     context: &PyFormatContext,
 ) -> bool {
     struct Visitor<'a> {
         context: &'a PyFormatContext<'a>,
+        quote: Quote,
         found: bool,
     }
 
@@ -963,12 +973,12 @@ pub(super) fn is_fstring_with_triple_quoted_literal_expression_containing_quotes
 
             let contains_quotes = match part {
                 StringLikePart::String(_) | StringLikePart::Bytes(_) => {
-                    self.contains_quote(part.content_range(), part.flags())
+                    self.contains_quote(part.content_range())
                 }
                 StringLikePart::FString(fstring) => {
                     let mut contains_quotes = false;
                     for literal in fstring.elements.literals() {
-                        if self.contains_quote(literal.range(), fstring.flags.into()) {
+                        if self.contains_quote(literal.range()) {
                             contains_quotes = true;
                             break;
                         }
@@ -979,7 +989,7 @@ pub(super) fn is_fstring_with_triple_quoted_literal_expression_containing_quotes
                 StringLikePart::TString(tstring) => {
                     let mut contains_quotes = false;
                     for literal in tstring.elements.literals() {
-                        if self.contains_quote(literal.range(), tstring.flags.into()) {
+                        if self.contains_quote(literal.range()) {
                             contains_quotes = true;
                             break;
                         }
@@ -994,8 +1004,8 @@ pub(super) fn is_fstring_with_triple_quoted_literal_expression_containing_quotes
             }
         }
 
-        fn contains_quote(&self, range: TextRange, flags: AnyStringFlags) -> bool {
-            self.context.source()[range].contains(flags.quote_style().as_char())
+        fn contains_quote(&self, range: TextRange) -> bool {
+            self.context.source()[range].contains(self.quote.as_char())
         }
     }
 
@@ -1015,6 +1025,7 @@ pub(super) fn is_fstring_with_triple_quoted_literal_expression_containing_quotes
 
     let mut visitor = Visitor {
         context,
+        quote,
         found: false,
     };
 
