--- a/crates/ruff_linter/src/fix/edits.rs
+++ b/crates/ruff_linter/src/fix/edits.rs
@@ -82,6 +82,12 @@ pub(crate) fn delete_comment(range: TextRange, locator: &Locator) -> Edit {
             range.end() + trailing_space_len,
         )
     {
+        if let Some(continuation) = preceding_continuation(line_range.start(), locator) {
+            // Ex) `x = 1 \` + newline + `# noqa`: the comment ends the logical line, and deleting
+            // its whole line would join the continuation with the next line (or leave it dangling
+            // at the end of the file). Delete from the backslash to the end of the comment.
+            return Edit::deletion(continuation, line_range.end());
+        }
         let full_line_end = locator.full_line_end(line_range.end());
         Edit::deletion(line_range.start(), full_line_end)
     }
@@ -103,11 +109,32 @@ pub(crate) fn delete_comment(range: TextRange, locator: &Locator) -> Edit {
     }
     // Ex) `x = 1  # noqa here`
     else {
+        if range.start() - leading_space_len == line_range.start() {
+            // Ex) `x = 1 \` + newline + `# noqa here`: as above, the line is left empty.
+            if let Some(continuation) = preceding_continuation(line_range.start(), locator) {
+                return Edit::deletion(continuation, line_range.end());
+            }
+        }
         // Remove `# noqa here` and whitespace
         Edit::deletion(range.start() - leading_space_len, line_range.end())
     }
 }
 
+/// If the line before the line starting at `line_start` ends with a line continuation (`\`
+/// followed by a newline), return the offset of the backslash.
+///
+/// This only looks at the source text: a backslash at the end of a comment is reported, too.
+fn preceding_continuation(line_start: TextSize, locator: &Locator) -> Option<TextSize> {
+    let before = locator.up_to(line_start);
+    let before = before
+        .strip_suffix("\r\n")
+        .or_else(|| before.strip_suffix('\n'))
+        .or_else(|| before.strip_suffix('\r'))?;
+    before
+        .ends_with('\\')
+        .then(|| before.text_len() - '\\'.text_len())
+}
