@@ -0,0 +1,10 @@
+# Unused `noqa` directives on the last line of a line continuation: deleting the line would
+# join the continuation with the next line, or leave it dangling at the end of the file.
+x = 1 \
+# noqa: F401
+y = 2
+w = 4 \
+# noqa with a reason
+v = 5
+z = 3 \
+    # noqa
\ No newline at end of file
