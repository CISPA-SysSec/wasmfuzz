+
+    /// Like [`Self::with_preferred_quote`], but never switches the quote style.
+    ///
+    /// Use this when the surrounding quotes have already been written (for example
+    /// interpolated string literal parts) and the body must escape the quote
+    /// character those surrounding quotes use.
+    #[inline]
+    pub fn with_quote(source: &'a str, quote: Quote) -> Self {
+        let mut this = Self::with_preferred_quote(source, quote);
+        if this.layout.quote != quote {
+            this.layout.quote = quote;
+            // Force the slow path so matching quotes are escaped rather than
+            // written raw under a flipped quote style.
+            this.layout.len = None;
+        }
+        this
+    }
