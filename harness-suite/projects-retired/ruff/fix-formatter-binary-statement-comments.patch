+/// Comments inside a binary-like expression can force line breaks between its operands, e.g. when
+/// the formatter removes redundant parentheses (`a & (  # comment\n (b))`), and an expression
+/// statement can only break inside parentheses.
+const fn is_binary_like(expression: &Expr) -> bool {
+    matches!(
+        expression,
+        Expr::BinOp(_) | Expr::BoolOp(_) | Expr::Compare(_)
+    )
+}
