--- a/crates/ruff_python_formatter/src/comments/placement.rs
+++ b/crates/ruff_python_formatter/src/comments/placement.rs
@@ -1258,6 +1258,17 @@ fn handle_keyword_comment<'a>(
 ) -> CommentPlacement<'a> {
     let start = keyword.arg.as_ref().map_or(keyword.start(), Ranged::end);
 
+    // The name of a keyword argument can be parenthesized before Python 3.8, and the formatter
+    // removes these parentheses. A comment inside them precedes the name:
+    // ```python
+    // func((  # comment
+    //     x
+    // )=1)
+    // ```
+    if comment.start() < start {
+        return CommentPlacement::leading(comment.enclosing_node(), comment);
+    }
+
