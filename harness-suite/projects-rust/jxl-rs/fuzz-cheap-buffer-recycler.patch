 use std::collections::HashMap;
+use std::hash::{BuildHasherDefault, Hasher};
+use std::sync::OnceLock;
 
 use crate::error::{Error, Result};
 use crate::frame::VarDctBuffers;
@@ -12,12 +14,40 @@ use crate::image::{Image, ImageDataType, OwnedRawImage};
 use crate::util::PerThreadStorage;
 use crate::util::sync::Mutex;
 
+/// Multiplicative hash for the `(usize, usize)` bucket keys; SipHash dominates the setup cost.
+#[derive(Default)]
+struct SizeHasher(u64);
+
+impl Hasher for SizeHasher {
+    fn write(&mut self, bytes: &[u8]) {
+        for &b in bytes {
+            self.write_u64(b as u64);
+        }
+    }
+
+    fn write_u64(&mut self, n: u64) {
+        self.0 = (self.0.rotate_left(5) ^ n).wrapping_mul(0x517c_c1b7_2722_0a95);
+    }
+
+    fn write_usize(&mut self, n: usize) {
+        self.write_u64(n as u64);
+    }
+
+    fn finish(&self) -> u64 {
+        self.0
+    }
+}
+
+type Buckets = HashMap<(usize, usize), BufferBucket, BuildHasherDefault<SizeHasher>>;
+
 struct BufferBucket {
     images: Mutex<Vec<OwnedRawImage>>,
 }
 
 pub(crate) struct BufferRecycler {
-    buckets: HashMap<(usize, usize), BufferBucket>,
+    // Created on first use: building the buckets is expensive compared to decoding a small or
+    // invalid image, and many decoders never render anything.
+    buckets: OnceLock<Buckets>,
     pub(crate) vardct_buffers: PerThreadStorage<VarDctBuffers>,
     pub(crate) modular_scratch: PerThreadStorage<ScratchSpace>,
 }
