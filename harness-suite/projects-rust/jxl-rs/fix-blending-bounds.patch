Subject: [PATCH] bound reference-frame blending and validate row lengths
---
diff --git a/jxl/src/error.rs b/jxl/src/error.rs
index 5519b6d..a78553c 100644
--- a/jxl/src/error.rs
+++ b/jxl/src/error.rs
@@ -151,6 +151,8 @@ pub enum Error {
     InvalidProperty(u32),
     #[error("Invalid alpha channel for blending: {0}, limit is {1}")]
     InvalidBlendingAlphaChannel(usize, usize),
+    #[error("Blending buffer length mismatch: expected {0}, got {1}")]
+    BlendingBufferLengthMismatch(usize, usize),
     #[error("Invalid alpha channel for blending: {0}, limit is {1}")]
     PatchesInvalidAlphaChannel(usize, usize),
     #[error("Invalid patch blend mode: {0}, limit is {1}")]
diff --git a/jxl/src/features/blending.rs b/jxl/src/features/blending.rs
index 34da7ff..6d77abd 100644
--- a/jxl/src/features/blending.rs
+++ b/jxl/src/features/blending.rs
@@ -5,10 +5,21 @@
 
 #![allow(clippy::needless_range_loop)]
 
-use crate::headers::extra_channels::{ExtraChannel, ExtraChannelInfo};
+use crate::{
+    error::{Error, Result},
+    headers::extra_channels::{ExtraChannel, ExtraChannelInfo},
+};
 
 use super::patches::{PatchBlendMode, PatchBlending};
 
+fn check_blending_len(slice: &[f32], xsize: usize) -> Result<()> {
+    let len = slice.len();
+    if len != xsize {
+        return Err(Error::BlendingBufferLengthMismatch(xsize, len));
+    }
+    Ok(())
+}
+
 #[inline(always)]
 fn maybe_clamp(v: f32, clamp: bool) -> f32 {
     if clamp { v.clamp(0.0, 1.0) } else { v }
@@ -22,16 +33,22 @@ pub fn perform_blending(
     ec_blending: &[PatchBlending],
     extra_channel_info: &[ExtraChannelInfo],
     tmp: &mut Vec<f32>,
-) {
+) -> Result<()> {
     // TODO(veluca): in many cases, the copy to temporary space seems redundant. Investigate more.
     let num_ec = extra_channel_info.len();
     let xsize = bg[0].len();
+    for slice in bg.iter() {
+        check_blending_len(slice, xsize)?;
+    }
+    for slice in fg.iter() {
+        check_blending_len(slice, xsize)?;
+    }
 
     // Fast path: if color is None (keep bg) and all ec are None, nothing to do.
     if color_blending.mode == PatchBlendMode::None
         && ec_blending.iter().all(|b| b.mode == PatchBlendMode::None)
     {
-        return;
+        return Ok(());
     }
 
     // Fast path: Replace color + Replace/None ec -> copy fg directly to bg, no tmp needed.
@@ -52,7 +69,7 @@ pub fn perform_blending(
                     _ => unreachable!(),
                 }
             }
-            return;
+            return Ok(());
         }
     }
 
@@ -287,6 +304,7 @@ pub fn perform_blending(
     for i in 0..(3 + num_ec) {
         bg[i].copy_from_slice(&tmp[i * xsize..][..xsize]);
     }
+    Ok(())
 }
 
 #[cfg(test)]
