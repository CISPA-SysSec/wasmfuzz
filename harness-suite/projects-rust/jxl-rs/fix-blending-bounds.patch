                 &fg,
                 &self.blendings[blending_idx],
                 &self.blendings[blending_idx + 1..],
                 extra_channel_info,
                 blending_scratch,
-            );
+            )
+            .is_err()
+            {
+                continue;
+            }
         }
     }
 }
