From d7300d4da33e9049cbc11d2412445f79bb01449b Mon Sep 17 00:00:00 2001
From: Mrmaxmeier <Mrmaxmeier@gmail.com>
Date: Wed, 1 Jul 2026 10:49:29 +0200
Subject: [PATCH 1/2] Fix infinite loop on zero-length skippable box

A box whose declared length equals its header size yields SkippableBox(0);
the parser returned OutOfBounds(0) forever instead of advancing. Treat it as
already consumed and move to the next box.
---
 .../regressions/zero_length_skippable_box.jxl | Bin 0 -> 168 bytes
 jxl/src/api/inner/box_parser.rs               |  27 ++++++++++++++++++
 2 files changed, 27 insertions(+)
 create mode 100644 jxl/resources/regressions/zero_length_skippable_box.jxl

diff --git a/jxl/resources/regressions/zero_length_skippable_box.jxl b/jxl/resources/regressions/zero_length_skippable_box.jxl
new file mode 100644
index 0000000000000000000000000000000000000000..e1875e77ff246aefe45a8eca094c9cbc8efe634b
GIT binary patch
literal 168
rcmZQzVBqnJ@KNC9YUg5LU=T?wsVvB<$WZ{Y8K5*rR%u@L{{aR7&yI(-

literal 0
HcmV?d00001

diff --git a/jxl/src/api/inner/box_parser.rs b/jxl/src/api/inner/box_parser.rs
index 787b3baa5..623ba083c 100644
--- a/jxl/src/api/inner/box_parser.rs
+++ b/jxl/src/api/inner/box_parser.rs
@@ -144,6 +144,11 @@ impl BoxParser {
                     return Ok(b);
                 }
                 ParseState::SkippableBox(mut s) => {
+                    if s == 0 {
+                        // Already fully consumed; skipping 0 bytes would loop forever.
+                        self.state = ParseState::BoxNeeded;
+                        continue;
+                    }
                     let num = s.min(usize::MAX as u64) as usize;
                     let skipped = if !self.box_buffer.is_empty() {
                         self.box_buffer.consume(num)
@@ -445,3 +450,25 @@ impl BoxParser {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::{BoxParser, ParseState};
+
+    /// Regression: a zero-length skippable box must not leave the parser stuck at
+    /// `SkippableBox(0)` when more container input is available.
+    #[test]
+    fn zero_length_skippable_box_does_not_hang() {
+        let data = std::fs::read("resources/regressions/zero_length_skippable_box.jxl").unwrap();
+        let mut parser = BoxParser::new();
+        let mut input = data.as_slice();
+
+        for _ in 0..100 {
+            let _ = parser.get_more_codestream(&mut input);
+            if !matches!(parser.state, ParseState::SkippableBox(0)) {
+                return;
+            }
+        }
+        panic!("parser stuck at SkippableBox(0)");
+    }
+}

From 72b015f6e6a93cefda6695c6e14e44b79c9eaebd Mon Sep 17 00:00:00 2001
From: Mrmaxmeier <Mrmaxmeier@gmail.com>
Date: Wed, 1 Jul 2026 10:49:49 +0200
Subject: [PATCH 2/2] Fix infinite loop in codestream parser on stalled refill

When header parsing needed more codestream, the parser retried as long as
the raw input still had container bytes, spinning forever on OOO jxlp input
with trailing data. Retry only when refill consumed codestream or the buffer
was enlarged; otherwise return OutOfBounds.
---
 .../ooo_jxlp_with_trailing_bytes.jxl          | Bin 0 -> 153 bytes
 jxl/src/api/inner/codestream_parser/mod.rs    |  18 +++++++++++-------
 jxl/src/api/inner/mod.rs                      |  16 ++++++++++++++++
 3 files changed, 27 insertions(+), 7 deletions(-)
 create mode 100644 jxl/resources/regressions/ooo_jxlp_with_trailing_bytes.jxl

diff --git a/jxl/resources/regressions/ooo_jxlp_with_trailing_bytes.jxl b/jxl/resources/regressions/ooo_jxlp_with_trailing_bytes.jxl
new file mode 100644
index 0000000000000000000000000000000000000000..83b66461e6c908e57240e902f25d9bac0496e431
GIT binary patch
literal 153
zcmZQzVBqnJ@KNC9YUg5LU=T<vsVvB<$WZ{Y8G)D&$S!CAvK^U#ya*5vNHhEgss&2_
z2xnkqVPN<f&d?Hg@Ks%cg=BPNRpWJE$K+?Rj!9a%sJ!64zCty8b^ZH_itaEl-jZS1
V1_8}QIrCq_0MKwwhW`xD7y&#RG}QnA

literal 0
HcmV?d00001

diff --git a/jxl/src/api/inner/codestream_parser/mod.rs b/jxl/src/api/inner/codestream_parser/mod.rs
index d26cdad22..0ff6ee1c1 100644
--- a/jxl/src/api/inner/codestream_parser/mod.rs
+++ b/jxl/src/api/inner/codestream_parser/mod.rs
@@ -625,10 +625,14 @@ impl CodestreamParser {
                         need = need.saturating_sub(c);
                         if need > 0 {
                             self.header_needed_bytes = Some(need);
-                            if !self.non_section_buf.can_read_more() {
+                            let enlarge = !self.non_section_buf.can_read_more();
+                            if enlarge {
                                 self.non_section_buf.enlarge();
                             }
-                            if input.available_bytes().unwrap_or(0) > 0 {
+                            // Only retry when refill made progress or the buffer was
+                            // enlarged to accept more codestream bytes. Do not spin on
+                            // unrelated container bytes when no codestream is available.
+                            if c > 0 || enlarge {
                                 continue;
                             }
                             return Err(Error::OutOfBounds(need as usize));
@@ -646,16 +650,16 @@ impl CodestreamParser {
                             let new_range = self.non_section_buf.range();
                             // If non-section parsing consumed no bytes, and the non-section buffer
                             // cannot accept more bytes, enlarge the buffer to allow to make progress.
-                            if new_range == range && !self.non_section_buf.can_read_more() {
+                            let enlarge =
+                                new_range == range && !self.non_section_buf.can_read_more();
+                            if enlarge {
                                 self.non_section_buf.enlarge();
                             }
                             self.header_needed_bytes = Some(n as u64);
-                            // Check if input still has data - if so, refill and retry
-                            if input.available_bytes().unwrap_or(0) > 0 {
+                            if c > 0 || enlarge {
                                 continue;
-                            } else {
-                                return Err(Error::OutOfBounds(n));
                             }
+                            return Err(Error::OutOfBounds(n));
                         }
                         Err(e) => return Err(e),
                     }
diff --git a/jxl/src/api/inner/mod.rs b/jxl/src/api/inner/mod.rs
index aa9cd8e22..08727fbb5 100644
--- a/jxl/src/api/inner/mod.rs
+++ b/jxl/src/api/inner/mod.rs
@@ -190,4 +190,20 @@ mod tests {
 
         panic!("failed to reach image-info state while parsing cmyk_layers.jxl");
     }
+
+    /// Regression test: an out-of-order `jxlp` stream with trailing container
+    /// bytes used to spin forever when header parsing needed more codestream
+    /// than the boxes provided.
+    #[test]
+    fn ooo_jxlp_with_trailing_bytes_does_not_hang() {
+        let data = std::fs::read("resources/regressions/ooo_jxlp_with_trailing_bytes.jxl").unwrap();
+
+        let mut decoder = JxlDecoderInner::new(JxlDecoderOptions::default());
+        let mut input = data.as_slice();
+        let result = decoder.process(&mut input, None);
+        assert!(matches!(
+            result,
+            Ok(crate::api::ProcessingResult::NeedsMoreInput { .. })
+        ));
+    }
 }
