Subject: [PATCH] bound VarDCT LF plane rect extraction
---
diff --git a/jxl/src/frame/group.rs b/jxl/src/frame/group.rs
index 7b3b256..a8c610d 100644
--- a/jxl/src/frame/group.rs
+++ b/jxl/src/frame/group.rs
@@ -487,6 +487,14 @@ pub fn decode_vardct_group(
                     ),
                     size: (cx, cy),
                 });
+                for i in 0..3 {
+                    let size = lf_image[i].size();
+                    if lf_area[i].origin.0.saturating_add(lf_area[i].size.0) > size.0
+                        || lf_area[i].origin.1.saturating_add(lf_area[i].size.1) > size.1
+                    {
+                        return Err(Error::HFBlockOutOfBounds);
+                    }
+                }
                 [
                     lf_image[0].get_rect(lf_area[0]),
                     lf_image[1].get_rect(lf_area[1]),
