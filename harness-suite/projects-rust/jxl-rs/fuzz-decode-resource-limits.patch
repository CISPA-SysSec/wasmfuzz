Subject: [PATCH] fuzz: keep decode memory bounded

fuzz_decode() keeps every decoded frame so that decode_diff can compare them,
so the memory use of the other targets grows with the number of frames: an
animation of many small frames of a large image exhausts the 32-bit guest.
Add FuzzConfig::keep_frames (default true) and turn it off in decode and
decode_progressive, which drop each frame once it is complete. decode_header
keeps the sample limit and only scans frames.
---
diff --git a/jxl/fuzz/fuzz_targets/decode.rs b/jxl/fuzz/fuzz_targets/decode.rs
index d55d131..f6167e0 100644
--- a/jxl/fuzz/fuzz_targets/decode.rs
+++ b/jxl/fuzz/fuzz_targets/decode.rs
@@ -8,5 +8,11 @@ use jxl_fuzz::{FuzzConfig, fuzz_decode};
 use libfuzzer_sys::fuzz_target;
 
 fuzz_target!(|data: &[u8]| {
-    let _ = fuzz_decode(data, FuzzConfig::default());
+    let _ = fuzz_decode(
+        data,
+        FuzzConfig {
+            keep_frames: false,
+            ..Default::default()
+        },
+    );
 });
diff --git a/jxl/fuzz/fuzz_targets/decode_header.rs b/jxl/fuzz/fuzz_targets/decode_header.rs
index 9887596..5ba79dc 100644
--- a/jxl/fuzz/fuzz_targets/decode_header.rs
+++ b/jxl/fuzz/fuzz_targets/decode_header.rs
@@ -9,7 +9,9 @@ use libfuzzer_sys::fuzz_target;
 
 fuzz_target!(|data: &[u8]| {
     let mut data = data;
-    let decoder_options = JxlDecoderOptions::default();
+    let mut decoder_options = JxlDecoderOptions::default();
+    decoder_options.sample_limit = Some(1 << 22);
+    decoder_options.scan_frames_only = true;
     let mut decoder = JxlDecoder::new(decoder_options);
     let _ = decoder.process(&mut data, None, None);
 });
diff --git a/jxl/fuzz/fuzz_targets/decode_progressive.rs b/jxl/fuzz/fuzz_targets/decode_progressive.rs
index 1e2c362..4955688 100644
--- a/jxl/fuzz/fuzz_targets/decode_progressive.rs
+++ b/jxl/fuzz/fuzz_targets/decode_progressive.rs
@@ -13,6 +13,7 @@ fuzz_target!(|data: &[u8]| {
         FuzzConfig {
             progressive: true,
             flush_intermediate: true,
+            keep_frames: false,
             ..Default::default()
         },
     );
diff --git a/jxl/fuzz/src/lib.rs b/jxl/fuzz/src/lib.rs
index 7208dac..4f6becc 100644
--- a/jxl/fuzz/src/lib.rs
+++ b/jxl/fuzz/src/lib.rs
@@ -78,6 +78,9 @@ pub struct FuzzConfig {
     pub num_threads: usize,
     pub sample_limit: Option<usize>,
     pub flush_intermediate: bool,
+    /// Keep the decoded frames and return them. Without this, each frame's buffers are dropped
+    /// once it is complete, so memory use does not grow with the number of frames.
+    pub keep_frames: bool,
 }
 
 impl Default for FuzzConfig {
@@ -88,6 +91,7 @@ impl Default for FuzzConfig {
             num_threads: 2,
             sample_limit: Some(1 << 22),
             flush_intermediate: false,
+            keep_frames: true,
         }
     }
 }
@@ -193,7 +197,10 @@ pub fn fuzz_decode(data: &[u8], config: FuzzConfig) -> Result<Vec<Vec<Image<f32>
             }
             Event::FrameHeader => {}
             Event::FrameComplete { has_more_frames } => {
-                all_frames.push(outputs.take().unwrap());
+                let frame = outputs.take().unwrap();
+                if config.keep_frames {
+                    all_frames.push(frame);
+                }
                 if has_more_frames {
                     outputs = Some(create_frame_buffers(&decoder)?);
                 }
