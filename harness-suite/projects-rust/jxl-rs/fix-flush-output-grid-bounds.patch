diff --git a/jxl/src/frame/modular/mod.rs b/jxl/src/frame/modular/mod.rs
index d643495..2fcce9c 100644
--- a/jxl/src/frame/modular/mod.rs
+++ b/jxl/src/frame/modular/mod.rs
@@ -989,6 +989,9 @@ impl FullModularImage {
         }
         let grid_is_none = self.buffer_info[buf_idx].grid_kind == ModularGridKind::None;
         let grid_idx = if grid_is_none { 0 } else { group };
