+/// Regression test: a horizontal squeeze step without residual columns whose output tile is 1x1
+/// but whose average input tile is empty (0x0). The one-column shortcut copied the rows of the
+/// average input up to the output height (image/internal.rs: assertion failed: row <
+/// self.num_rows).
+#[test]
+fn test_fuzzer_squeeze_empty_inputs() {
+    let data = include_bytes!("../../tests/testdata/squeeze_empty_inputs.jxl");
+    let _ = decode::<f32>(data, DecodeParams::default());
+}
