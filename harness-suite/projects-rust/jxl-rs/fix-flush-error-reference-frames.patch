         parallel_runner: &mut dyn JxlParallelRunner,
+    ) -> Result<bool> {
+        // The reference/lf frames to be saved are temporarily removed while rendering into them.
+        // If rendering fails, move them back here: callers may ignore a failed flush and keep
+        // decoding, and a later render would then find no buffers to save the frame into.
+        let mut reference_frame_data = std::mem::take(&mut self.reference_frame_data);
