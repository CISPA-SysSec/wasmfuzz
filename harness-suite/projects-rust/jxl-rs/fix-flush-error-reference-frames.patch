+
+/// Regression test: a frame that is saved as a reference moves its reference buffers out while it
+/// renders into them, and an error during a flush returned before moving them back. Callers may
+/// ignore a failed flush and keep decoding, and the next render then panicked looking up the
+/// missing buffers (low_memory_pipeline: index out of bounds in check_buffer_sizes).
+#[test]
+fn test_fuzzer_failed_flush_keeps_reference_frame_buffers() {
+    let data = include_bytes!("../../tests/testdata/failed_flush_reference_frame.jxl");
+    let make_buffers = |decoder: &JxlDecoder| {
+        let (w, h) = decoder.basic_info().unwrap().size;
+        let pixel_format = decoder.current_pixel_format().unwrap();
+        let samples = pixel_format.color_type.samples_per_pixel();
+        let mut buffers = vec![];
+        if pixel_format.color_data_format.is_some() {
+            buffers.push(Image::<f32>::new((w * samples, h)).unwrap());
+        }
+        for _ in pixel_format.extra_channel_format.iter().flatten() {
+            buffers.push(Image::<f32>::new((w, h)).unwrap());
+        }
+        buffers
+    };
+    for chunk_size in 1..=data.len() {
+        let mut decoder = JxlDecoder::new(JxlDecoderOptions::default());
+        let mut input = &data[..];
+        let mut chunk_input = &input[..0];
+        let mut buffers: Option<Vec<Image<f32>>> = None;
+        loop {
+            chunk_input = &input[..(chunk_input.len() + chunk_size).min(input.len())];
+            let available_before = chunk_input.len();
+            let mut out_bufs = buffers.as_deref_mut().map(as_output_buffers);
+            let Ok(event) = decoder.process(&mut chunk_input, out_bufs.as_deref_mut(), None) else {
+                break;
+            };
+            input = &input[(available_before - chunk_input.len())..];
+            match event {
+                Event::BasicInfo
+                | Event::FrameComplete {
+                    has_more_frames: true,
+                } => buffers = Some(make_buffers(&decoder)),
+                Event::FrameComplete { .. } | Event::Complete => break,
+                Event::FrameHeader => {}
+                Event::NeedMoreInput { .. } => {
+                    if input.is_empty() {
+                        break;
+                    }
+                    if let Some(ref mut out_bufs) = out_bufs {
+                        // A failed flush is not fatal for the caller.
+                        let _ = decoder.flush_pixels(out_bufs, None);
+                    }
+                }
+            }
+        }
+    }
+}
