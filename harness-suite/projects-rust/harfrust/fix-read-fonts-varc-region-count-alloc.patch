read-fonts: VARC: size scalar memory by the region offsets present

Applied to the read-fonts 0.47.0 crate that harfrust resolves; the same
change (plus the skrifa half) is projects-rust/fontations/
fix-varc-region-count-alloc.patch against fontations 35c2087.

Found by the suite's harfrust `fuzz_shape` target: `ShaperFont::glyph_extents`
-> `GlyphMetrics::extents_from_source` -> `OutlineGlyph::control_box` draws a
VARC glyph with scratch memory of `Layout::packed_len()` bytes, and
`Outlines::region_count` takes that from the u32 `regionCount` of the
`SparseVariationRegionList`, which nothing checks against the table. A
164-byte font asks for 1 GiB (capacity overflow / allocation failure on
wasm32). `region_count` now counts `region_offsets()`, the offsets actually
present (empty when the declared array does not fit); region lookups past
the data already fail with `Malformed`, so valid fonts are unaffected.
Includes a regression test (runs in the fontations checkout, where
font-test-data is available).

Not fixed upstream as of fontations 35c2087 (read-fonts 0.47.0 is the
latest release).
Upstream: none found.

diff --git a/src/model/glyph/outline/varc.rs b/src/model/glyph/outline/varc.rs
index 47cd7a4..4543253 100644
--- a/src/model/glyph/outline/varc.rs
+++ b/src/model/glyph/outline/varc.rs
@@ -259,10 +259,15 @@ impl<'a> Outlines<'a> {
 
     /// Returns the number of variation regions, or zero if the table has no
     /// variation store.
+    ///
+    /// The `regionCount` field is a `u32` that is not checked against the
+    /// table, so this counts the region offsets that are actually present.
+    /// Sizing the working memory from the raw field lets a few bytes request
+    /// gigabytes; a region past the data fails to resolve when it is used.
     fn region_count(&self) -> usize {
         self.regions
             .as_ref()
-            .map_or(0, |regions| regions.region_count() as usize)
+            .map_or(0, |regions| regions.region_offsets().len())
     }
 
     /// Measures the tree under a composite.
@@ -1189,6 +1194,32 @@ mod tests {
         }
     }
 
+    // `regionCount` is a `u32` that is not checked against the table. The
+    // working memory must be sized by the region offsets that are present,
+    // or a few bytes request gigabytes (an allocation failure on 32-bit).
+    #[test]
+    fn region_count_is_bounded_by_the_table() {
+        let data = font_test_data::varc::CJK_6868;
+        let at = {
+            let font = FontRef::new(data).unwrap();
+            let store = font.varc().unwrap().multi_var_store().unwrap().unwrap();
+            let regions = store.region_list().unwrap();
+            assert_eq!(
+                test_outlines(&font).region_count(),
+                regions.region_count() as usize
+            );
+            regions.offset_data().as_bytes().as_ptr() as usize - data.as_ptr() as usize
+        };
+        let mut bytes = data.to_vec();
+        bytes[at..at + 4].copy_from_slice(&0x1000_0000u32.to_be_bytes());
+
+        let font = FontRef::new(&bytes).unwrap();
+        let outlines = test_outlines(&font);
+        assert!(outlines.region_count() <= bytes.len() / 4);
+        let packed_len = test_layout(&outlines).packed_len().unwrap();
+        assert!(packed_len <= 16 * bytes.len(), "{packed_len}");
+    }
+
     /// A context that draws nothing and needs no memory.
     struct NullContext;
 
