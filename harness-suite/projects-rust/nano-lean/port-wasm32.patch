@@ -51,6 +67,12 @@ pub(crate) fn stack_exhausted(floor: usize) -> bool {
         std::arch::asm!("mov {}, sp", out(reg) sp, options(nomem, nostack, preserves_flags));
         #[cfg(target_arch = "x86_64")]
         std::arch::asm!("mov {}, rsp", out(reg) sp, options(nomem, nostack, preserves_flags));
+        // The shadow stack pointer is a wasm global; a local whose address escapes lives on it.
+        #[cfg(target_family = "wasm")]
