+//! Imports an export and checks its own declarations with the value core, as `nl-fast` does
+//! by default.
+
+use nano_lean::checker::{Adapter, Core, Limits};
+use nano_lean::import;
+use nano_lean::term::arena::Arena;
+use nano_lean::value_checker::Session;
+
+/// `nl-fast` allows 200M steps and 4 GiB per declaration; fuzz inputs are a few KiB.
+const LIMITS: Limits = Limits {
+    steps: 1_000_000,
+    arena_bytes: 64 << 20,
+};
+const SESSION_BYTES: usize = 16 << 20;
+
+pub fn check(data: &[u8]) {
+    let arena = Arena::new();
+    let Ok(store) = import::import_bytes(&arena, data) else {
+        return;
+    };
+    let mut session = Session::new(&store);
+    let mut adapter = Adapter::new(&store);
+    for idx in store.own..store.declars.len() as u32 {
+        let r = Core::Value.check(&store, &mut session, idx, LIMITS, &mut adapter, false);
+        if r.is_err() || session.arena().allocated_bytes() > SESSION_BYTES {
+            session.reset();
+        }
+    }
+}
