+[package]
+name = "moxcms-chromium-fuzz"
+version = "0.0.0"
+publish = false
+edition = "2024"
+
+[package.metadata]
+cargo-fuzz = true
+
+[dependencies]
+libfuzzer-sys = "0.4"
+
+# Same feature set as Chromium's //third_party/rust/moxcms/v0_8:lib (default
+# features; the x86/arm SIMD paths are cfg'd out on wasm32 anyway).
+[dependencies.moxcms]
+path = ".."
+
+# Standalone: do not join the upstream workspace (whose fuzz crate enables
+# the extra `options` and `in_place` features).
+[workspace]
+members = ["."]
+
+[[bin]]
+name = "icc_to_srgb"
+path = "fuzz_targets/icc_to_srgb.rs"
+test = false
+doc = false
+bench = false
