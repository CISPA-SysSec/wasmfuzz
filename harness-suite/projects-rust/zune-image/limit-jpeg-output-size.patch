+/// SOF10 with height 0 (DNL) and a large width. The decoder used to pre-allocate
+/// `max_height * width * components` (hundreds of MB / 1 GiB), which aborts on
+/// wasm32-wasip1. With a 64 MiB inflate limit this must return Err.
+#[test]
+fn dnl_huge_prealloc_does_not_oom() {
+    const DATA: &[u8] = &[
+        0xff, 0xd8, 0xff, 0xca, 0x00, 0x14, 0x08, 0x00, 0x00, 0x1f, 0xe5, 0x04,
+        0x7f, 0x12, 0x00, 0x00, 0x11, 0x00, 0x01, 0x13, 0x00, 0x01, 0x13, 0x00,
+        0xff, 0xdb, 0x00, 0x43, 0x00, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+        0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+        0xff, 0xd8, 0x00, 0xdb, 0x00, 0x43, 0x00, 0x01, 0x01, 0x01, 0x01, 0x01,
+        0x01, 0x01, 0x01, 0x01, 0x01, 0x00, 0x00, 0x00, 0x80, 0x7a, 0x20, 0x3f,
+        0x20, 0xff, 0xe1, 0x00, 0x07, 0x41, 0x56, 0x1b, 0x1b, 0x01, 0x01, 0x01,
+        0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+        0x01, 0x3f, 0x3f, 0x3f, 0x3f, 0x3f, 0x3f, 0x3f, 0x3f, 0x3f, 0x3f, 0x3f,
+        0x3f, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x80, 0x7a, 0x20, 0x3f,
+        0x20, 0xff, 0xe1, 0x00, 0x07, 0x41, 0x56, 0x49, 0x31, 0x00, 0xff, 0xda,
+        0x00, 0x0a, 0x02, 0x01, 0x00, 0x00, 0x20, 0x20, 0x00, 0x80, 0x00, 0xff,
+        0xc4, 0x00, 0x37, 0x0d, 0x00, 0x17, 0xff, 0x99, 0x3a, 0x01, 0xff, 0x01,
+        0x31, 0xa1, 0xff, 0x01, 0x01, 0x01, 0x00, 0x45, 0x00, 0x01, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x10, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    ];
+    let opts = DecoderOptions::default().inflate_set_limit(64 * 1024 * 1024);
+    let mut decoder = JpegDecoder::new_with_options(ZCursor::new(DATA), opts);
+    assert!(decoder.decode().is_err());
+}
