diff --git a/crates/zune-inflate/src/tests.rs b/crates/zune-inflate/src/tests.rs
index b43f9108..ca2aab9f 100644
--- a/crates/zune-inflate/src/tests.rs
+++ b/crates/zune-inflate/src/tests.rs
@@ -835,6 +835,150 @@ mod tests {
