+use zune_core::bytestream::ZCursor;
+use zune_psd::PSDDecoder;
+
+/// 16384x16384 16-bit 2-channel PSD (exactly 1 GiB of output). Default
+/// `inflate_get_limit` is 1 GiB; allocating that on wasm32-wasip1 aborts.
+/// Decoding must return Err rather than trying to allocate.
+#[test]
+fn huge_claimed_raster_does_not_oom() {
+    const DATA: &[u8] = &[
+        0x38, 0x42, 0x50, 0x53, 0x00, 0x01, 0x45, 0x1f, 0xfb, 0x04, 0x37, 0x53,
+        0x00, 0x02, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x10,
+        0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x7f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0xff, 0x00, 0x00, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x22, 0x00, 0x00, 0x01, 0x00, 0x00, 0x7f, 0x7f, 0x7f, 0x7f, 0x38,
+        0x42, 0x50, 0x53, 0x00, 0x01, 0x38, 0xbd, 0x59, 0x80, 0x50, 0x01, 0x00,
+        0x01, 0x00, 0x00, 0x00, 0x7f, 0x88, 0x88, 0x88, 0x88, 0x88, 0x88, 0x00,
+        0x40, 0x00, 0x00, 0x10, 0x88, 0x88, 0x88, 0x88, 0x03, 0xe8, 0xff, 0x38,
+        0x01, 0x07, 0xff, 0x80, 0x00, 0x00, 0xf7, 0xff, 0x00, 0x38, 0x2e, 0x00,
+        0x00, 0x00, 0xf7, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x80, 0xe5, 0x53, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0a,
+        0x0a, 0x01, 0x38, 0x01, 0x07, 0xff, 0x80, 0x00, 0x01, 0x00, 0x00, 0x0a,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00, 0x10, 0xff,
+        0xff, 0xff, 0xff, 0xff, 0x88, 0x88, 0x88, 0x82, 0x88, 0x88, 0x88, 0x88,
+        0x00, 0xff, 0xff, 0xff, 0xff, 0x00, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00,
+        0xff, 0xff, 0x75, 0x01, 0x00, 0x00, 0xfe, 0xff, 0xff, 0x7f, 0x00, 0x02,
+        0x00, 0x00, 0x00, 0x0a, 0x0a, 0x01, 0x38, 0x01, 0x07, 0xff, 0x80, 0x00,
+        0x01, 0x00, 0x00, 0x00,
+    ];
+    let mut decoder = PSDDecoder::new(ZCursor::new(DATA));
+    assert!(decoder.decode().is_err());
+}
