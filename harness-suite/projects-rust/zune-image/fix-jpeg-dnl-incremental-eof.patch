+    /// Whether a recoverable EOF may be the end of the data supplied so far
+    /// rather than the end of the image.
+    pub(crate) fn scan_eof_is_retryable(&self) -> bool {
+        self.incremental_mode && !self.raw_pull_state.input_complete
+    }
