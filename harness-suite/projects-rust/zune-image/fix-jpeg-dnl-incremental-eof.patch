+
+#[cfg(feature = "arith")]
+#[test]
+fn dnl_lookup_at_end_of_visible_data_is_recoverable() {
+    for chunk in [1, 2, 3, 6] {
+        assert_chunked_matches_oneshot(DNL_AFTER_EOI, chunk);
+    }
+}
