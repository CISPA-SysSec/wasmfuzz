diff --git a/crates/zune-png/tests/test_chunk_skip.rs b/crates/zune-png/tests/test_chunk_skip.rs
new file mode 100644
index 00000000..90e59a7f
--- /dev/null
+++ b/crates/zune-png/tests/test_chunk_skip.rs
@@ -0,0 +1,30 @@
+use zune_core::bytestream::ZCursor;
+
+fn chunk(kind: &[u8; 4], data: &[u8], crc: u32) -> Vec<u8> {
+    let mut out = (data.len() as u32).to_be_bytes().to_vec();
+    out.extend_from_slice(kind);
+    out.extend_from_slice(data);
+    out.extend_from_slice(&crc.to_be_bytes());
+    out
+}
+
+/// An unknown ancillary chunk whose length makes `skip(length + 4)` a huge
+/// forward skip used to be truncated to a backward seek on 32-bit targets
+/// (wasm32). It landed on the zTXt chunk before it, so the header loop parsed
+/// the same chunks forever and kept every decoded zTXt until memory ran out.
+#[test]
+fn huge_unknown_chunk_does_not_seek_backwards() {
+    let mut png = b"\x89PNG\r\n\x1a\n".to_vec();
+    png.extend(chunk(b"IHDR", &[0, 0, 0, 1, 0, 0, 0, 1, 8, 0, 0, 0, 0], 0x3a7e_9b55));
+    // keyword "a", compression method 0, zlib stream with one stored block "x"
+    let ztxt = b"a\0\0\x78\x01\x01\x01\x00\xfe\xff\x78\x00\x79\x00\x79";
+    png.extend(chunk(b"zTXt", ztxt, 0x6c6f_d667));
+    // 0xffffffd9 + 4 == -35 as i32: back to the start of the zTXt chunk
+    png.extend_from_slice(&0xffff_ffd9_u32.to_be_bytes());
+    png.extend_from_slice(b"abcd\0\0\0\0");
+    assert_eq!(png.len(), 72);
+
+    let mut decoder = zune_png::PngDecoder::new(ZCursor::new(&png));
+    assert!(decoder.decode_headers().is_err());
+    assert!(decoder.info().unwrap().ztxt_chunk.len() <= 1);
+}
