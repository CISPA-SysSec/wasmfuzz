@@ -0,0 +1,19 @@
+use zune_bmp::BmpDecoder;
+use zune_core::bytestream::ZCursor;
+
+/// 16384x16384 32-bit BMP (exactly 1 GiB of output). Default `inflate_get_limit`
+/// is 1 GiB; allocating that on wasm32-wasip1 aborts. Decoding must return Err.
+#[test]
+fn huge_claimed_rgba_does_not_oom() {
+    const DATA: &[u8] = &[
+        0x42, 0x4d, 0x46, 0x00, 0x00, 0x00, 0xe1, 0x7e, 0xe3, 0x01, 0x45, 0x00,
+        0x00, 0x00, 0x28, 0x00, 0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x40,
+        0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0xe0, 0x27,
+        0xa5, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x7f, 0x00, 0x40,
+        0x02, 0xc0, 0xd8, 0x6c, 0x3d, 0x00, 0x02, 0xc0, 0x00, 0xff, 0xff, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x02,
+        0xc0, 0xd8, 0x6c, 0x3e, 0x00, 0x02, 0xc0, 0xd8, 0x6c, 0x3e,
+    ];
+    let mut decoder = BmpDecoder::new(ZCursor::new(DATA));
+    assert!(decoder.decode().is_err());
+}
