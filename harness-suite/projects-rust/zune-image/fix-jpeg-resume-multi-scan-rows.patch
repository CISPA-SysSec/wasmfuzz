+    /// Multi-SOS baseline: save data-unit row `mcu_row` of the current scan's
+    /// components before this attempt writes it. `checkpoint` starts a new
+    /// backup for a checkpoint saved at this row; later rows decoded without
+    /// a checkpoint of their own (the bit reader already looked past the end
+    /// of the visible data) are added to it. A retry from the checkpoint puts
+    /// them all back, so blocks decoded from the zero padding past the end of
+    /// the data cannot survive a row that now ends early at a marker.
+    pub(crate) fn save_multi_scan_row(
+        &mut self, progressive: &[Vec<i16>; MAX_COMPONENTS], mcu_row: usize, checkpoint: bool
+    ) {
+        let z_order = self.z_order;
+        let Some(state) = self.scan_state.as_deref_mut() else {
+            return;
+        };
+        if checkpoint {
+            state.multi_scan_row_backup.clear();
+            state.multi_scan_backup_rows.clear();
+        } else if state.scan_checkpoint.is_none() {
+            return;
+        }
+        for &k in &z_order[..usize::from(self.num_scans)] {
+            let (Some(component), Some(buffer)) = (self.components.get(k), progressive.get(k))
+            else {
+                continue;
+            };
+            let row_len = component.width_stride * 8;
+            if let Some(row) = mcu_row
+                .checked_mul(row_len)
+                .and_then(|start| buffer.get(start..start.checked_add(row_len)?))
+            {
+                state.multi_scan_row_backup.extend_from_slice(row);
+                state.multi_scan_backup_rows.push((k, mcu_row));
+            }
+        }
+    }
+
+    /// Undo `save_multi_scan_row`: put the saved rows back.
+    pub(crate) fn restore_multi_scan_rows(&mut self, progressive: &mut [Vec<i16>; MAX_COMPONENTS]) {
+        let Some(state) = self.scan_state.as_deref() else {
+            return;
+        };
+        let mut saved = state.multi_scan_row_backup.as_slice();
+        for &(k, mcu_row) in &state.multi_scan_backup_rows {
+            let (Some(component), Some(buffer)) = (self.components.get(k), progressive.get_mut(k))
+            else {
+                return;
+            };
+            let row_len = component.width_stride * 8;
+            let Some(row) = mcu_row
+                .checked_mul(row_len)
+                .and_then(|start| buffer.get_mut(start..start.checked_add(row_len)?))
+            else {
+                return;
+            };
+            if saved.len() < row_len {
+                return;
+            }
+            row.copy_from_slice(&saved[..row_len]);
+            saved = &saved[row_len..];
+        }
+    }
+
     pub(crate) fn baseline_scans_seen(&self) -> usize {
         self.scan_state.as_deref().map_or(0, |state| state.baseline_scans_seen)
     }
