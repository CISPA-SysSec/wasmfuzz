diff --git a/tests/elf.rs b/tests/elf.rs
index d7fb57f..5a2ae3c 100644
--- a/tests/elf.rs
+++ b/tests/elf.rs
@@ -545,3 +545,54 @@ fn test_symver() -> Result<(), goblin::error::Error> {
 
     Ok(())
 }
+
+/// Sets a field of a copy of `base` and checks that parsing it returns an error. On 32-bit
+/// targets the field value overflowed a usize computation in `Elf::parse`, which panicked with
+/// overflow checks enabled.
+fn parse_with_field(base: &[u8], sh_type: u32, field_offset: usize, value: &[u8]) {
+    let obj = Elf::parse(base).unwrap();
+    let section = obj
+        .section_headers
+        .iter()
+        .find(|s| s.sh_type == sh_type && s.sh_size > 0)
+        .unwrap();
+    let offset = section.sh_offset as usize + field_offset;
+    let mut data = base.to_vec();
+    data[offset..offset + value.len()].copy_from_slice(value);
+    assert!(Elf::parse(&data).is_err());
+}
+
+#[test]
+fn test_gnu_hash_huge_bloom_size_64bit() {
+    // bloom_size * 8 overflows a 32-bit usize.
+    parse_with_field(
+        include_bytes!("bins/elf/gnu_hash/hello.so"),
+        SHT_GNU_HASH,
+        8,
+        &0x2000_0000u32.to_le_bytes(),
+    );
+}
+
+#[test]
+fn test_gnu_hash_huge_bloom_size_32bit() {
+    // bloom_size * 4 overflows a 32-bit usize.
+    parse_with_field(
+        include_bytes!("bins/elf/gnu_hash/hello32.so"),
+        SHT_GNU_HASH,
+        8,
+        &0x4000_0000u32.to_le_bytes(),
+    );
+}
+
+#[test]
+fn test_dynamic_reloc_max_r_sym() {
+    use goblin::elf::section_header::SHT_RELA;
+    // r_sym 0xffffffff in the high half of the first Elf64_Rela r_info: r_sym + 1 overflows a
+    // 32-bit usize.
+    parse_with_field(
+        include_bytes!("bins/elf/gnu_hash/hello.so"),
+        SHT_RELA,
+        12,
+        &u32::MAX.to_le_bytes(),
+    );
+}
