+#[test]
+fn test_debug_directory_max_size() {
+    // A debug data directory size of 0xffffffff: offset + size overflows a 32-bit usize.
+    let mut data = include_bytes!("bins/pe/debug_directories-msvc.exe.bin").to_vec();
+    let pe = PE::parse(&data).unwrap();
+    let optional_header = pe.header.dos_header.pe_pointer as usize + 24;
+    let data_directories = optional_header + if pe.is_64 { 112 } else { 96 };
+    let debug_size = data_directories + 6 * 8 + 4;
+    data[debug_size..debug_size + 4].copy_from_slice(&u32::MAX.to_le_bytes());
+    assert!(PE::parse(&data).is_err());
+}
