@@ -1586,6 +1587,14 @@ static NODISCARD overflow_status printer_print_type_backref(struct printer *prin
 }
 
 static NODISCARD overflow_status printer_print_type(struct printer *printer) {
+    // The splat feature is unstable and its mangling is subject to change
+    // FIXME(splat):
+    // - for efficiency we might want to use a letter that can't occur in any type, rather than
+    //   taking an unused letter
+    if (printer_eat(printer, 'w')) {
+        PRINT_STR(printer, "#[rustc_splat] ");
+    }
+
     uint8_t tag;
     PARSE(printer, parser_ch, &tag);
 
@@ -1662,6 +1671,11 @@ static NODISCARD overflow_status printer_print_type(struct printer *printer) {
     case 'B':
         PRINT(printer_print_backref(printer, printer_print_type_backref, NULL));
         break;
+    case 'W':
+        PRINT(printer_print_type(printer));
+        PRINT_STR(printer, " is ");
+        PRINT(printer_print_pat(printer));
+        break;
     default:
         // Go back to the tag, so `print_path` also sees it.
         if (printer->status == DemangleOk && /* safety */ printer->parser.next > 0) {
@@ -1674,6 +1688,39 @@ static NODISCARD overflow_status printer_print_type(struct printer *printer) {
     return OverflowOk;
 }
 
+static NODISCARD overflow_status printer_print_pat(struct printer *printer) {
+    uint8_t tag;
+    PARSE(printer, parser_ch, &tag);
+
+    switch(tag) {
+    case 'R':
+        PRINT(printer_print_const(printer, false));
+        PRINT_STR(printer, "..=");
+        PRINT(printer_print_const(printer, false));
+        break;
+    case 'O':
+        PARSE(printer, parser_push_depth);
+        PRINT(printer_print_pat(printer));
+        while (!printer_eat(printer, 'E')) {
+            // Avoid endless loops if we reached the end while parsing.
+            if (printer->status != DemangleOk) {
+                INVALID(printer);
+            }
+            PRINT_STR(printer, " | ");
+            PRINT(printer_print_pat(printer));
+        }
+        printer_pop_depth(printer);
+        break;
+    case 'N':
+        PRINT_STR(printer, "!null");
+        break;
+    default:
+        INVALID(printer);
+    }
+
+    return OverflowOk;
+}
