+    /// `regionCount` in the sparse region list is a `u32` that read-fonts
+    /// does not check against the table. The scalar cache must be sized by
+    /// the region offsets that are present, not by the raw count, or a few
+    /// bytes request gigabytes (capacity overflow on 32-bit targets).
+    #[test]
+    fn scalar_cache_ignores_oversized_region_count() {
+        use crate::{instance::LocationRef, outline::DrawSettings, MetadataProvider};
+
+        let data = font_test_data::varc::CJK_6868;
+        let at = {
+            let font = FontRef::new(data).unwrap();
+            let store = font.varc().unwrap().multi_var_store().unwrap().unwrap();
+            let regions = store.region_list().unwrap();
+            regions.offset_data().as_bytes().as_ptr() as usize - data.as_ptr() as usize
+        };
+        let mut bytes = data.to_vec();
+        bytes[at..at + 4].copy_from_slice(&0x1000_0000u32.to_be_bytes());
+
+        let font = FontRef::new(&bytes).unwrap();
