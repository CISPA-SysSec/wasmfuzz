+    // `regionCount` is a `u32` that is not checked against the table. The
+    // working memory must be sized by the region offsets that are present,
+    // or a few bytes request gigabytes (an allocation failure on 32-bit).
+    #[test]
+    fn region_count_is_bounded_by_the_table() {
+        let data = font_test_data::varc::CJK_6868;
+        let at = {
+            let font = FontRef::new(data).unwrap();
+            let store = font.varc().unwrap().multi_var_store().unwrap().unwrap();
+            let regions = store.region_list().unwrap();
+            assert_eq!(
+                test_outlines(&font).region_count(),
+                regions.region_count() as usize
+            );
+            regions.offset_data().as_bytes().as_ptr() as usize - data.as_ptr() as usize
+        };
+        let mut bytes = data.to_vec();
+        bytes[at..at + 4].copy_from_slice(&0x1000_0000u32.to_be_bytes());
+
+        let font = FontRef::new(&bytes).unwrap();
+        let outlines = test_outlines(&font);
+        assert!(outlines.region_count() <= bytes.len() / 4);
+        let packed_len = test_layout(&outlines).packed_len().unwrap();
+        assert!(packed_len <= 16 * bytes.len(), "{packed_len}");
+    }
