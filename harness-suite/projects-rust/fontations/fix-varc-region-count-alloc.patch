     /// Returns the number of variation regions, or zero if the table has no
     /// variation store.
+    ///
+    /// The `regionCount` field is a `u32` that is not checked against the
+    /// table, so this counts the region offsets that are actually present.
+    /// Sizing the working memory from the raw field lets a few bytes request
+    /// gigabytes; a region past the data fails to resolve when it is used.
     fn region_count(&self) -> usize {
         self.regions
             .as_ref()
-            .map_or(0, |regions| regions.region_count() as usize)
+            .map_or(0, |regions| regions.region_offsets().len())
     }
 
