diff --git a/fuzz/fuzz_targets/reparse_dictionary.rs b/fuzz/fuzz_targets/reparse_dictionary.rs
new file mode 100644
index 0000000..e723f0b
--- /dev/null
+++ b/fuzz/fuzz_targets/reparse_dictionary.rs
@@ -0,0 +1,22 @@
+#![no_main]
+
+// parse -> serialize -> parse roundtrip starting from arbitrary bytes.
+mod input;
+
+use libfuzzer_sys::fuzz_target;
+use sfv::FieldType as _;
+
+fuzz_target!(|input: input::Input| {
+    let Ok(parsed) = sfv::Parser::new(input.data)
+        .with_version(input.version)
+        .parse::<sfv::Dictionary>()
+    else {
+        return;
+    };
+    let Some(serialized) = parsed.serialize() else { assert!(parsed.is_empty()); return; };
+    let reparsed = sfv::Parser::new(serialized.as_bytes())
+        .with_version(input.version)
+        .parse::<sfv::Dictionary>()
+        .expect("serialized output must parse");
+    assert_eq!(reparsed, parsed);
+});
