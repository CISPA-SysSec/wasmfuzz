 }
+
+// 'sato' derived image item without any 'dimg' input image item (found by fuzzing).
+#[test]
+fn sato_without_input_items() {
+    let mut decoder = get_decoder("sato_no_input_items.avif");
+    decoder.settings.allow_sample_transform = true;
+    assert!(matches!(
+        decoder.parse(),
+        Err(AvifError::BmffParseFailed(_))
+    ));
+}
