diff --git a/tests/decoder.rs b/tests/decoder.rs
index 2b78ec7..355c5cb 100644
--- a/tests/decoder.rs
+++ b/tests/decoder.rs
@@ -1809,3 +1809,10 @@ fn strictness(filename: &str, strictness_flag: decoder::StrictnessFlag) {
     }
     assert!(decoder.next_image().is_ok());
 }
+
+// 'mini' box with has_alpha set and an alpha_item_data_size of 0 (found by fuzzing).
+#[test]
+fn mini_alpha_without_alpha_item_data() {
+    let mut decoder = get_decoder("mini_alpha_without_data.avif");
+    let _ = decoder.parse();
+}
