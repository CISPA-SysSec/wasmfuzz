diff --git a/fuzz/fuzz_targets/inflate_stream.rs b/fuzz/fuzz_targets/inflate_stream.rs
new file mode 100644
index 0000000..f7004a6
--- /dev/null
+++ b/fuzz/fuzz_targets/inflate_stream.rs
@@ -0,0 +1,73 @@
+#![no_main]
+#[macro_use]
+extern crate libfuzzer_sys;
+extern crate miniz_oxide;
+
+use miniz_oxide::inflate::stream::{inflate, InflateState};
+use miniz_oxide::{DataFormat, MZError, MZFlush, MZStatus};
+
+const LIMIT: usize = 4 << 20;
+
+// Streaming (wrapping-buffer) inflate with fuzzer-chosen input/output chunk
+// sizes, cross-checked against the one-shot decoder.
+fuzz_target!(|data: &[u8]| {
+    if data.len() < 3 {
+        return;
+    }
+    let format = match data[0] & 3 {
+        0 | 3 => DataFormat::Raw,
+        1 => DataFormat::Zlib,
+        _ => DataFormat::ZLibIgnoreChecksum,
+    };
+    let in_chunk = (data[1] as usize % 64) + 1;
+    let out_chunk = (data[2] as usize % 128) + 1;
+    let input = &data[3..];
+
+    let mut state = InflateState::new_boxed(format);
+    let mut out = Vec::new();
+    let mut buf = vec![0u8; out_chunk];
+    let mut pos = 0;
+    let mut ok = false;
+    loop {
+        let end = core::cmp::min(pos + in_chunk, input.len());
+        let flush = if end == input.len() {
+            MZFlush::Finish
+        } else {
+            MZFlush::None
+        };
+        let res = inflate(&mut state, &input[pos..end], &mut buf, flush);
+        pos += res.bytes_consumed;
+        out.extend_from_slice(&buf[..res.bytes_written]);
+        if out.len() > LIMIT {
+            return;
+        }
+        match res.status {
+            Ok(MZStatus::StreamEnd) => {
+                ok = true;
+                break;
+            }
+            Ok(_) => {}
+            Err(MZError::Buf) => {
+                if res.bytes_consumed == 0 && res.bytes_written == 0 && pos >= input.len() {
+                    break;
+                }
+            }
+            Err(_) => break,
+        }
+    }
+
+    if ok {
+        let oneshot = match format {
+            DataFormat::Raw => {
+                miniz_oxide::inflate::decompress_to_vec_with_limit(input, LIMIT)
+            }
+            DataFormat::Zlib => {
+                miniz_oxide::inflate::decompress_to_vec_zlib_with_limit(input, LIMIT)
+            }
+            _ => return,
+        };
+        if let Ok(v) = oneshot {
+            assert_eq!(v, out, "streaming and one-shot inflate disagree");
+        }
+    }
+});
