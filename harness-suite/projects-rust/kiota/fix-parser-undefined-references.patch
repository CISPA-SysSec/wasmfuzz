+
+/// Records that name an undefined parent name or level, or carry a non-index
+/// value, reject instead of panicking (index out of bounds / unwrap on None).
+#[test]
+fn records_with_undefined_or_malformed_references_reject() {
+    for export in [
+        "{\"in\":10,\"str\":{\"pre\":9,\"str\":\"_@\"}}\n",
+        "{\"in\":1,\"num\":{\"pre\":7,\"i\":0}}\n",
+        "{\"il\":1,\"succ\":5}\n",
+        "{\"il\":1,\"max\":[0,5]}\n",
+        "{\"il\":1,\"succ\":\"x\"}\n",
+        "{\"il\":1,\"param\":-1}\n",
+        "{\"ie\":0,\"sort\":5}\n",
+        "{\"ie\":0,\"bvar\":\"x\"}\n",
+        "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"c\"}}\n{\"ie\":0,\"const\":{\"name\":1,\"us\":[3]}}\n",
+    ] {
+        match Parser::new().run(Cursor::new(export)) {
+            Err(TcError::Reject(_)) => {}
+            other => panic!("{export:?}: expected a rejection, got {other:?}"),
+        }
+    }
+}
