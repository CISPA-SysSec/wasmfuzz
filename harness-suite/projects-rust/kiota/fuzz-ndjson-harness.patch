+//! A lean4export NDJSON stream checked as the arena runs `kiota --use-stdin`: the parser
+//! reads the export line by line and checks each declaration as it is encountered
+//! (kiota's CLI does this on a 1 GiB-stack thread; here on the calling thread).
+//! Rejections, declines and input errors are verdicts; panics are findings.
+
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+
+fuzz_target!(|data: &[u8]| {
+    let mut parser = kiota::parser::Parser::new();
+    let _ = parser.run(data);
+});
