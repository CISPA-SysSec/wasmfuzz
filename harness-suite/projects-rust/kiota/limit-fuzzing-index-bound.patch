+
+/// Exclusive bound on `in`/`il`/`ie` indices in fuzzing builds (see `table_index`).
+#[cfg(fuzzing)]
+const MAX_FUZZ_INDEX: u64 = 1 << 18;
+
+/// The name, level and expression tables grow up to each record's index, so one
+/// record with `"ie":34888884009` makes a 16 KB export take 24 GB and 53 s.
+/// Fuzzing builds decline indices from `MAX_FUZZ_INDEX` on.
+#[inline(always)]
+fn table_index(idx: u64) -> Result<u32, TcError> {
+    #[cfg(fuzzing)]
+    if idx >= MAX_FUZZ_INDEX {
+        return Err(TcError::Decline(format!(
+            "export index {idx} is past the fuzzing bound {MAX_FUZZ_INDEX}"
+        )));
+    }
+    Ok(idx as u32)
+}
