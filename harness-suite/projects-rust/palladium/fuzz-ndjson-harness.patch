+//! A lean4export NDJSON stream checked as `palladium FILE` does, on one worker: the
+//! sequential loader (`parse::load`, the reference the parallel loader must agree with),
+//! then every declaration in file order on one `Checker`. A rejection ends the check, as
+//! the CLI exits on the first one; a fault (resource limit) replaces the checker and the
+//! rest are still checked, as a worker does; the store is reset past `RESET_TERMS`.
+
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use palladium::parse;
+use palladium::tc::{Checker, Fail};
+
+/// main.rs: a worker recreates its store between declarations past this many terms.
+const RESET_TERMS: usize = 250_000;
+
+fuzz_target!(|data: &[u8]| {
+    let Ok(env) = parse::load(data) else {
+        return;
+    };
+    let mut checker = Checker::new(&env);
+    for p in 0..env.raw.decls.len() {
+        if checker.store.num_terms() > RESET_TERMS {
+            checker.reset();
+        }
+        match checker.check_decl(p as u32) {
+            Ok(()) => {}
+            Err(Fail::Reject(_)) => return,
+            Err(Fail::Fault(_)) => checker = Checker::new(&env),
+        }
+    }
+});
