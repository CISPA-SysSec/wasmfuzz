+/// wasm32-wasip1 has no threads, so checking runs on the module's linear-memory stack
+/// (16 MiB in the fuzzing build) instead of a multi-GiB worker stack, and `MAX_DEPTH`
+/// alone would overflow it. True when less than `WASM_STACK_MARGIN` of it is left; the
+/// recursion guards then fault as they do at `MAX_DEPTH`.
+#[cfg(target_family = "wasm")]
+#[inline]
+pub fn stack_exhausted() -> bool {
+    const WASM_STACK_MARGIN: usize = 2 << 20;
+    unsafe extern "C" {
+        static __stack_low: u8;
+    }
+    let probe = 0u8;
+    let sp = std::hint::black_box(&raw const probe) as usize;
+    let low = &raw const __stack_low as usize;
+    sp < low + WASM_STACK_MARGIN
+}
+
+/// Native workers run on stacks sized for `MAX_DEPTH` (see main.rs).
+#[cfg(not(target_family = "wasm"))]
+#[inline]
+pub fn stack_exhausted() -> bool {
+    false
+}
