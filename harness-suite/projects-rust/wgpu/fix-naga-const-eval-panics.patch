+
+#[test]
+fn matrix_constructor_component_count() {
+    let mut frontend = Frontend::default();
+    // Fuzz finding: `mat3()` built a matrix with no columns, and constant
+    // folding `mat3() * vec3(5)` unwrapped an empty dot product.
+    for src in [
+        "const vec3 v = mat3() * vec3(5); void main(){}",
+        "const mat2 m = mat2(1.0, 2.0, 3.0) * mat2(1.0); void main(){}",
+    ] {
+        let result = frontend.parse(&Options::from(ShaderStage::Vertex), src);
+        let errors = result.expect_err(src).errors;
+        assert!(
+            matches!(&errors[0].kind, ErrorKind::SemanticError(msg) if msg.starts_with("Matrix constructor expects")),
+            "{src}: {errors:?}"
+        );
+    }
+}
+
+#[test]
+fn constant_index_in_const_context() {
+    let mut frontend = Frontend::default();
+    // Fuzz finding: lowering an index in a const context looked the
+    // (global) index expression up in the function's expression arena.
+    for src in [
+        "const int b = int[3](1, 2, 3)[1]; void main(){}",
+        "int x[int[](1, 2)[1]]; void main(){}",
+    ] {
+        frontend
+            .parse(&Options::from(ShaderStage::Vertex), src)
+            .unwrap_or_else(|e| panic!("{src}: {e:?}"));
+    }
+}
