+
+#[test]
+fn f16_infinity_to_int_conversion_does_not_panic() {
+    // Fuzz finding: a u32 too large for f16 converts to an infinite f16, and
+    // converting that to an integer unwrapped `f16::to_i32` (None on NaN/Inf).
+    for ty in ["i32", "u32", "i64", "u64", "u16"] {
+        let src = format!("enable f16; var<private> x = {ty}(f16(4294967293u));");
+        let _ = naga::front::wgsl::parse_str(&src);
+    }
+}
+
+#[test]
+fn clamp_nan_bounds_is_error_not_panic() {
+    // Fuzz finding: `low > high` is false for a NaN bound, and `f64::clamp` /
+    // `f16::clamp` then panicked on the NaN (`inverseSqrt(-5)` is NaN).
+    for src in [
+        "var<private> y = clamp(5, 5, inverseSqrt(-5));",
+        "var<private> y = clamp(5, inverseSqrt(-5), 5);",
+        "const y = clamp(vec2(1.0), vec2(inverseSqrt(-5.0)), vec2(2.0));",
+        "enable f16; var<private> o = clamp(6, tan(f16(~8u)), 3);",
+    ] {
+        let err = naga::front::wgsl::parse_str(src).expect_err(src);
+        assert!(err.message().contains("clamp"), "{src}: {}", err.message());
+    }
+    naga::front::wgsl::parse_str("const_assert clamp(5.0, 1.0, 2.0) == 2.0;").unwrap();
+}
+
+#[test]
+fn select_with_nested_vector_constructors() {
+    // Fuzz finding: const-evaluating `select` assumed every component of a
+    // vector `Compose` was a scalar literal, but `vec3(7, vec2())` has a
+    // vector component.
+    naga::front::wgsl::parse_str(
+        "
+        const b = select(vec3(7, vec2(1, 2)), vec3(4, 5, 6), vec3(true, false, true));
+        const_assert b.x == 4 && b.y == 1 && b.z == 6;
+        const c = select(vec4(vec2(1), 3, 4), vec4(5), vec4(vec2(true), vec2(false)));
+        const_assert c.x == 5 && c.y == 5 && c.z == 3 && c.w == 4;
+        var<private> d = select(vec3(7, vec2()), vec3(), 7 < 7);
+        ",
+    )
+    .unwrap();
+}
+
+#[test]
+fn const_index_by_let_bound_const_is_error_not_panic() {
+    // Fuzz finding: after `let y = a`, the const `a` is no longer tracked as
+    // const, and indexing with it in a const declaration hit an assertion.
+    let src = "fn g() { const a = 6i; let y = a; const k = a[a]; }";
+    assert!(naga::front::wgsl::parse_str(src).is_err());
+}
+
+#[test]
+fn huge_array_zero_value_is_error_not_oom() {
+    // Fuzz finding: constant-evaluating `array<i32, ~4u>()` in an expression
+    // expanded its zero value into ~2^32 component handles.
+    for src in [
+        "var<private> b = array<i32, ~4u>() < 1;",
+        "var<private> b = 6 * array<i32, ~1u>();",
+    ] {
+        assert!(naga::front::wgsl::parse_str(src).is_err(), "{src}");
+    }
+}
