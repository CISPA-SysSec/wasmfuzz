+#[test]
+fn deeply_nested_if_expression() {
+    let nested = |n: usize| format!("#if {}1{}\nA\n#endif", "(".repeat(n), ")".repeat(n));
+    check_preprocessed_result(&nested(32), "A");
+    check_preprocessing_error(&nested(10_000), PreprocessorError::RecursionLimitReached);
+    check_preprocessing_error(
+        &format!("#if {}1\nA\n#endif", "!".repeat(10_000)),
+        PreprocessorError::RecursionLimitReached,
+    );
+}
