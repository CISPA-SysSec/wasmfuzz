+
+/// A function whose id lies just below the fake ids that the entry point
+/// wrappers use (`!0, !1, ..`). The patching pass skipped every id above
+/// `!(number of functions)`, so this function was never moved into the new
+/// arena and its stale handle aliased another function's, which then picked up
+/// the wrong parameter sampling flags (an index out of bounds in
+/// `patch_statements`).
+#[test]
+fn function_id_just_below_fake_entry_point_ids() {
+    let (void, fn_void, caller, caller_label, call) = (1, 2, 3, 4, 5);
+    let (callee, callee_label) = (0xFFFF_FFFE, 6);
+    let mut w = HEADER.to_vec();
+    inst(&mut w, OP_CAPABILITY, &[1]); // Shader
+    inst(&mut w, OP_MEMORY_MODEL, &[0, 1]); // Logical GLSL450
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_FUNCTION, &[void, callee, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[callee_label]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+    inst(&mut w, OP_FUNCTION, &[void, caller, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[caller_label]);
+    inst(&mut w, OP_FUNCTION_CALL, &[void, call, callee]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    let module = parse(&w).unwrap();
+    assert_eq!(module.functions.len(), 2);
+    for (_, fun) in module.functions.iter() {
+        for statement in fun.body.iter() {
+            if let naga::Statement::Call { function, .. } = *statement {
+                assert!(module.functions.try_get(function).is_ok());
+            }
+        }
+    }
+}
+
+/// A function whose id is the fake id of an entry point wrapper (`!0` for the
+/// first entry point) is refused rather than confused with the wrapper.
+#[test]
+fn function_id_colliding_with_fake_entry_point_id() {
+    let (void, fn_void, main, main_label, call) = (1, 2, 3, 4, 5);
+    let (callee, callee_label) = (0xFFFF_FFFF, 6);
+    let mut w = module_start(5, main, &[]); // GLCompute
+    inst(&mut w, OP_EXECUTION_MODE, &[main, 17, 1, 1, 1]); // LocalSize 1 1 1
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_FUNCTION, &[void, callee, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[callee_label]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+    inst(&mut w, OP_FUNCTION, &[void, main, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[main_label]);
+    inst(&mut w, OP_FUNCTION_CALL, &[void, call, callee]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    let result = parse(&w);
+    assert!(
+        matches!(result, Err(spv::Error::InvalidId(0xFFFF_FFFF))),
+        "{result:?}"
+    );
+}
