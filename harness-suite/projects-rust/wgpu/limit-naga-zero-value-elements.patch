+
+#[test]
+fn large_array_zero_value_is_limited() {
+    // wasm32 guest limit: a zero value of an array just under the type size
+    // limit would otherwise expand to ~1 GiB of expression handles.
+    let result = naga::front::wgsl::parse_str("var<private> b = array<i32, 0xFffff6b>() * 0;");
+    assert!(result.is_err());
+    naga::front::wgsl::parse_str("var<private> b = array<i32, 1024>();").unwrap();
+}
