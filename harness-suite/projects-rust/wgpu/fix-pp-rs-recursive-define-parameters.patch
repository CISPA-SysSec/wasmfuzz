diff --git a/src/pp_tests.rs b/src/pp_tests.rs
index d7f65ff..9804665 100644
--- a/src/pp_tests.rs
+++ b/src/pp_tests.rs
@@ -1411,3 +1411,17 @@ fn add_define() {
