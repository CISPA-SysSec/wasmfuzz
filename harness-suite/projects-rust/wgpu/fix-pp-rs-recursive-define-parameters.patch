 }
+
+#[test]
+fn recursive_define_in_parameter() {
+    // Each expansion of `v` starts an invocation of `O` whose argument contains `v` again,
+    // which used to recurse until the stack overflowed.
+    check_preprocessing_error(
+        "#define v O((v)\n#define O(o)\nv)",
+        PreprocessorError::RecursionLimitReached,
+    );
+    check_preprocessed_result(
+        "#define F(x) x\nF(F(F(F(F(F(F(F(1))))))))",
+        "1",
+    );
+}
