+#[test]
+fn huge_entry_point_array() {
+    let mut frontend = Frontend::default();
+    // Fuzz finding: every element of an entry point input or output array
+    // becomes its own argument, so huge arrays never finished (and their
+    // locations overflowed), and the output struct size used `TypeInner::size`,
+    // which panics on a type that is too large.
+    for src in [
+        "out float a[200000000]; void main(){}",
+        "in float a[200000000]; void main(){}",
+        "int main(){} out v { int i[217483247][]; };",
+        "layout(location = 4294967295u) out float a[2]; void main(){}",
+    ] {
+        let result = frontend.parse(&Options::from(ShaderStage::Vertex), src);
+        let errors = result.expect_err(src).errors;
+        assert!(
+            matches!(&errors[0].kind, ErrorKind::SemanticError(msg) if msg.starts_with("Entry point") || msg.starts_with("Too many entry point")),
+            "{src}: {errors:?}"
+        );
+    }
+    frontend
+        .parse(
+            &Options::from(ShaderStage::Fragment),
+            "layout(location = 0) out vec4 o[4]; void main(){}",
+        )
+        .unwrap();
+}
