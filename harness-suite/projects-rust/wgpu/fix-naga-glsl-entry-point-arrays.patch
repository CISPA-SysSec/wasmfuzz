+/// Every array element of an entry point input or output becomes its own
+/// argument or struct member, so `out float a[200000000];` would otherwise take
+/// forever (and its locations would overflow).
+const MAX_ENTRY_POINT_LOCATIONS: usize = 1 << 16;
+
+fn entry_point_args_error(msg: &'static str) -> Error {
+    Error {
+        kind: ErrorKind::SemanticError(msg.into()),
+        meta: Span::default(),
+    }
+}
