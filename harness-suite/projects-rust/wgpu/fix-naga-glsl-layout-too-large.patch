+#[test]
+fn huge_array_type_is_error_not_panic() {
+    let mut frontend = Frontend::default();
+    // Fuzz finding: an oversize constant array (optionally nested) used to
+    // unwrap a `LayoutError { inner: TooLarge }` in `parse_array_specifier`.
+    let result = frontend.parse(&Options::from(ShaderStage::Fragment), "int[2322222222][]");
+    assert!(
+        result.is_err(),
+        "expected a parse error for an oversize array type, got {result:?}"
+    );
+}
