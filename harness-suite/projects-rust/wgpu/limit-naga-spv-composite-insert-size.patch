 }
+
+/// `OpCompositeInsert` into an array whose declared length is huge. The
+/// lowering spells out one expression per element, so this used to allocate
+/// memory proportional to the declared length.
+#[test]
+fn composite_insert_into_huge_array() {
+    let (void, float, uint, len, array, null, f0, fn_void) = (1, 2, 3, 4, 5, 6, 7, 8);
+    let (main, label, result) = (9, 10, 11);
+    let mut w = module_start(5, main, &[]); // GLCompute
+    inst(&mut w, OP_EXECUTION_MODE, &[main, 17, 1, 1, 1]); // LocalSize 1 1 1
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_FLOAT, &[float, 32]);
+    inst(&mut w, OP_TYPE_INT, &[uint, 32, 0]);
+    inst(&mut w, OP_CONSTANT, &[uint, len, 1 << 20]);
+    inst(&mut w, OP_TYPE_ARRAY, &[array, float, len]);
+    inst(&mut w, OP_CONSTANT_NULL, &[array, null]);
+    inst(&mut w, OP_CONSTANT, &[float, f0, 0]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_FUNCTION, &[void, main, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[label]);
+    inst(&mut w, OP_COMPOSITE_INSERT, &[array, result, f0, null, 0]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    let result = parse(&w);
+    assert!(
+        matches!(result, Err(spv::Error::CompositeTooLarge(5))),
+        "{result:?}"
+    );
+}
