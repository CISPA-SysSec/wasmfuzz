naga: spv-in: bound the composite size that OpCompositeInsert is lowered for

`insert_composite` rebuilds the whole composite as a `Compose` of one
`AccessIndex` expression per component. For an array the component count is
the declared array length, so a module of a few hundred bytes declaring an
array of 2^30 elements made a single `OpCompositeInsert` allocate tens of
gigabytes. Reject composites with more than 2^16 components with the new
`Error::CompositeTooLarge`. The constant is arbitrary; a lowering through a
local variable would avoid the expansion altogether.
---
diff --git a/naga/src/front/spv/error.rs b/naga/src/front/spv/error.rs
index 48f864492..56b93dc1b 100644
--- a/naga/src/front/spv/error.rs
+++ b/naga/src/front/spv/error.rs
@@ -161,6 +161,9 @@ pub enum Error {
 
     #[error("type layout error: {0}")]
     Layout(LayoutError),
+
+    #[error("composite type %{0} is too large for OpCompositeInsert")]
+    CompositeTooLarge(spirv::Word),
 }
 
 impl Error {
diff --git a/naga/src/front/spv/mod.rs b/naga/src/front/spv/mod.rs
index 7d1aefe3c..d8fca2133 100644
--- a/naga/src/front/spv/mod.rs
+++ b/naga/src/front/spv/mod.rs
@@ -100,6 +100,13 @@ pub const SUPPORTED_EXTENSIONS: &[&str] = &[
     "SPV_KHR_fragment_shader_barycentric",
 ];
 
+/// The largest composite that `OpCompositeInsert` is lowered for.
+///
+/// The lowering rebuilds the whole composite from one expression per
+/// component, so an array type with a huge declared length would make a
+/// handful of instructions allocate gigabytes.
+const MAX_COMPOSITE_INSERT_COMPONENTS: usize = 1 << 16;
+
 #[derive(Copy, Clone, Debug)]
 pub struct Instruction {
     op: spirv::Op,
@@ -1393,6 +1400,12 @@ impl<I: Iterator<Item = u32>> Frontend<I> {
         if selection as usize >= count {
             return Err(Error::InvalidAccessIndex(selection));
         }
+        // Every component of the composite is spelled out as its own
+        // expression below, so the cost is linear in the array length that
+        // the module declares, not in the size of the module.
+        if count > MAX_COMPOSITE_INSERT_COMPONENTS {
+            return Err(Error::CompositeTooLarge(root_type_id));
+        }
 
         let mut components = Vec::with_capacity(count);
         for index in 0..count as u32 {
