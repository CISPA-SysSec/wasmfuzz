+/// Depth-comparison sampling from an element of an array of sampled images.
+/// The frontend tracks binding arrays for comparison sampling, so it must
+/// also be able to flip their element type to a depth image.
+#[test]
+fn comparison_sampling_from_binding_array() {
+    let (void, float, v2float, uint, image, c4, array, ptr_array) = (1, 2, 3, 4, 5, 6, 7, 8);
+    let (textures, sampler_ty, ptr_sampler, sampler, sampled_image_ty) = (9, 10, 11, 12, 13);
+    let (ptr_image, c0, f0, uv, fn_void, main, label) = (14, 15, 16, 17, 18, 19, 20);
+    let (element, loaded, loaded_sampler, combined, result) = (21, 22, 23, 24, 25);
+    let mut w = module_start(4, main, &[]); // Fragment
+    inst(&mut w, OP_EXECUTION_MODE, &[main, 7]); // OriginUpperLeft
+    inst(
+        &mut w,
+        OP_DECORATE,
+        &[textures, DECORATION_DESCRIPTOR_SET, 0],
+    );
+    inst(&mut w, OP_DECORATE, &[textures, DECORATION_BINDING, 0]);
+    inst(
+        &mut w,
+        OP_DECORATE,
+        &[sampler, DECORATION_DESCRIPTOR_SET, 0],
+    );
+    inst(&mut w, OP_DECORATE, &[sampler, DECORATION_BINDING, 1]);
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_FLOAT, &[float, 32]);
+    inst(&mut w, OP_TYPE_VECTOR, &[v2float, float, 2]);
+    inst(&mut w, OP_TYPE_INT, &[uint, 32, 0]);
+    // 2D, not depth, not arrayed, single-sampled, sampled, unknown format
+    inst(&mut w, OP_TYPE_IMAGE, &[image, float, 1, 0, 0, 0, 1, 0]);
+    inst(&mut w, OP_CONSTANT, &[uint, c4, 4]);
+    inst(&mut w, OP_TYPE_ARRAY, &[array, image, c4]);
+    inst(
+        &mut w,
+        OP_TYPE_POINTER,
+        &[ptr_array, STORAGE_CLASS_UNIFORM_CONSTANT, array],
+    );
+    inst(
+        &mut w,
+        OP_VARIABLE,
+        &[ptr_array, textures, STORAGE_CLASS_UNIFORM_CONSTANT],
+    );
+    inst(&mut w, OP_TYPE_SAMPLER, &[sampler_ty]);
+    inst(
+        &mut w,
+        OP_TYPE_POINTER,
+        &[ptr_sampler, STORAGE_CLASS_UNIFORM_CONSTANT, sampler_ty],
+    );
+    inst(
+        &mut w,
+        OP_VARIABLE,
+        &[ptr_sampler, sampler, STORAGE_CLASS_UNIFORM_CONSTANT],
+    );
+    inst(&mut w, OP_TYPE_SAMPLED_IMAGE, &[sampled_image_ty, image]);
+    inst(
+        &mut w,
+        OP_TYPE_POINTER,
+        &[ptr_image, STORAGE_CLASS_UNIFORM_CONSTANT, image],
+    );
+    inst(&mut w, OP_CONSTANT, &[uint, c0, 0]);
+    inst(&mut w, OP_CONSTANT, &[float, f0, 0]);
+    inst(&mut w, OP_CONSTANT_COMPOSITE, &[v2float, uv, f0, f0]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_FUNCTION, &[void, main, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[label]);
+    inst(&mut w, OP_ACCESS_CHAIN, &[ptr_image, element, textures, c0]);
+    inst(&mut w, OP_LOAD, &[image, loaded, element]);
+    inst(&mut w, OP_LOAD, &[sampler_ty, loaded_sampler, sampler]);
+    inst(
+        &mut w,
+        OP_SAMPLED_IMAGE,
+        &[sampled_image_ty, combined, loaded, loaded_sampler],
+    );
+    inst(
+        &mut w,
+        OP_IMAGE_SAMPLE_DREF_IMPLICIT_LOD,
+        &[float, result, combined, uv, f0],
+    );
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    let module = parse(&w).unwrap();
+    let (_, textures) = module
+        .global_variables
+        .iter()
+        .find(|(_, var)| var.binding.as_ref().is_some_and(|b| b.binding == 0))
+        .unwrap();
+    let naga::TypeInner::BindingArray { base, .. } = module.types[textures.ty].inner else {
+        panic!("expected a binding array");
+    };
+    assert!(matches!(
+        module.types[base].inner,
+        naga::TypeInner::Image {
+            class: naga::ImageClass::Depth { multi: false },
+            ..
+        }
+    ));
+}
