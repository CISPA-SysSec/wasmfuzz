+/// `OpImageFetch` from an arrayed image with integer coordinates, in a module
+/// that never declares the 2-component integer vector the frontend needs for
+/// the coordinates without the array layer.
+#[test]
+fn image_fetch_arrayed_with_integer_coordinates() {
+    let (void, float, int, v3int, v4float, image, ptr_image, var_image) = (1, 2, 3, 4, 5, 6, 7, 8);
+    let (c0, coords, fn_void, main, label, loaded, texel) = (9, 10, 11, 12, 13, 14, 15);
+    let mut w = module_start(5, main, &[]); // GLCompute
+    inst(&mut w, OP_EXECUTION_MODE, &[main, 17, 1, 1, 1]); // LocalSize 1 1 1
+    inst(
+        &mut w,
+        OP_DECORATE,
+        &[var_image, DECORATION_DESCRIPTOR_SET, 0],
+    );
+    inst(&mut w, OP_DECORATE, &[var_image, DECORATION_BINDING, 0]);
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_FLOAT, &[float, 32]);
+    inst(&mut w, OP_TYPE_INT, &[int, 32, 1]);
+    inst(&mut w, OP_TYPE_VECTOR, &[v3int, int, 3]);
+    inst(&mut w, OP_TYPE_VECTOR, &[v4float, float, 4]);
+    // 2D, not depth, arrayed, single-sampled, sampled, unknown format
+    inst(&mut w, OP_TYPE_IMAGE, &[image, float, 1, 0, 1, 0, 1, 0]);
+    inst(
+        &mut w,
+        OP_TYPE_POINTER,
+        &[ptr_image, STORAGE_CLASS_UNIFORM_CONSTANT, image],
+    );
+    inst(
+        &mut w,
+        OP_VARIABLE,
+        &[ptr_image, var_image, STORAGE_CLASS_UNIFORM_CONSTANT],
+    );
+    inst(&mut w, OP_CONSTANT, &[int, c0, 0]);
+    inst(&mut w, OP_CONSTANT_COMPOSITE, &[v3int, coords, c0, c0, c0]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_FUNCTION, &[void, main, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[label]);
+    inst(&mut w, OP_LOAD, &[image, loaded, var_image]);
+    inst(
+        &mut w,
+        OP_IMAGE_FETCH,
+        &[v4float, texel, loaded, coords, 2, c0],
+    ); // Lod
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    let module = parse(&w).unwrap();
+    naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::all(),
+    )
+    .validate(&module)
+    .unwrap();
+}
