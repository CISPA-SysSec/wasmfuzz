+/// A vertex output struct whose unused built-in members get culled, in a
+/// module that also declares the same struct without the built-ins.
+#[test]
+fn culled_per_vertex_struct_matches_existing_struct() {
+    let (void, float, v4float, per_vertex, plain, ptr_out, out) = (1, 2, 3, 4, 5, 6, 7);
+    let (fn_void, main, label) = (8, 9, 10);
+    let mut w = module_start(0, main, &[out]); // Vertex
+    inst(
+        &mut w,
+        OP_MEMBER_DECORATE,
+        &[per_vertex, 0, DECORATION_BUILT_IN, BUILT_IN_POSITION],
+    );
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_FLOAT, &[float, 32]);
+    inst(&mut w, OP_TYPE_VECTOR, &[v4float, float, 4]);
+    inst(&mut w, OP_TYPE_STRUCT, &[per_vertex, v4float]);
+    inst(&mut w, OP_TYPE_STRUCT, &[plain, v4float]);
+    inst(
+        &mut w,
+        OP_TYPE_POINTER,
+        &[ptr_out, STORAGE_CLASS_OUTPUT, per_vertex],
+    );
+    inst(&mut w, OP_VARIABLE, &[ptr_out, out, STORAGE_CLASS_OUTPUT]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_FUNCTION, &[void, main, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[label]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    parse(&w).unwrap();
+}
