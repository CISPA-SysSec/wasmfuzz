+/// `OpCompositeInsert` with an index past the end of the composite.
+#[test]
+fn composite_insert_index_out_of_bounds() {
+    let (void, float, v2float, null, f0, fn_void, main, label, result) =
+        (1, 2, 3, 4, 5, 6, 7, 8, 9);
+    let mut w = module_start(5, main, &[]); // GLCompute
+    inst(&mut w, OP_EXECUTION_MODE, &[main, 17, 1, 1, 1]); // LocalSize 1 1 1
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_FLOAT, &[float, 32]);
+    inst(&mut w, OP_TYPE_VECTOR, &[v2float, float, 2]);
+    inst(&mut w, OP_CONSTANT_NULL, &[v2float, null]);
+    inst(&mut w, OP_CONSTANT, &[float, f0, 0]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_FUNCTION, &[void, main, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[label]);
+    inst(&mut w, OP_COMPOSITE_INSERT, &[v2float, result, f0, null, 5]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    let result = parse(&w);
+    assert!(
+        matches!(result, Err(spv::Error::InvalidAccessIndex(5))),
+        "{result:?}"
+    );
+}
