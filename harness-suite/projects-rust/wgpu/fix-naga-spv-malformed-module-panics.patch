+/// A call result whose result type is not a type, used outside the block
+/// that defines it, so that the frontend has to spill it to a local variable
+/// of that type.
+#[test]
+fn spill_of_call_result_with_undefined_type() {
+    let (void, bool_ty, fn_void, true_, callee, callee_label) = (1, 2, 3, 4, 5, 6);
+    let (main, entry, call, then, merge, not) = (7, 8, 9, 10, 11, 12);
+    let undefined_type = 99;
+    let mut w = module_start(5, main, &[]); // GLCompute
+    inst(&mut w, OP_EXECUTION_MODE, &[main, 17, 1, 1, 1]); // LocalSize 1 1 1
+    inst(&mut w, OP_TYPE_VOID, &[void]);
+    inst(&mut w, OP_TYPE_BOOL, &[bool_ty]);
+    inst(&mut w, OP_TYPE_FUNCTION, &[fn_void, void]);
+    inst(&mut w, OP_CONSTANT_TRUE, &[bool_ty, true_]);
+    inst(&mut w, OP_FUNCTION, &[void, callee, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[callee_label]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+    inst(&mut w, OP_FUNCTION, &[void, main, 0, fn_void]);
+    inst(&mut w, OP_LABEL, &[entry]);
+    inst(&mut w, OP_SELECTION_MERGE, &[merge, 0]);
+    inst(&mut w, OP_BRANCH_CONDITIONAL, &[true_, then, merge]);
+    inst(&mut w, OP_LABEL, &[then]);
+    inst(&mut w, OP_FUNCTION_CALL, &[undefined_type, call, callee]);
+    inst(&mut w, OP_BRANCH, &[merge]);
+    inst(&mut w, OP_LABEL, &[merge]);
+    inst(&mut w, OP_LOGICAL_NOT, &[bool_ty, not, call]);
+    inst(&mut w, OP_RETURN, &[]);
+    inst(&mut w, OP_FUNCTION_END, &[]);
+
+    let result = parse(&w);
+    assert!(
+        matches!(result, Err(spv::Error::InvalidId(99))),
+        "{result:?}"
+    );
+}
