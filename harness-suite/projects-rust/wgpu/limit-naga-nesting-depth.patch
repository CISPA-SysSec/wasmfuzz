+        if self.depth >= MAX_NESTING_DEPTH {
+            return Err(Error {
+                kind: ErrorKind::SemanticError("Nesting limit exceeded".into()),
+                meta: self.last_meta,
+            });
         }
+        self.depth += 1;
+        let result = f(self, frontend);
+        self.depth -= 1;
