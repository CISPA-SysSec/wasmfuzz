+#[test]
+fn deep_expression_nesting_is_error_not_stack_overflow() {
+    // Unoptimized frames are much larger, so give the limit room; without it,
+    // 100k levels overflow any stack.
+    std::thread::Builder::new()
+        .stack_size(64 << 20)
+        .spawn(deep_expression_nesting)
+        .unwrap()
+        .join()
+        .unwrap();
+}
+
+fn deep_expression_nesting() {
+    // Fuzz finding (wasm32 guest with a 1 MiB stack): unary and binary
+    // operator chains are parsed iteratively but lowered recursively, so
+    // `~~~~...1` or `1+1+...` a few thousand operators long overflowed the
+    // stack.
+    let n = 100_000;
+    for src in [
+        format!("const a = {}1;", "~".repeat(n)),
+        format!("const a = 1{};", "+1".repeat(n)),
+        format!("fn f() {{ var x = 1; x = x{}; }}", "*x".repeat(n)),
+    ] {
+        let err = naga::front::wgsl::parse_str(&src).expect_err(&src[..20]);
+        assert_eq!(err.message(), "expression nesting limit reached");
+    }
+    naga::front::wgsl::parse_str(&format!("const a = 1{};", "+1".repeat(1000))).unwrap();
+}
