+#[test]
+fn deep_nesting_is_error_not_stack_overflow() {
+    // Unoptimized frames are much larger, so give the limits room; without
+    // them, 100k levels overflow any stack.
+    std::thread::Builder::new()
+        .stack_size(64 << 20)
+        .spawn(deep_nesting)
+        .unwrap()
+        .join()
+        .unwrap();
+}
+
+fn deep_nesting() {
+    // Fuzz finding (wasm32 guest with a 1 MiB stack): the recursive descent
+    // parser and the expression lowering recurse once per nesting level, and
+    // a few hundred nested blocks or a few thousand unary operators overflowed
+    // the stack.
+    use alloc::format;
+    let n = 100_000;
+    for src in [
+        format!("void main() {}{}", "{".repeat(n), "}".repeat(n)),
+        format!("const int a = {}1; void main(){{}}", "~".repeat(n)),
+        format!("const int a = {}1{}; void main(){{}}", "(".repeat(n), ")".repeat(n)),
+        format!("const int a = 1{}; void main(){{}}", "+1".repeat(n)),
+        format!("void main() {{ int a; a{}; }}", "=a".repeat(n)),
+        format!("int a = {}1{}; void main(){{}}", "{".repeat(n), "}".repeat(n)),
+    ] {
+        let mut frontend = Frontend::default();
+        let result = frontend.parse(&Options::from(ShaderStage::Vertex), &src);
+        let errors = result.expect_err(&src[..40]).errors;
+        assert!(
+            matches!(&errors[0].kind, ErrorKind::SemanticError(msg) if msg.contains("esting limit exceeded")),
+            "{}: {errors:?}",
+            &src[..40]
+        );
+    }
+    let mut frontend = Frontend::default();
+    let src = format!(
+        "void main() {}{}{}",
+        "{".repeat(100),
+        format!("int a = 1{};", "+1".repeat(300)),
+        "}".repeat(100)
+    );
+    frontend
+        .parse(&Options::from(ShaderStage::Vertex), &src)
+        .unwrap();
+}
