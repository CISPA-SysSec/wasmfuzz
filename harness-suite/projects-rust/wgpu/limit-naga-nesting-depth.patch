+    /// Runs `f` one nesting level deeper, failing past [`MAX_NESTING_DEPTH`].
+    fn nested<T>(
+        &mut self,
+        frontend: &mut Frontend,
+        f: impl FnOnce(&mut Self, &mut Frontend) -> Result<T>,
