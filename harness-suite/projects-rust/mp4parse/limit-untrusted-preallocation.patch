index 0000000..5e53db4
--- /dev/null
+++ b/mp4parse/tests/untrusted_preallocation.rs
@@ -0,0 +1,164 @@
+//! Counts and box sizes read from the file must not be reserved up front.
+//!
+//! A few bytes of input declaring a huge count or box size used to make the
+//! parser reserve that much up front, which on 32-bit targets (wasm32) takes
+//! most of the address space and keeps it. This test binary records the
+//! largest allocation requested per thread (and caps the heap at 64 MiB so
+//! that such requests fail instead of committing memory).
+
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+use mp4parse as mp4;
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+use std::io::Cursor;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+const HEAP_LIMIT: usize = 64 << 20;
+
+struct CappedAlloc;
+
+static LIVE: AtomicUsize = AtomicUsize::new(0);
+
+thread_local! {
+    static MAX_REQUEST: Cell<usize> = const { Cell::new(0) };
+}
+
+impl CappedAlloc {
+    fn claim(&self, bytes: usize) -> bool {
+        MAX_REQUEST.with(|m| m.set(m.get().max(bytes)));
+        if LIVE.fetch_add(bytes, Ordering::Relaxed) + bytes > HEAP_LIMIT {
+            LIVE.fetch_sub(bytes, Ordering::Relaxed);
+            return false;
+        }
+        true
+    }
+}
+
+unsafe impl GlobalAlloc for CappedAlloc {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        if !self.claim(layout.size()) {
+            return std::ptr::null_mut();
+        }
+        System.alloc(layout)
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        LIVE.fetch_sub(layout.size(), Ordering::Relaxed);
+        System.dealloc(ptr, layout)
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        if new_size > layout.size() {
+            if !self.claim(new_size - layout.size()) {
+                return std::ptr::null_mut();
+            }
+        } else {
+            LIVE.fetch_sub(layout.size() - new_size, Ordering::Relaxed);
+        }
+        let p = System.realloc(ptr, layout, new_size);
+        if p.is_null() {
+            LIVE.fetch_sub(new_size, Ordering::Relaxed);
+            LIVE.fetch_add(layout.size(), Ordering::Relaxed);
+        }
+        p
+    }
+}
+
+#[global_allocator]
+static ALLOC: CappedAlloc = CappedAlloc;
+
+fn bmff_box(name: &[u8; 4], content: &[u8]) -> Vec<u8> {
+    let mut b = ((content.len() + 8) as u32).to_be_bytes().to_vec();
+    b.extend_from_slice(name);
+    b.extend_from_slice(content);
+    b
+}
+
+fn full_box(name: &[u8; 4], version: u8, content: &[u8]) -> Vec<u8> {
+    let mut c = vec![version, 0, 0, 0];
+    c.extend_from_slice(content);
+    bmff_box(name, &c)
+}
+
+fn hdlr(handler: &[u8; 4]) -> Vec<u8> {
+    let mut c = vec![0; 4]; // pre_defined
+    c.extend_from_slice(handler);
+    c.extend_from_slice(&[0; 12]); // reserved
+    c.push(0); // empty name
+    full_box(b"hdlr", 0, &c)
+}
+
+/// Parse `file` and check no single allocation exceeded 2 MiB (the parser
+/// reserves at most 1 MiB ahead of the data it has read).
+fn assert_no_untrusted_reservation<T>(parse: impl FnOnce() -> mp4::Result<T>) {
+    MAX_REQUEST.with(|m| m.set(0));
+    let r = parse();
+    let max = MAX_REQUEST.with(|m| m.get());
+    assert!(
+        max <= 2 << 20,
+        "parser requested {} bytes up front for an untrusted count or size",
+        max
+    );
+    if let Err(mp4::Error::OutOfMemory) = r {
+        panic!("parser ran out of memory");
+    }
+}
+
+#[test]
+fn stsd_huge_description_count() {
+    // A sample description box declaring 2^28 entries and containing none.
+    let stsd = full_box(b"stsd", 0, &0x1000_0000u32.to_be_bytes());
+    let stbl = bmff_box(b"stbl", &stsd);
+    let minf = bmff_box(b"minf", &stbl);
+    let mdia = bmff_box(b"mdia", &[hdlr(b"vide"), minf].concat());
+    let moov = bmff_box(b"moov", &bmff_box(b"trak", &mdia));
+    let file = [bmff_box(b"ftyp", b"isom\0\0\0\0isom"), moov].concat();
+    assert_no_untrusted_reservation(|| {
+        mp4::read_mp4(&mut Cursor::new(file), mp4::ParseStrictness::Normal)
+    });
+}
+
+#[test]
+fn iinf_huge_entry_count() {
+    // An item info box declaring 2^32-1 entries and containing none.
+    let iinf = full_box(b"iinf", 1, &u32::MAX.to_be_bytes());
+    let meta = full_box(b"meta", 0, &[hdlr(b"pict"), iinf].concat());
+    let file = [bmff_box(b"ftyp", b"avif\0\0\0\0avifmif1"), meta].concat();
+    assert_no_untrusted_reservation(|| {
+        mp4::read_avif(&mut Cursor::new(file), mp4::ParseStrictness::Normal)
+    });
+}
+
+#[test]
+fn pssh_huge_box_size() {
+    // A pssh box whose header declares 512 MiB but which holds only a few bytes.
+    let mut pssh = (512u32 << 20).to_be_bytes().to_vec();
+    pssh.extend_from_slice(b"pssh");
+    pssh.extend_from_slice(&[0; 24]);
+    let mut moov = ((pssh.len() + 8) as u32).to_be_bytes().to_vec();
+    moov.extend_from_slice(b"moov");
+    moov.extend_from_slice(&pssh);
+    let file = [bmff_box(b"ftyp", b"isom\0\0\0\0isom"), moov].concat();
+    assert_no_untrusted_reservation(|| {
+        mp4::read_mp4(&mut Cursor::new(file), mp4::ParseStrictness::Normal)
+    });
+}
+
+#[test]
+fn pssh_huge_kid_count() {
+    // A version 1 pssh box declaring 2^24 key IDs and containing none.
+    let mut c = vec![0; 16]; // system_id
+    c.extend_from_slice(&0x0100_0000u32.to_be_bytes());
+    let pssh = full_box(b"pssh", 1, &c);
+    let file = [
+        bmff_box(b"ftyp", b"isom\0\0\0\0isom"),
+        bmff_box(b"moov", &pssh),
+    ]
+    .concat();
+    assert_no_untrusted_reservation(|| {
+        mp4::read_mp4(&mut Cursor::new(file), mp4::ParseStrictness::Normal)
+    });
+}
