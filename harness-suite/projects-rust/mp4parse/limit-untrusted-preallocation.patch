+/// Upper bound, in bytes, on the capacity reserved up front from a count or
+/// size field read from the file. Such fields are untrusted: a few bytes of
+/// input can declare billions of entries or a multi-gigabyte box, and
+/// reserving all of it before any entry is read exhausts the address space of
+/// 32-bit targets (e.g. wasm32) even though the data never materializes.
+/// Buffers still grow (fallibly) beyond this as data is actually read.
+const MAX_UNTRUSTED_PREALLOCATION: usize = 1 << 20;
+
+/// Clamp an untrusted element count to a capacity worth reserving up front.
+fn untrusted_capacity<T>(count: usize) -> usize {
+    count.min(MAX_UNTRUSTED_PREALLOCATION / std::mem::size_of::<T>().max(1))
+}
+
+/// `TryVec::with_capacity` for a capacity taken from the file. See
+/// `MAX_UNTRUSTED_PREALLOCATION`.
+fn try_vec_with_untrusted_capacity<T>(
+    count: usize,
+) -> std::result::Result<TryVec<T>, TryReserveError> {
+    TryVec::with_capacity(untrusted_capacity::<T>(count))
+}
+
+/// Read up to `limit` bytes from `src` into `buf`, like
+/// `fallible_collections::try_read_up_to`, but reserve space as data arrives
+/// instead of reserving `limit` (usually a box size from the file) up front.
+fn try_read_up_to<R: Read>(
+    src: &mut R,
+    limit: u64,
+    buf: &mut TryVec<u8>,
+) -> std::io::Result<usize> {
+    let mut total = 0;
+    let mut left = limit;
+    while left > 0 {
+        let step = left.min(buf.len().max(MAX_UNTRUSTED_PREALLOCATION).to_u64());
+        let got = fallible_collections::try_read_up_to(src, step, buf)?;
+        total += got;
+        if got.to_u64() < step {
+            break;
+        }
+        left -= step;
+    }
+    Ok(total)
+}
