+/// Packs an export held in memory and returns the packed file's bytes,
+/// as `pack_to_vec` packs a file (read on one thread; the bytes do not
+/// depend on it).
+pub fn pack_bytes_to_vec(input: &[u8], opts: &Options) -> R<(Vec<u8>, Stats)> {
+    let mut pk = pk::Pk::new(input.len());
+    pk.reserve_all(input.len());
+    lines::read_bytes(input, &mut pk)?;
+    pk.finish();
+    let mut out = Vec::new();
+    let st = write::write(pk, &mut out, opts.index, opts.threads)?;
+    Ok((out, st))
+}
