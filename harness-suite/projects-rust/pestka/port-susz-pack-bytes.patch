+// Packs every line of an export held in memory, as `read_file` packs a
+// file's (one chunk: a last line without a newline gets one).
+pub fn read_bytes(src: &[u8], pk: &mut Pk) -> R<()> {
+    let mut buf: Vec<u8> = Vec::with_capacity(src.len() + 1 + PAD);
+    buf.extend_from_slice(src);
+    if buf.last().is_some_and(|&c| c != b'\n') {
+        buf.push(b'\n');
+    }
+    let lim = buf.len();
+    buf.resize(lim + PAD, 0);
+    let mut rd = Reader::new();
+    rd.lines(pk, &buf, 0, lim)?;
+    if !rd.header_done {
+        return Err("empty file".into());
+    }
+    Ok(())
+}
