+//! A lean4export NDJSON stream checked as the arena runs `scripts/arena-run FILE 4`, on
+//! one worker: the export is packed into Susz in memory (`susz pack --no-index`), loaded,
+//! and its declarations are checked in file order on the calling thread, stopping at the
+//! first failure (the verdict is the first failure in file order on any number of
+//! workers). A declaration whose blocks do not fit the worker's arena runs again in the
+//! overflow arenas, as in main.rs.
+//!
+//! main.rs turns a panic in a declaration into a decline. The one panic that is a limit
+//! by design is a worker table filling up between two of the checker's slow ticks
+//! (`Slab::full`, "a worker table is full"); a panic hook installed from a static
+//! constructor ends the test case through wasmfuzz's `exit_testcase` import for it. Every
+//! other panic is a finding. A trap (that exit, out of fuel, out of memory) makes wasmfuzz
+//! reset the instance; an input that returns leaves its state to the next one.
+
+#![no_main]
+
+use gruszka::{env, tc};
+use libfuzzer_sys::fuzz_target;
+use std::sync::atomic::AtomicU32;
+
+/// Linear-memory stack a worker may use before deep recursion declines (main.rs: the
+/// worker's stack less a quarter; the fuzzing build has a 16 MiB stack, and the engine's
+/// native stack runs out long before the linear one).
+const STACK_LIMIT: usize = 2 << 20;
+
+#[cfg(target_family = "wasm")]
+#[link(wasm_import_module = "wasmfuzz")]
+unsafe extern "C" {
+    #[link_name = "exit_testcase"]
+    fn wasmfuzz_exit_testcase() -> !;
+}
+
+#[allow(dead_code)]
+fn verdict_ends_testcase(payload: &(dyn std::any::Any + Send)) -> bool {
+    let msg = payload
+        .downcast_ref::<String>()
+        .map(|s| s.as_str())
+        .or_else(|| payload.downcast_ref::<&str>().copied())
+        .unwrap_or("");
+    msg.starts_with("a worker table is full")
+}
+
+#[used]
+#[unsafe(link_section = ".init_array")]
+static INIT: extern "C" fn() = {
+    extern "C" fn init() {
+        let next = std::panic::take_hook();
+        std::panic::set_hook(Box::new(move |info| {
+            #[cfg(target_family = "wasm")]
+            if verdict_ends_testcase(info.payload()) {
+                unsafe { wasmfuzz_exit_testcase() }
+            }
+            next(info)
+        }));
+    }
+    init
+};
+
+/// Leaks a value for the run of one input; `reclaim` frees it afterwards (the checker's
+/// worker takes `'static` references, as main.rs's workers do).
+fn lend<T>(x: T) -> &'static T {
+    Box::leak(Box::new(x))
+}
+unsafe fn reclaim<T: ?Sized>(x: &'static T) {
+    drop(unsafe { Box::from_raw(x as *const T as *mut T) });
+}
+
+fuzz_target!(|data: &[u8]| {
+    let opts = susz::pack::Options { index: false, threads: 1 };
+    // the packer's Invalid is a rejection, Cannot a decline
+    let Ok((bytes, _)) = susz::pack::pack_bytes_to_vec(data, &opts) else {
+        return;
+    };
+    // wasmfuzz runs input after input in one instance (until a trap or a periodic reset):
+    // the region and its layout are reused, everything else is freed after the input
+    let bytes: &'static [u8] = Box::leak(bytes.into_boxed_slice());
+    if let Ok(env) = env::load_part(bytes, None) {
+        let env: &'static env::Env<'static> = lend(env);
+        if env::region().layout(env.main.len(), 1).is_ok() {
+            tc::set_workers(1);
+            let shared = lend(tc::Shared::new(env.main.len(), env.consts.len()));
+            let first_fail = lend(AtomicU32::new(u32::MAX));
+            let mut w = tc::Worker::new(env, shared, first_fail, STACK_LIMIT);
+            for d in 0..env.decl_rows.len() as u32 {
+                let mut r = w.check_decl(d);
+                if w.arena_full && !matches!(r, Ok(()) | Err(tc::Stop::Cancel)) {
+                    let mut g = env::region().big.lock().unwrap();
+                    let big = g.as_mut().expect("overflow arenas taken before the layout");
+                    w.swap_big(big);
+                    r = w.check_decl(d);
+                    w.swap_big(big);
+                }
+                if r.is_err() {
+                    break;
+                }
+            }
+            drop(w);
+            unsafe {
+                reclaim(first_fail);
+                reclaim(shared);
+            }
+        }
+        unsafe { reclaim(env) };
+    }
+    unsafe { reclaim(bytes) };
+});
