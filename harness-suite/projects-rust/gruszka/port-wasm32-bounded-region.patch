+/// wasm32: no virtual memory to reserve. The region is a zeroed heap block
+/// that is never freed; a worker table is a heap block freed with the table
+/// (it is written before it is read: pushes), not zeroed, as zeroing it would
+/// cost every input that reaches a worker. Pages are not given back
+/// (`release` is only called on unix).
+#[cfg(not(unix))]
+mod vm {
+    use std::alloc::Layout;
+    fn layout(bytes: usize) -> Option<Layout> {
+        Layout::from_size_align(bytes.max(1), 64).ok()
+    }
+    pub fn reserve(bytes: usize) -> *mut u8 {
+        layout(bytes).map_or(std::ptr::null_mut(), |l| unsafe { std::alloc::alloc_zeroed(l) })
+    }
+    pub fn table(bytes: usize) -> *mut u8 {
+        layout(bytes).map_or(std::ptr::null_mut(), |l| unsafe { std::alloc::alloc(l) })
+    }
+    pub fn free(p: *mut u8, bytes: usize) {
+        if let Some(l) = layout(bytes) {
+            unsafe { std::alloc::dealloc(p, l) }
+        }
+    }
+}
