diff --git a/src/codecs/bmp/decoder.rs b/src/codecs/bmp/decoder.rs
index cba61ae..7f74558 100644
--- a/src/codecs/bmp/decoder.rs
+++ b/src/codecs/bmp/decoder.rs
@@ -1458,6 +1458,18 @@ impl<R: BufRead + Seek> BmpDecoder<R> {
 
     /// Read ICC profile data from the file.
     fn read_icc_profile(&mut self, icc: &ParsedIccProfile) -> ImageResult<()> {
+        // Real embedded profiles are small (typically < 4 MiB). Reject absurd sizes so
+        // adversarial headers cannot force multi-gigabyte allocations before we know
+        // the stream can supply the bytes.
+        const MAX_ICC_PROFILE_BYTES: u64 = 32 * 1024 * 1024;
+        if u64::from(icc.profile_size) > MAX_ICC_PROFILE_BYTES {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "BMP ICC profile too large",
+            )
+            .into());
+        }
+
         let profile_end = icc
             .profile_offset
             .checked_add(u64::from(icc.profile_size))
