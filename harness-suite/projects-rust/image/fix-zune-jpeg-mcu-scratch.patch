-        for i in 0..self.input_colorspace.num_components() {
+        // `setup_component_params` reconciles colorspace vs SOF component count in most cases;
+        // still guard against pathological headers that declare more channels than SOF provides.
+        let n_comp = self
+            .input_colorspace
+            .num_components()
+            .min(self.components.len());
+        if n_comp == 0 {
+            return Err(DecodeErrors::FormatStatic(
+                "JPEG progressive frame has no components"
+            ));
+        }
+        for i in 0..n_comp {
             let comp = &self.components[i];
             let len = mcu_width * comp.vertical_sample * comp.horizontal_sample * mcu_height;
 
