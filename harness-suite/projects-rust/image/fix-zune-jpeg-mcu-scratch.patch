-        let upsampler_scratch_size = is_hv * self.components[0].width_stride;
+        // Match `decode_mcu_ycbcr_baseline` and `finish_baseline_decoding`: HV upsampling needs
+        // `max(width_stride) * 8` i16 scratch elements. Using only the first component's stride
+        // under-allocates scratch space for some progressive JPEG layouts and triggers
+        // `upsample_hv` assertions.
+        let upsampler_scratch_size = is_hv
+            * self
+                .components
+                .iter()
+                .map(|x| x.width_stride)
+                .max()
+                .unwrap_or(0)
