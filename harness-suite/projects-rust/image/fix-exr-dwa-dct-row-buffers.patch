index 0000000..64f86aa
--- /dev/null
+++ b/tests/dwa_lossy_memory.rs
@@ -0,0 +1,80 @@
+//! The lossy DWA decoder must not buffer the DCT coefficients of a whole
+//! chunk: at 768 bytes per 8x8 block, a narrow and tall tile of 2-byte samples
+//! would need about 48 times the memory of its pixels.
+
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    sync::atomic::{AtomicUsize, Ordering},
+};
+
+use exr::{
+    math::RoundingMode,
+    meta::{attribute::LevelMode, header::Header, BlockDescription},
+    prelude::*,
+};
+use smallvec::smallvec;
+
+struct PeakAllocator;
+
+static CURRENT: AtomicUsize = AtomicUsize::new(0);
+static PEAK: AtomicUsize = AtomicUsize::new(0);
+
+unsafe impl GlobalAlloc for PeakAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let pointer = System.alloc(layout);
+        if !pointer.is_null() {
+            let current = CURRENT.fetch_add(layout.size(), Ordering::SeqCst) + layout.size();
+            PEAK.fetch_max(current, Ordering::SeqCst);
+        }
+        pointer
+    }
+
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+        System.dealloc(pointer, layout);
+        CURRENT.fetch_sub(layout.size(), Ordering::SeqCst);
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: PeakAllocator = PeakAllocator;
+
+#[test]
+fn lossy_dwa_memory_is_proportional_to_the_block() {
+    let height = 1 << 16;
+    let size = Vec2(1, height);
+    let tiles = TileDescription {
+        tile_size: size,
+        level_mode: LevelMode::Singular,
+        rounding_mode: RoundingMode::Down,
+    };
+
+    let compression = Compression::DWAA(None);
+    let channels = smallvec![ChannelDescription::named("Y", SampleType::F16)];
+    let header = Header::new("narrow".into(), size, channels).with_encoding(
+        compression,
+        BlockDescription::Tiles(tiles),
+        LineOrder::Increasing,
+    );
+
+    let rectangle = IntegerBounds::from_dimensions(size);
+    let raw: Vec<u8> = (0..height)
+        .flat_map(|y| f16::from_f32((y % 97) as f32 / 97.0).to_bits().to_ne_bytes())
+        .collect();
+
+    let compressed =
+        compression.compress_image_section_to_le(&header, raw.clone(), rectangle).unwrap();
+    assert!(compressed.len() < raw.len(), "block was not compressed");
+
+    let before = CURRENT.load(Ordering::SeqCst);
+    PEAK.store(before, Ordering::SeqCst);
+
+    let decoded =
+        compression.decompress_image_section_from_le(&header, compressed, rectangle, true).unwrap();
+
+    let peak = PEAK.load(Ordering::SeqCst) - before;
+    assert_eq!(decoded.len(), raw.len());
+    // The AC coefficients of the padded 8x8 blocks alone may take 8 times the
+    // pixel bytes for a 1 pixel wide tile, but buffering the DCT blocks of the
+    // whole chunk takes 48 times.
+    assert!(peak < 16 * raw.len(), "decoding a {} byte block allocated {} bytes", raw.len(), peak);
+}
