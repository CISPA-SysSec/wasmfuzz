Subject: [PATCH] image-webp: bound the lossless RGB temp buffer, guard huffman
 node index, check ALPH frame size

Three independent changes:
- huffman.rs `node_index` guard: the root cause (code lengths checked in u16
  arithmetic, which wraps for 15-bit codes) is fixed upstream by
  image-rs/image-webp#165 (4a794cd8), not released yet (0.2.4 is the latest).
  Same root cause as image-rs/image-webp#118.
- decoder.rs `read_frame` ANMF frame size check on the ALPH + VP8 path: open
  upstream PR image-rs/image-webp#186.
- decoder.rs lossless RGB temp buffer (`memory_limit`, `try_reserve_exact`):
  suite-only, for the wasm32 guest. Upstream memory-limit work is
  image-rs/image-webp#21.

--- a/src/decoder.rs
+++ b/src/decoder.rs
@@ -684,7 +684,17 @@
             if self.has_alpha {
                 decoder.decode_frame(self.width, self.height, false, buf)?;
             } else {
-                let mut data = vec![0; self.width as usize * self.height as usize * 4];
+                let tmp_len = (self.width as usize)
+                    .checked_mul(self.height as usize)
+                    .and_then(|x| x.checked_mul(4))
+                    .ok_or(DecodingError::MemoryLimitExceeded)?;
+                if tmp_len > self.memory_limit {
+                    return Err(DecodingError::MemoryLimitExceeded);
+                }
+                let mut data = Vec::new();
+                data.try_reserve_exact(tmp_len)
+                    .map_err(|_| DecodingError::MemoryLimitExceeded)?;
+                data.resize(tmp_len, 0);
                 decoder.decode_frame(self.width, self.height, false, &mut data)?;
                 for (rgba_val, chunk) in data.chunks_exact(4).zip(buf.chunks_exact_mut(3)) {
                     chunk.copy_from_slice(&rgba_val[..3]);
@@ -836,6 +846,11 @@
                 }
 
                 let frame = Vp8Decoder::decode_frame((&mut self.r).take(next_chunk_size))?;
+                if u32::from(frame.width) != frame_width
+                    || u32::from(frame.height) != frame_height
+                {
+                    return Err(DecodingError::InconsistentImageSizes);
+                }
 
                 let mut rgba_frame = vec![0; frame_width as usize * frame_height as usize * 4];
                 frame.fill_rgba(&mut rgba_frame, self.webp_decode_options.lossy_upsampling);
