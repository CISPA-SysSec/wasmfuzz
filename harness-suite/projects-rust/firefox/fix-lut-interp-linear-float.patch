+        let mut p = std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+        qcms_enable_iccv4();
+        p.push("fuzz");
+        p.push("samples");
+        p.push("0316-eb3f97ab646cd7b66bee80bdfe6098ac.icc");
+        let mut file = std::fs::File::open(p).unwrap();
+        let mut data = Vec::new();
+        file.read_to_end(&mut data).unwrap();
+        let profile =
+            unsafe { qcms_profile_from_memory(data.as_ptr() as *const c_void, data.len()) };
+        assert_ne!(profile, std::ptr::null_mut());
+        let identity = Profile::new_XYZD50();
+
+        unsafe { qcms_profile_precache_output_transform(&mut *profile) };
+        let intent = qcms_profile_get_rendering_intent(&identity);
+        let transform = unsafe { qcms_transform_create(&identity, RGB8, &*profile, RGB8, intent) };
+        assert_ne!(transform, std::ptr::null_mut());
+        unsafe {
+            qcms_transform_release(transform);
+            qcms_profile_release(profile);
+        }
+    }
