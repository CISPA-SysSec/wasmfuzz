diff --git a/fuzz/fuzz_targets/roundtrip.rs b/fuzz/fuzz_targets/roundtrip.rs
new file mode 100644
index 0000000..712a4ae
--- /dev/null
+++ b/fuzz/fuzz_targets/roundtrip.rs
@@ -0,0 +1,23 @@
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use serde_json::{Deserializer, Value};
+
+// Parse, re-serialize (compact and pretty) and re-parse; with float_roundtrip
+// the re-parsed value must be identical. Also drive the StreamDeserializer
+// over the raw input.
+fuzz_target!(|data: &[u8]| {
+    if let Ok(v) = serde_json::from_slice::<Value>(data) {
+        let compact = serde_json::to_vec(&v).unwrap();
+        let v2: Value = serde_json::from_slice(&compact).unwrap();
+        assert_eq!(v, v2, "compact roundtrip mismatch");
+        let pretty = serde_json::to_string_pretty(&v).unwrap();
+        let v3: Value = serde_json::from_str(&pretty).unwrap();
+        assert_eq!(v, v3, "pretty roundtrip mismatch");
+    }
+    for item in Deserializer::from_slice(data).into_iter::<Value>().take(64) {
+        if item.is_err() {
+            break;
+        }
+    }
+});
