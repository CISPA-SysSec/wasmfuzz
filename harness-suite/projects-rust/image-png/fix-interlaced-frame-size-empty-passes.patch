Subject: [PATCH] decoder: don't count filter bytes for empty Adam7 passes

The byte count of an interlaced frame (UnfilteringBuffer::start_frame, added
in #662) adds raw_row_length_from_width(samples) * lines for all 7 passes.
For a pass without samples (passes 2, 4 and 6 of an image 1 pixel wide, and
so on) raw_row_length_from_width(0) is 1, so one filter byte is counted per
line, although Adam7Iterator skips such passes and the encoder writes no rows
for them. The decoder then waits for image data that does not exist:

- a zlib stream that ends right after the pixel data without a final block
  (accepted for the non-interlaced image) is rejected with
  CorruptFlateStream { InsufficientInput }, and
- corrupt trailing zlib data after the pixel data is decompressed and
  reported, except when the reader hits an UnexpectedEof first and the frame
  is completed from the readable rows (the `buf_independent` fuzzer: results
  differ between a whole-slice reader and an intermittent-EOF reader).

Skip passes without samples. Valid images decode unchanged.
Test: test_interlaced_frame_size_skips_empty_passes.

diff --git a/src/decoder/mod.rs b/src/decoder/mod.rs
index d6e12b3..05fe360 100644
--- a/src/decoder/mod.rs
+++ b/src/decoder/mod.rs
@@ -374,10 +374,12 @@ impl<R: BufRead> Reader<R> {
         let frame_bytes = if self.info().interlaced {
             let mut bytes = 0u64;
             for pass in crate::adam7::PassConstants::PASSES {
-                bytes += self
-                    .info()
-                    .raw_row_length_from_width(pass.count_samples(self.subframe.width))
-                    as u64
+                // A pass without any samples has no rows at all (not even filter bytes).
+                let samples = pass.count_samples(self.subframe.width);
+                if samples == 0 {
+                    continue;
+                }
+                bytes += self.info().raw_row_length_from_width(samples) as u64
                     * pass.count_lines(self.subframe.height) as u64;
             }
             bytes
diff --git a/src/decoder/stream.rs b/src/decoder/stream.rs
index fba5e47..38a37f6 100644
--- a/src/decoder/stream.rs
+++ b/src/decoder/stream.rs
@@ -3810,4 +3810,28 @@ mod tests {
             assert!(reader.info().trns.is_none());
         }
     }
+
+    /// Adam7 passes without samples (passes 2, 4 and 6 of a 1-pixel-wide image) have no rows,
+    /// not even filter bytes. Counting one filter byte per line of such a pass made the decoder
+    /// expect more image data than the frame has, so a zlib stream that ends right after the
+    /// pixel data (no final block) was rejected for an interlaced image but not for the
+    /// non-interlaced one, and the outcome of decoding a stream with trailing garbage depended on
+    /// how the input was split into reads (found by the `buf_independent` fuzzer).
+    #[test]
+    fn test_interlaced_frame_size_skips_empty_passes() {
+        for interlace in [0, 1] {
+            // 1x1 8-bit grayscale: filter type 0, pixel 0x80 in a non-final stored block.
+            let idat = [0x78, 0x01, 0x00, 0x02, 0x00, 0xfd, 0xff, 0x00, 0x80];
+            let mut png = Vec::new();
+            write_png_sig(&mut png);
+            write_ihdr(&mut png, 1, 1, 8, 0, interlace);
+            write_chunk(&mut png, b"IDAT", &idat);
+            write_iend(&mut png);
+
+            let mut reader = Decoder::new(Cursor::new(png)).read_info().unwrap();
+            let mut buf = vec![0; reader.output_buffer_size().unwrap()];
+            reader.next_frame(&mut buf).unwrap();
+            assert_eq!(buf, [0x80], "interlace = {interlace}");
+        }
+    }
 }
