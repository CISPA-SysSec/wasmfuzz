+
+    /// This is a regression test found by the `buf_independent` fuzzer from the `png` crate. The
+    /// caller's output buffer holds exactly the data it needs (a PNG frame) and an invalid block
+    /// header follows that data. Decompressing the whole input at once used to fail with
+    /// `InvalidBlockType` (losing the output), while decompressing byte-by-byte filled the
+    /// output first, so a caller that stops once its output is full saw no error.
+    #[test]
+    fn test_input_chunking_sensitivity_error_after_full_output() {
+        // zlib header; fixed block with "ab" and end-of-block; final block with BTYPE=11; padding.
+        let input = [0x78, 0x01, 0x4a, 0x4c, 0x02, 0x1c, 0x00, 0x00];
+        for chunk_size in [1, input.len()] {
+            let mut d = Decompressor::new();
+            let mut output = [0u8; 2];
+            let (mut in_pos, mut out_pos) = (0, 0);
+            while out_pos < output.len() {
+                let end = (in_pos + chunk_size).min(input.len());
+                let (consumed, produced) = d
+                    .read(&input[in_pos..end], &mut output, out_pos, false)
+                    .unwrap();
+                in_pos += consumed;
+                out_pos += produced;
+            }
+            assert_eq!(&output, b"ab");
+
+            // The error is still reported once the caller asks for more output.
+            assert_eq!(
+                d.read(&input[in_pos..], &mut [0; 8], 0, true),
+                Err(DecompressionError::InvalidBlockType)
+            );
+        }
+    }
 }
