diff --git a/fuzz/fuzz_targets/fuzz_deflate_decode.rs b/fuzz/fuzz_targets/fuzz_deflate_decode.rs
new file mode 100644
index 0000000..a441fe2
--- /dev/null
+++ b/fuzz/fuzz_targets/fuzz_deflate_decode.rs
@@ -0,0 +1,28 @@
+#![no_main]
+use flate2::bufread;
+use flate2::read::DeflateDecoder;
+use libfuzzer_sys::fuzz_target;
+use std::io::prelude::*;
+
+// Cap output so decompression bombs don't exhaust the wasm heap.
+const LIMIT: u64 = 4 << 20;
+
+fuzz_target!(|data: &[u8]| {
+    // Read-based decoder (internally wrapped in a BufReader).
+    let mut out = Vec::new();
+    let r1 = DeflateDecoder::new(data).take(LIMIT).read_to_end(&mut out);
+
+    // BufRead-based decoder fed in small pieces through a tiny BufReader to
+    // exercise stream resumption at arbitrary input boundaries.
+    let split = if data.is_empty() { 1 } else { (data[0] as usize % 16) + 1 };
+    let reader = std::io::BufReader::with_capacity(split, data);
+    let mut out2 = Vec::new();
+    let r2 = bufread::DeflateDecoder::new(reader).take(LIMIT).read_to_end(&mut out2);
+
+    // Both decoders must agree on fully successful decodes.
+    if let (Ok(n1), Ok(n2)) = (r1, r2) {
+        if (n1 as u64) < LIMIT && (n2 as u64) < LIMIT {
+            assert_eq!(out, out2, "read and bufread decoders disagree");
+        }
+    }
+});
