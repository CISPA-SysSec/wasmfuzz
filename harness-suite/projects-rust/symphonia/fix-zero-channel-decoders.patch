--- /dev/null
+++ b/symphonia-codec-adpcm/tests/zero_channels.rs
@@ -0,0 +1,19 @@
+use symphonia_codec_adpcm::AdpcmDecoder;
+use symphonia_core::audio::Channels;
+use symphonia_core::codecs::audio::well_known::{CODEC_ID_ADPCM_IMA_QT, CODEC_ID_ADPCM_IMA_WAV};
+use symphonia_core::codecs::audio::{AudioCodecParameters, AudioDecoderOptions};
+
+#[test]
+fn reject_zero_channels() {
+    for codec in [CODEC_ID_ADPCM_IMA_WAV, CODEC_ID_ADPCM_IMA_QT] {
+        let mut params = AudioCodecParameters::new();
+        params
+            .for_codec(codec)
+            .with_sample_rate(44100)
+            .with_channels(Channels::Custom([].into()))
+            .with_max_frames_per_packet(64)
+            .with_frames_per_block(64);
+
+        assert!(AdpcmDecoder::try_new(&params, &AudioDecoderOptions::default()).is_err());
+    }
+}
