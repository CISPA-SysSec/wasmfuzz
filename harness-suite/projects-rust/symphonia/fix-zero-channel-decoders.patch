new file mode 100644
index 0000000..b5eafe6
--- /dev/null
+++ b/symphonia-codec-aac/tests/zero_channels.rs
@@ -0,0 +1,16 @@
+use symphonia_codec_aac::AacDecoder;
+use symphonia_core::audio::Channels;
+use symphonia_core::codecs::audio::well_known::CODEC_ID_AAC;
+use symphonia_core::codecs::audio::{AudioCodecParameters, AudioDecoderOptions};
+
+#[test]
+fn reject_zero_channels() {
+    // Without an AudioSpecificConfig the channels come from the codec parameters.
+    let mut params = AudioCodecParameters::new();
+    params
+        .for_codec(CODEC_ID_AAC)
+        .with_sample_rate(44100)
+        .with_channels(Channels::Custom([].into()));
+
+    assert!(AacDecoder::try_new(&params, &AudioDecoderOptions::default()).is_err());
+}
