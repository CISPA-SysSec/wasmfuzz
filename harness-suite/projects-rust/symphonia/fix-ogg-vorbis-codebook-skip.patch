@@ -0,0 +1,91 @@
+use std::io::Cursor;
+
+use symphonia_core::checksum::Crc32;
+use symphonia_core::formats::FormatOptions;
+use symphonia_core::io::{MediaSourceStream, Monitor};
+use symphonia_format_ogg::OggReader;
+
+/// Builds an Ogg page containing a single complete packet.
+fn page(sequence: u32, flags: u8, packet: &[u8]) -> Vec<u8> {
+    assert!(packet.len() < 255);
+
+    let mut page = b"OggS".to_vec();
+    page.push(0); // Version.
+    page.push(flags);
+    page.extend_from_slice(&0u64.to_le_bytes()); // Granule position.
+    page.extend_from_slice(&1u32.to_le_bytes()); // Serial.
+    page.extend_from_slice(&sequence.to_le_bytes());
+    page.extend_from_slice(&0u32.to_le_bytes()); // CRC, filled in below.
+    page.extend_from_slice(&[1, packet.len() as u8]);
+    page.extend_from_slice(packet);
+
+    let mut crc = Crc32::new(0);
+    crc.process_buf_bytes(&page);
+    page[22..26].copy_from_slice(&crc.crc().to_le_bytes());
+    page
+}
+
+/// Writes bits least-significant bit first, as the Vorbis setup header is packed.
+#[derive(Default)]
+struct BitWriter {
+    buf: Vec<u8>,
+    len: usize,
+}
+
+impl BitWriter {
+    fn put(&mut self, value: u32, bits: u32) {
+        for i in 0..bits {
+            if self.len % 8 == 0 {
+                self.buf.push(0);
+            }
+            if (value >> i) & 1 != 0 {
+                *self.buf.last_mut().unwrap() |= 1 << (self.len % 8);
+            }
+            self.len += 1;
+        }
+    }
+}
+
+/// Builds an Ogg Vorbis stream whose setup header starts with a codebook that has five entries,
+/// the given number of dimensions, and a lookup table of type 1. The setup header ends after the
+/// lookup table parameters.
+fn stream_with_lookup1_codebook(dimensions: u32) -> Vec<u8> {
+    let mut ident = b"\x01vorbis".to_vec();
+    ident.extend_from_slice(&0u32.to_le_bytes()); // Version.
+    ident.push(1); // Channels.
+    ident.extend_from_slice(&44100u32.to_le_bytes());
+    ident.extend_from_slice(&[0; 12]); // Bitrates.
+    ident.extend_from_slice(&[0xb8, 1]); // Block sizes and framing flag.
+
+    let mut bs = BitWriter::default();
+    bs.put(0, 8); // One codebook.
+    bs.put(0x564342, 24); // Codebook sync.
+    bs.put(dimensions, 16);
+    bs.put(5, 24); // Entries.
+    bs.put(0, 2); // Not ordered, not sparse.
+    for _ in 0..5 {
+        bs.put(2, 5); // Codeword length - 1.
+    }
+    bs.put(1, 4); // Lookup type.
+    bs.put(0, 32); // Minimum value.
+    bs.put(0, 32); // Delta value.
+    bs.put(0, 5); // Value bits - 1 and sequence flag.
+
+    let mut setup = b"\x05vorbis".to_vec();
+    setup.extend_from_slice(&bs.buf);
+
+    let mut file = page(0, 0x2, &ident);
+    file.extend(page(1, 0, &setup));
+    file
+}
+
+#[test]
+fn setup_with_invalid_lookup1_codebook() {
+    // The number of lookup values for 0 dimensions is undefined, and for 40 dimensions 2^40
+    // overflows a u32.
+    for dimensions in [0, 40] {
+        let file = stream_with_lookup1_codebook(dimensions);
+        let mss = MediaSourceStream::new(Box::new(Cursor::new(file)), Default::default());
+        let _ = OggReader::try_new(mss, FormatOptions::default());
+    }
+}
