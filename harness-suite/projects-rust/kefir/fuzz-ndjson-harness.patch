+//! A lean4export NDJSON stream checked as the arena runs `kefir
+//! --axiom-policy=allow-all-declared-axioms` (and kefir-wasm): one single-use `Run`,
+//! checking in file order on the calling thread (wasm32 has no threads), the report
+//! written to a sink.
+
+#![no_main]
+
+use std::sync::Mutex;
+
+use kefir::{AxiomPolicy, Run};
+use libfuzzer_sys::fuzz_target;
+
+// A `Run` reserves its report buffers (1 MiB) before it reads input; that does not
+// depend on the input, so one is built from a static constructor. wasmfuzz restores
+// that snapshot for every input, so each takes the run built there; a runner without
+// snapshots builds a fresh one after the first input (a run is single-use).
+static RUN: Mutex<Option<Run>> = Mutex::new(None);
+
+fn new_run() -> Run {
+    Run::new_with_axiom_policy(false, AxiomPolicy::AllowAllDeclaredAxioms)
+}
+
+#[used]
+#[link_section = ".init_array"]
+static INIT: extern "C" fn() = {
+    extern "C" fn init() {
+        *RUN.lock().unwrap() = Some(new_run());
+    }
+    init
+};
+
+fuzz_target!(|data: &[u8]| {
+    let built = RUN.lock().unwrap().take();
+    let mut run = built.unwrap_or_else(new_run);
+    let mut input = data;
+    let _ = run.check(&mut input, &mut std::io::sink());
+});
