+            if fuzzing {
+                wasm_layout::FUZZING_STACK_BYTES
+            } else {
+                wasm_layout::STACK_BYTES
+            }
         );
         println!(
             "cargo:rustc-link-arg=--max-memory={}",
             wasm_layout::MAX_MEMORY_BYTES
         );
-        println!(
-            "cargo:rustc-link-arg=--initial-memory={}",
-            wasm_layout::INITIAL_MEMORY_BYTES
-        );
+        if !fuzzing {
+            println!(
+                "cargo:rustc-link-arg=--initial-memory={}",
+                wasm_layout::INITIAL_MEMORY_BYTES
+            );
+        }
     }
