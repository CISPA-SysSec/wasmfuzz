+//! A lean4export NDJSON stream checked as the arena runs `sokonanoda --stdin
+//! --nat-extension --string-extension --axiom-allow-all`, on one thread: the export is
+//! parsed from memory (as a mapped file is), then `check_all_declars` checks every
+//! declaration in file order.
+//!
+//! sokonanoda rejects and declines by panicking with a `Rejection` / `Decline` payload,
+//! which its CLI catches. The fuzzing build aborts on panic, so a panic hook installed
+//! from a static constructor ends the test case through wasmfuzz's `exit_testcase`
+//! import for those two payloads; every other panic is a finding. (Other runners would
+//! see every rejection as a crash: the harness is meant for wasm32 under wasmfuzz.)
+
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use sokonanoda::{AxiomPolicy, Config, Decline, Output, Rejection};
+
+#[cfg(target_family = "wasm")]
+#[link(wasm_import_module = "wasmfuzz")]
+extern "C" {
+    #[link_name = "exit_testcase"]
+    fn wasmfuzz_exit_testcase() -> !;
+}
+
+fn verdict_ends_testcase(payload: &(dyn std::any::Any + Send)) -> bool {
+    payload.is::<Rejection>() || payload.is::<Decline>()
+}
+
+#[used]
+#[link_section = ".init_array"]
+static INIT: extern "C" fn() = {
+    extern "C" fn init() {
+        let next = std::panic::take_hook();
+        std::panic::set_hook(Box::new(move |info| {
+            #[cfg(target_family = "wasm")]
+            if verdict_ends_testcase(info.payload()) {
+                unsafe { wasmfuzz_exit_testcase() }
+            }
+            next(info)
+        }));
+    }
+    init
+};
+
+fuzz_target!(|data: &[u8]| {
+    let config = Config {
+        export_file_path: None,
+        use_stdin: false,
+        axiom_policy: AxiomPolicy::AllowAll,
+        num_threads: 1,
+        parse_only: false,
+        nat_extension: true,
+        string_extension: true,
+        output: Output::default(),
+    };
+    let Ok(export) = config.to_export_file_from_bytes(data) else {
+        return;
+    };
+    let _ = export.check_all_declars();
+});
