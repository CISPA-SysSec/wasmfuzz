diff --git a/src/lib.rs b/src/lib.rs
index ab44865..73905d0 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -13,3 +13,25 @@ pub use config::{AxiomPolicy, Config, DisallowedAxiom, Output};
 pub use outcome::{CheckError, Decline, Rejection};
 
 pub(crate) const STACK_SIZE: usize = 2 * 1024 * 1024 * 1024;
+
+/// Runs `f` on a scoped thread with a `STACK_SIZE` stack and joins it (`Err(payload)`
+/// when it panicked). wasm32-wasip1 has no threads: `f` runs on the calling thread
+/// there, and a panic aborts the module.
+pub(crate) fn on_big_stack<T: Send>(
+    name: Option<&str>,
+    f: impl FnOnce() -> T + Send,
+) -> std::io::Result<std::thread::Result<T>> {
+    #[cfg(target_family = "wasm")]
+    {
+        let _ = name;
+        Ok(Ok(f()))
+    }
+    #[cfg(not(target_family = "wasm"))]
+    std::thread::scope(|scope| {
+        let mut builder = std::thread::Builder::new().stack_size(STACK_SIZE);
+        if let Some(name) = name {
+            builder = builder.name(name.to_owned());
+        }
+        Ok(builder.spawn_scoped(scope, f)?.join())
+    })
+}
