+#[cfg(test)]
+mod loose_bvar_tests {
+    use crate::config::Config;
+    use crate::frontend::parser::parse_export_mapped;
+    use crate::outcome::CheckError;
+
+    fn check(export: &str) -> Result<(), CheckError> {
+        std::panic::catch_unwind(|| parse_export_mapped(export.as_bytes(), Config::default()))
+            .map_err(CheckError::from_panic)?
+            .map_err(|e| CheckError::Rejected(crate::outcome::Rejection(e.to_string())))?
+            .check_all_declars()
+    }
+
+    fn assert_loose_bvar_rejected(export: &str) {
+        match check(export) {
+            Err(CheckError::Rejected(r)) => {
+                assert!(r.0.contains("loose bound variable"), "unexpected rejection: {r}");
+            }
+            Err(CheckError::Declined(d)) => panic!("expected a rejection, got decline {d}"),
+            Err(CheckError::Internal(_)) => panic!("expected a rejection, got an internal panic"),
+            Ok(()) => panic!("expected a rejection, got acceptance"),
+        }
+    }
+
+    /// `axiom bad : #1` (type inference meets the loose variable).
+    #[test]
+    fn rejects_loose_bvar_in_axiom_type() {
+        assert_loose_bvar_rejected(
+            r#"{"in":1,"str":{"pre":0,"str":"bad"}}
+{"ie":0,"bvar":1}
+{"axiom":{"name":1,"levelParams":[],"type":0,"isUnsafe":false}}
+"#,
+        );
+    }
+
+    /// `def bad : Type := #0` and an inductive `I : bad`: checking the inductive's type
+    /// unfolds `bad` (evaluation meets the loose variable).
+    #[test]
+    fn rejects_loose_bvar_in_unfolded_value() {
+        assert_loose_bvar_rejected(
+            r#"{"in":1,"str":{"pre":0,"str":"bad"}}
+{"il":1,"succ":0}
+{"ie":0,"sort":1}
+{"ie":1,"bvar":0}
+{"def":{"all":[1],"hints":{"regular":1},"levelParams":[],"name":1,"safety":"safe","type":0,"value":1}}
+{"in":2,"str":{"pre":0,"str":"I"}}
+{"in":3,"str":{"pre":2,"str":"rec"}}
+{"ie":2,"const":{"name":1,"us":[]}}
+{"inductive":{"ctors":[],"recs":[{"all":[2],"isUnsafe":false,"k":false,"levelParams":[],"name":3,"numIndices":0,"numMinors":0,"numMotives":1,"numParams":0,"rules":[],"type":0}],"types":[{"all":[2],"ctors":[],"isRec":false,"isReflexive":false,"isUnsafe":false,"levelParams":[],"name":2,"numIndices":0,"numNested":0,"numParams":0,"type":2}]}}
+"#,
+        );
+    }
