diff --git a/src/frontend/parser/tests.rs b/src/frontend/parser/tests.rs
index 0644981..ea5e436 100644
--- a/src/frontend/parser/tests.rs
+++ b/src/frontend/parser/tests.rs
@@ -111,3 +111,44 @@ fn reject_undefined_binder_type() {
         "export references expression index 99 before it is defined"
     );
 }
+
+fn check_export(export: &str) -> Result<(), crate::outcome::CheckError> {
+    use crate::outcome::{CheckError, Rejection};
+    std::panic::catch_unwind(|| parse_export_mapped(export.as_bytes(), Config::default()))
+        .map_err(CheckError::from_panic)?
+        .map_err(|e| CheckError::Rejected(Rejection(e.to_string())))?
+        .check_all_declars()
+}
+
+fn assert_rejected_with(export: &str, message: &str) {
+    match check_export(export) {
+        Err(crate::outcome::CheckError::Rejected(r)) => {
+            assert!(r.0.contains(message), "unexpected rejection: {r}");
+        }
+        Err(crate::outcome::CheckError::Declined(d)) => panic!("expected a rejection, got {d}"),
+        Err(crate::outcome::CheckError::Internal(_)) => panic!("expected a rejection, got a panic"),
+        Ok(()) => panic!("expected a rejection, got acceptance"),
+    }
+}
+
+#[test]
+fn reject_record_without_index() {
+    assert_rejected_with(
+        "{\"ie\":0,\"sort\":0}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":0,\"name\":0,\"type\":0}}\n",
+        "missing its index",
+    );
+}
+
+#[test]
+fn reject_projection_index_beyond_u16() {
+    assert_rejected_with(
+        "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"S\"}}\n{\"ie\":0,\"sort\":0}\n{\"ie\":1,\"proj\":{\"typeName\":1,\"idx\":70000,\"struct\":0}}\n",
+        "does not fit in u16",
+    );
+}
+
+#[test]
+fn decline_universe_parameter_without_level_record() {
+    let export = "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"u\"}}\n{\"in\":2,\"str\":{\"pre\":0,\"str\":\"f\"}}\n{\"il\":1,\"succ\":0}\n{\"ie\":0,\"sort\":1}\n{\"axiom\":{\"name\":2,\"levelParams\":[1],\"type\":0,\"isUnsafe\":false}}\n";
+    assert!(matches!(check_export(export), Err(crate::outcome::CheckError::Declined(_))));
+}
