+/// Nesting of the recursive evaluation, conversion and inference steps (`Nest::enter`
+/// in eval_node, apply_new, whnf_head_uncached, value_type_uncached, unify_general and
+/// infer_nonvar). Native checking runs on 2 GiB stacks and has no limit; on wasm32
+/// (and in `--cfg fuzzing` builds, so native replays agree) guest calls run on the
+/// engine's native stack (wasmfuzz: 8 MiB for run-input, 32 MiB per fuzzing worker),
+/// so past `MAX_NEST` nested steps the export is declined.
+#[cfg(any(target_family = "wasm", fuzzing))]
+pub(crate) const MAX_NEST: u32 = 2048;
+
+#[cfg(any(target_family = "wasm", fuzzing))]
+thread_local! {
+    static NEST: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+}
+
+pub(crate) struct Nest(());
+
+impl Nest {
+    #[inline(always)]
+    pub(crate) fn enter() -> Nest {
+        #[cfg(any(target_family = "wasm", fuzzing))]
+        NEST.with(|n| {
+            let d = n.get();
+            if d >= MAX_NEST {
+                unsupported!("recursion deeper than {MAX_NEST} nested steps");
+            }
+            n.set(d + 1);
+        });
+        Nest(())
+    }
+}
+
+#[cfg(any(target_family = "wasm", fuzzing))]
+impl Drop for Nest {
+    #[inline(always)]
+    fn drop(&mut self) {
+        NEST.with(|n| n.set(n.get() - 1));
+    }
+}
+
 pub(crate) fn decline<A>(msg: impl Into<String>) -> Result<A, Box<dyn Error>> {
     Err(Box::new(Decline(msg.into())))
 }
