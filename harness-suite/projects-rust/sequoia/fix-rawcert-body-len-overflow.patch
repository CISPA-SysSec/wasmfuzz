+    /// Adds `amount` to the cursor, returning an error if the sum
+    /// overflows.
+    ///
+    /// On 32-bit platforms a huge `amount` (for example an OpenPGP
+    /// four-octet packet length near `u32::MAX`) used to wrap
+    /// `cursor + amount`.  That made `data_hard` succeed with a short
+    /// buffer, after which callers that sliced with the unwrapped
+    /// length panicked.
+    fn cursor_plus(&self, amount: usize) -> Result<usize, io::Error> {
+        self.cursor.checked_add(amount).ok_or_else(|| {
+            io::Error::new(io::ErrorKind::UnexpectedEof, "read length overflow")
+        })
+    }
 }
 
