+    #[test]
+    fn cursor_plus_amount_overflow() {
+        // After consuming one byte, `cursor + usize::MAX` overflows
+        // on every pointer width.  `data_consume_hard` must return an
+        // error instead of wrapping and handing back a short slice.
+        let mut reader = Dup::new(Memory::new(b"0123456789"));
+        reader.consume(1);
+        assert!(reader.data_consume_hard(usize::MAX).is_err());
+        assert_eq!(reader.total_out(), 1);
+        // Cursor must be unchanged; remaining data is still readable.
+        assert_eq!(reader.data(1).unwrap(), b"123456789");
+    }
