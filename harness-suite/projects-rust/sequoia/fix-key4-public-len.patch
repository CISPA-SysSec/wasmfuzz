new file mode 100644
index 00000000..19622ac8
--- /dev/null
+++ b/openpgp/tests/key4_public_len.rs
@@ -0,0 +1,38 @@
+//! A version 4 key packet whose public key material does not fit the
+//! two-octet length that v4 fingerprints hash must not parse as a key.
+
+use sequoia_openpgp as openpgp;
+use openpgp::{Packet, PacketPile};
+use openpgp::parse::Parse;
+
+#[test]
+fn key4_public_key_material_too_large() {
+    // The fingerprint hashes the version, creation time, algorithm
+    // (6 octets) and the public key material.  65529 octets of key
+    // material is the most that fits.
+    for (rest, is_key) in [(65529, true), (65530, false), (70000, false)] {
+        // A version 4 public key with a private algorithm, whose key
+        // material is kept as is.
+        let mut body = vec![4, 0, 0, 0, 0, 100];
+        body.resize(6 + rest, 0);
+
+        // A public key packet with a five-octet length.
+        let mut packet = vec![0xc6, 0xff];
+        packet.extend_from_slice(&(body.len() as u32).to_be_bytes());
+        packet.extend_from_slice(&body);
+
+        let pile = PacketPile::from_bytes(&packet).unwrap();
+        // Formatting a key computes its fingerprint.
+        let _ = format!("{:?}", pile);
+        let packets: Vec<&Packet> = pile.descendants().collect();
+        assert_eq!(packets.len(), 1);
+        match packets[0] {
+            Packet::PublicKey(key) => {
+                assert!(is_key);
+                let _ = key.fingerprint();
+            },
+            Packet::Unknown(_) => assert!(! is_key),
+            p => panic!("unexpected packet {:?}", p),
+        }
+    }
+}
