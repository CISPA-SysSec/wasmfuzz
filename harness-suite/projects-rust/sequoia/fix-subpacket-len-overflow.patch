+//! A five-octet subpacket length close to `u32::MAX` must not wrap
+//! the subpacket area bounds check or the body length check on
+//! 32-bit targets.
+
+use sequoia_openpgp as openpgp;
+use openpgp::{Packet, PacketPile};
+use openpgp::parse::Parse;
+
+#[test]
+fn subpacket_length_close_to_u32_max() {
+    for len in [0xffff_fffb_u32, 0xffff_fffd, 0xffff_ffff] {
+        // A five-octet subpacket length, a private subpacket tag, and
+        // a few bytes of the subpacket body.
+        let mut hashed = vec![0xff];
+        hashed.extend_from_slice(&len.to_be_bytes());
+        hashed.push(100);
+        hashed.extend_from_slice(&[0; 8]);
+
+        // A version 4 positive certification (RSA, SHA256) with that
+        // hashed area, an empty unhashed area, the digest prefix, and
+        // an MPI.
+        let mut body = vec![4, 0x13, 1, 8];
+        body.extend_from_slice(&(hashed.len() as u16).to_be_bytes());
+        body.extend_from_slice(&hashed);
+        body.extend_from_slice(&[0, 0, 0, 0, 0, 8, 0xff]);
+
+        let mut packet = vec![0xc2, body.len() as u8];
+        packet.extend_from_slice(&body);
+
+        let pile = PacketPile::from_bytes(&packet).unwrap();
+        let packets: Vec<&Packet> = pile.descendants().collect();
+        assert_eq!(packets.len(), 1);
+        assert!(matches!(packets[0], Packet::Unknown(_)));
+    }
+}
+
+#[test]
+fn subpacket_length_close_to_u32_max_v6() {
+    // A version 6 signature has four-octet subpacket area lengths.
+    // An area length of u32::MAX is usize::MAX on 32-bit targets, so
+    // the subpacket length plus the size of its encoding must neither
+    // wrap (0xffff_fffb and up) nor reach the end of the address
+    // space (0xffff_fffa).
+    for len in [0xffff_fffa_u32, 0xffff_fffb, 0xffff_ffff] {
+        // A five-octet subpacket length, a signature creation time
+        // subpacket, and a few more bytes.
+        let mut hashed = vec![0xff];
+        hashed.extend_from_slice(&len.to_be_bytes());
+        hashed.push(2);
+        hashed.extend_from_slice(&[0; 16]);
+
+        // A version 6 positive certification (RSA, SHA256) whose
+        // hashed area claims to be u32::MAX bytes long.
+        let mut body = vec![6, 0x13, 1, 8];
+        body.extend_from_slice(&u32::MAX.to_be_bytes());
+        body.extend_from_slice(&hashed);
+
+        let mut packet = vec![0xc2, body.len() as u8];
+        packet.extend_from_slice(&body);
+
+        let pile = PacketPile::from_bytes(&packet).unwrap();
+        let packets: Vec<&Packet> = pile.descendants().collect();
+        assert_eq!(packets.len(), 1);
+        assert!(matches!(packets[0], Packet::Unknown(_)));
+    }
+}
