 	zero_length_test ("zero_length.wav") ;
 	bad_wav_test ("bad_wav.wav") ;
 	wav_list_recover_test ("list_recover.wav") ;
+	wav_list_huge_subchunk_test ("list_huge_subchunk.wav") ;
 
 	unrecognised_test () ;
 
