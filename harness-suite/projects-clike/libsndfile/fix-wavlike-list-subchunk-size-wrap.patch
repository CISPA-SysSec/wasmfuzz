Bounds-check LIST sub-chunk sizes in 64-bit arithmetic (upstream PR libsndfile/libsndfile#1211).

wavlike_subchunk_parse() pads chunk_size and checks bytesread + chunk_size > chunk_length in
uint32_t. A sub-chunk size like 0xfffffff0 wraps the sum, the check passes, and the "j" skip
seeks backwards, so the loop re-reads the same marker and sf_open() never returns (36-byte
RIFX file). This is the diff of the open PR #1211 (fixes issue #1118), including its
error_test case; drop the patch once #1211 lands.

diff --git a/src/wavlike.c b/src/wavlike.c
index d2f74b89d..3748dbcff 100644
--- a/src/wavlike.c
+++ b/src/wavlike.c
@@ -1087,13 +1087,13 @@ wavlike_subchunk_parse (SF_PRIVATE *psf, int chunk, uint32_t chunk_length)
 
 			default :
 					bytesread += psf_binheader_readf (psf, "4", &chunk_size) ;
-					chunk_size += (chunk_size & 1) ;
-					if (bytesread + chunk_size > chunk_length)
+					if ((uint64_t) bytesread + chunk_size + (chunk_size & 1) > chunk_length)
 					{	psf_log_printf (psf, "  *** %M : %u (too big)\n", chunk, chunk_size) ;
 						goto cleanup_subchunk_parse ;
 						}
 					else
-					{	psf_log_printf (psf, "    %M : %u\n", chunk, chunk_size) ;
+					{	chunk_size += (chunk_size & 1) ;
+						psf_log_printf (psf, "    %M : %u\n", chunk, chunk_size) ;
 						bytesread += psf_binheader_readf (psf, "j", chunk_size) ;
 						} ;
 					break ;
diff --git a/tests/error_test.c b/tests/error_test.c
index 8c441524d..0ecdbab01 100644
--- a/tests/error_test.c
+++ b/tests/error_test.c
@@ -219,6 +219,46 @@ wav_list_recover_test (const char * filename)
 	puts ("ok") ;
 } /* wav_list_recover_test */
 
+static void
+wav_list_huge_subchunk_test (const char * filename)
+{	SNDFILE		*sndfile ;
+	SF_INFO		sfinfo ;
+
+	FILE		*file ;
+	const char	data [] =
+		"RIFF" "H\000\000\000"
+		"WAVE" "fmt " "\020\000\000\000" "\001\000\001\000D\254\000\000\210X\001\000\002\000\020\000"
+		"LIST" "\030\000\000\000" "INFO" "abcd" "\370\377\377\377" "123456789012" /* abcd size 0xfffffff8 */
+		"data" "\004\000\000\000" "abcd" ;
+
+	print_test_name (__func__, filename) ;
+
+	if ((file = fopen (filename, "wb")) == NULL)
+	{	printf ("\n\nLine %d : fopen returned NULL.\n", __LINE__) ;
+		exit (1) ;
+		} ;
+
+	exit_if_true (fwrite (data, sizeof (data) - 1, 1, file) != 1, "\n\nLine %d : fwrite failed.\n", __LINE__) ;
+	fclose (file) ;
+
+	memset (&sfinfo, 0, sizeof (sfinfo)) ;
+	sndfile = sf_open (filename, SFM_READ, &sfinfo) ;
+
+	if (!sndfile)
+	{	printf ("\n\nLine %d : expected recovery from oversized LIST sub-chunk.\n", __LINE__) ;
+		exit (1) ;
+		} ;
+
+	if (sfinfo.frames != 2)
+	{	printf ("\n\nLine %d : Should have read data chunk with 2 stereo frames, got %ld.\n\n", __LINE__, (long)sfinfo.frames) ;
+		exit (1) ;
+		} ;
+
+	sf_close (sndfile) ;
+	unlink (filename) ;
+	puts ("ok") ;
+} /* wav_list_huge_subchunk_test */
