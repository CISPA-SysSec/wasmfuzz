+	/*
+	 * The mapping arrays are relative to mapping_array_base_tsn, so bits
+	 * left over from the peer's previous initial TSN (e.g. a COOKIE-ECHO
+	 * handled as case B of RFC 9260, section 5.2.4, on an established
+	 * association) would mark TSNs of the new sequence space as received.
+	 */
+	if (asoc->mapping_array != NULL) {
+		memset(asoc->mapping_array, 0, asoc->mapping_array_size);
+	}
+	if (asoc->nr_mapping_array != NULL) {
