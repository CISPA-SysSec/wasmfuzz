+
+/*
+ * Regression test for a division by zero in
+ * sctp_cwnd_update_after_packet_dropped().
+ *
+ * The test plays the peer of a connecting socket over AF_CONN. It answers
+ * the INIT with a HEARTBEAT-ACK whose echoed timestamp is one second old,
+ * which makes the RTO exceed SCTP_SAT_NETWORK_MIN (sat_network), followed by
+ * a PKTDROP chunk from a middle box reporting no bottleneck bandwidth and
+ * less than one MTU on the queue. Without the fix, seg_onqueue is 0 and the
+ * process dies with SIGFPE.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+#include <errno.h>
+#ifndef _WIN32
+#include <sys/time.h>
+#include <arpa/inet.h>
+#endif
+#include <usrsctp.h>
+
+#define LOCAL_PORT 5000
+#define PEER_PORT 5001
+
+#if defined(_MSC_VER)
+#pragma pack(push, 1)
+#define PACKED
+#else
+#define PACKED __attribute__((packed))
+#endif
+
+struct common_header {
+	uint16_t src_port;
+	uint16_t dst_port;
+	uint32_t vtag;
+	uint32_t crc32c;
+} PACKED;
+
+/* struct sctp_heartbeat_chunk, the hb_info is echoed back as it was sent */
+struct heartbeat_ack {
+	uint8_t type;
+	uint8_t flags;
+	uint16_t length;
+	uint16_t param_type;
+	uint16_t param_length;
+	time_t time_value_1;
+	uint32_t time_value_2;
+	uint32_t random_value1;
+	uint32_t random_value2;
+	uint8_t addr_family;
+	uint8_t addr_len;
+	uint8_t padding[2];
+	char address[16];
+} PACKED;
+
+struct pktdrop {
+	uint8_t type;
+	uint8_t flags;
+	uint16_t length;
+	uint32_t bottle_bw;
+	uint32_t current_onq;
+	uint16_t trunc_len;
+	uint16_t reserved;
+} PACKED;
+
+struct packet {
+	struct common_header hdr;
+	struct heartbeat_ack hb;
+	struct pktdrop pd;
+} PACKED;
+
+#if defined(_MSC_VER)
+#pragma pack(pop)
+#endif
+
+static uint32_t peer_vtag;
+
+static int
+conn_output(void *addr, void *buf, size_t length, uint8_t tos, uint8_t set_df)
+{
+	const uint8_t *p = buf;
+
+	/* Remember the initiate tag of our INIT. */
+	if (length >= 20 && p[12] == 0x01) {
+		memcpy(&peer_vtag, p + 16, sizeof(peer_vtag));
+	}
+	return (0);
+}
+
+int
+main(void)
+{
+	struct socket *sock;
+	struct sockaddr_conn sconn;
+	struct packet pkt;
+	struct timeval now;
+	void *conn_addr = (void *)1;
+
+	usrsctp_init_nothreads(0, conn_output, NULL);
+	usrsctp_sysctl_set_sctp_pktdrop_enable(1);
+	usrsctp_register_address(conn_addr);
+
+	if ((sock = usrsctp_socket(AF_CONN, SOCK_STREAM, IPPROTO_SCTP, NULL, NULL, 0, NULL)) == NULL) {
+		perror("usrsctp_socket");
+		return (1);
+	}
+	usrsctp_set_non_blocking(sock, 1);
+	memset(&sconn, 0, sizeof(sconn));
+	sconn.sconn_family = AF_CONN;
+#ifdef HAVE_SCONN_LEN
+	sconn.sconn_len = sizeof(sconn);
+#endif
+	sconn.sconn_port = htons(LOCAL_PORT);
+	sconn.sconn_addr = conn_addr;
+	if (usrsctp_bind(sock, (struct sockaddr *)&sconn, sizeof(sconn)) < 0) {
+		perror("usrsctp_bind");
+		return (1);
+	}
+	sconn.sconn_port = htons(PEER_PORT);
+	if (usrsctp_connect(sock, (struct sockaddr *)&sconn, sizeof(sconn)) < 0 &&
+	    errno != EINPROGRESS) {
+		perror("usrsctp_connect");
+		return (1);
+	}
+	if (peer_vtag == 0) {
+		fprintf(stderr, "no INIT sent\n");
+		return (1);
+	}
+
+	memset(&pkt, 0, sizeof(pkt));
+	pkt.hdr.src_port = htons(PEER_PORT);
+	pkt.hdr.dst_port = htons(LOCAL_PORT);
+	pkt.hdr.vtag = peer_vtag;
+
+	/* A heartbeat sent one second ago: RTO > SCTP_SAT_NETWORK_MIN. */
+	gettimeofday(&now, NULL);
+	pkt.hb.type = 0x05;
+	pkt.hb.length = htons(sizeof(pkt.hb));
+	pkt.hb.param_type = htons(0x0001);
+	pkt.hb.param_length = htons(sizeof(pkt.hb) - 4);
+	pkt.hb.time_value_1 = now.tv_sec - 1;
+	pkt.hb.time_value_2 = (uint32_t)now.tv_usec;
+	pkt.hb.addr_family = AF_CONN;
+	pkt.hb.addr_len = sizeof(struct sockaddr_conn);
+	memcpy(pkt.hb.address, &conn_addr, sizeof(conn_addr));
+
+	/* A middle box reports no bandwidth and less than one MTU queued. */
+	pkt.pd.type = 0x81;
+	pkt.pd.flags = 0x01;	/* SCTP_FROM_MIDDLE_BOX */
+	pkt.pd.length = htons(sizeof(pkt.pd));
+	pkt.pd.bottle_bw = htonl(0);
+	pkt.pd.current_onq = htonl(42);
+
+	pkt.hdr.crc32c = usrsctp_crc32c(&pkt, sizeof(pkt));
+	usrsctp_conninput(conn_addr, &pkt, sizeof(pkt), 0);
+
+	usrsctp_close(sock);
+	while (usrsctp_finish() != 0) {
+		usrsctp_handle_timers(10);
+	}
+	printf("PKTDROP handled\n");
+	return (0);
+}
