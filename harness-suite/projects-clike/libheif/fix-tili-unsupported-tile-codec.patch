+/*
+  libheif regression test: 'tili' image whose tiles use a compression format
+  for which libheif has no image item.
+
+  The tile compression 4cc in 'tilC' comes from the file. For 4ccs that
+  ImageItem::compression_format_from_fourcc_infe_type() does not know (e.g.
+  'avc1'), ImageItem::alloc_for_compression_format() returned nullptr and
+  ImageItem_Tiled::initialize_decoder() dereferenced it. The image must now be
+  rejected with heif_error_Unsupported_feature instead.
+
