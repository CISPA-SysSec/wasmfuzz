diff --git a/libavformat/avidec.c b/libavformat/avidec.c
index 4b48bb1a08..15d297db31 100644
--- a/libavformat/avidec.c
+++ b/libavformat/avidec.c
@@ -1380,6 +1380,10 @@ start_sync:
                     goto start_sync;
                 }
 
+                /* packet_size and remaining are int */
+                if (size > INT_MAX - 8)
+                    continue;
+
                 avi->stream_index = n;
                 ast->packet_size  = size + 8;
                 ast->remaining    = size;
diff --git a/libavformat/tests/avi_chunk_size.c b/libavformat/tests/avi_chunk_size.c
new file mode 100644
index 0000000000..404f490263
--- /dev/null
+++ b/libavformat/tests/avi_chunk_size.c
@@ -0,0 +1,124 @@
+/*
