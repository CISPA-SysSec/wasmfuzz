+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/*
+ * Scale extreme YUV input to packed RGB through a strong user SwsFilter.
+ * The vertical sums then overshoot far beyond 8 bits; the
+ * yuv2rgb lookup tables must not be indexed outside their headroom.
+ * Run under ASan or valgrind to catch out-of-bounds table reads.
+ */
+
+#include <stdio.h>
+
+#include "libavutil/cpu.h"
+#include "libavutil/log.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+#include "libswscale/swscale.h"
+
+static const enum AVPixelFormat dst_fmts[] = {
+    AV_PIX_FMT_RGB4, AV_PIX_FMT_RGB4_BYTE, AV_PIX_FMT_RGB8, AV_PIX_FMT_RGB444,
+    AV_PIX_FMT_RGB555, AV_PIX_FMT_RGB565, AV_PIX_FMT_RGB24, AV_PIX_FMT_BGR24,
+    AV_PIX_FMT_RGB32, AV_PIX_FMT_RGB32_1, AV_PIX_FMT_X2RGB10, AV_PIX_FMT_X2BGR10,
+};
+
+int main(void)
+{
+    const int src_w = 14, src_h = 13, dst_w = 28, dst_h = 29;
+    uint8_t *src[4] = { NULL }, *dst[4] = { NULL };
+    int src_stride[4], dst_stride[4];
+    SwsFilter *filter;
+    int ret = 0;
+
+    /* The vertical X path is plain C; keep SIMD paths out of the way. */
+    av_force_cpu_flags(0);
+    av_log_set_level(AV_LOG_QUIET);
+
+    filter = sws_getDefaultFilter(28.0f, 0.0f, 1.0f, 0.0f, 90.0f, 0.0f, 0);
+    if (!filter)
+        return 1;
+    if (av_image_alloc(src, src_stride, src_w, src_h, AV_PIX_FMT_YUV420P, 32) < 0)
+        return 1;
+
+    /* checkerboards of the extremes give maximal ringing */
+    for (int p = 0; p < 3; p++) {
+        int w = p ? (src_w + 1) / 2 : src_w, h = p ? (src_h + 1) / 2 : src_h;
+        for (int y = 0; y < h; y++)
+            for (int x = 0; x < w; x++)
+                src[p][y * src_stride[p] + x] = ((x ^ y ^ p) & 1) ? 255 : 0;
+    }
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(dst_fmts); i++) {
+        struct SwsContext *sws;
+
+        if (av_image_alloc(dst, dst_stride, dst_w, dst_h, dst_fmts[i], 32) < 0) {
+            ret = 1;
+            break;
+        }
+        sws = sws_getContext(src_w, src_h, AV_PIX_FMT_YUV420P,
+                             dst_w, dst_h, dst_fmts[i], SWS_GAUSS,
+                             filter, NULL, NULL);
+        if (!sws) {
+            fprintf(stderr, "sws_getContext failed for %s\n",
+                    av_get_pix_fmt_name(dst_fmts[i]));
+            ret = 1;
+        } else {
+            sws_scale(sws, (const uint8_t * const *)src, src_stride, 0, src_h,
+                      dst, dst_stride);
+            sws_freeContext(sws);
+        }
+        av_freep(&dst[0]);
+    }
+
+    av_freep(&src[0]);
+    sws_freeFilter(filter);
+    return ret;
+}
