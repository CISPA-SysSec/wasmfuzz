 DEVPROGS = uops_macros_gen                                              \
diff --git a/libswscale/output.c b/libswscale/output.c
index 3e9086a310..e8bd799745 100644
--- a/libswscale/output.c
+++ b/libswscale/output.c
@@ -1841,6 +1841,21 @@ yuv2rgb_X_c_template(SwsInternal *c, const int16_t *lumFilter,
             }
         }
 
+        /* Sharpening or shifting SwsFilters give taps outside [0, 4096], and
+         * the horizontal scaler does not clip negative samples, so the sums
+         * can leave the range the lookup tables are built for. The tables
+         * saturate well inside that range, so clamping does not change the
+         * output of in-range samples. */
+        if ((unsigned)(U  + YUVRGB_TABLE_HEADROOM) >= 256 + 2 * YUVRGB_TABLE_HEADROOM ||
+            (unsigned)(V  + YUVRGB_TABLE_HEADROOM) >= 256 + 2 * YUVRGB_TABLE_HEADROOM ||
+            (unsigned)(Y1 + YUVRGB_TABLE_LUMA_HEADROOM) >= 2 * YUVRGB_TABLE_LUMA_HEADROOM ||
+            (unsigned)(Y2 + YUVRGB_TABLE_LUMA_HEADROOM) >= 2 * YUVRGB_TABLE_LUMA_HEADROOM) {
+            U  = av_clip(U,  -YUVRGB_TABLE_HEADROOM, 255 + YUVRGB_TABLE_HEADROOM);
+            V  = av_clip(V,  -YUVRGB_TABLE_HEADROOM, 255 + YUVRGB_TABLE_HEADROOM);
+            Y1 = av_clip(Y1, -YUVRGB_TABLE_LUMA_HEADROOM, YUVRGB_TABLE_LUMA_HEADROOM - 1);
+            Y2 = av_clip(Y2, -YUVRGB_TABLE_LUMA_HEADROOM, YUVRGB_TABLE_LUMA_HEADROOM - 1);
+        }
+
         r =  c->table_rV[V + YUVRGB_TABLE_HEADROOM];
         g = (c->table_gU[U + YUVRGB_TABLE_HEADROOM] + c->table_gV[V + YUVRGB_TABLE_HEADROOM]);
         b =  c->table_bU[U + YUVRGB_TABLE_HEADROOM];
