+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+
+#include "libavutil/intreadwrite.h"
+#include "libavcodec/jpegxl_parse.h"
+
+/*
+ * A container whose jxlp box declares a 64-bit size close to 2^64: the box end
+ * must not wrap around to a position at or before the box itself (a returned
+ * 0 made the jpegxl parser emit empty frames forever).
+ */
+static const uint8_t huge_jxlp_box[] = {
+    0x00, 0x00, 0x00, 0x0c, 'J',  'X',  'L',  ' ',  0x0d, 0x0a, 0x87, 0x0a,
+    0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x01, 'j',  'x',  'l',  'p',
+    0xbd, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xef,
+    0x00, 0x00, 0x00, 0x00, 0xff, 0x0a, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+int main(void)
+{
+    uint8_t buf[4096];
+    int copied = 0;
+    int ret = ff_jpegxl_collect_codestream_header(huge_jxlp_box, sizeof(huge_jxlp_box),
+                                                  buf, sizeof(buf) - 64, &copied);
+
+    printf("huge jxlp box: ret=%d copied=%d\n", ret, copied);
+    /* the jxlp box starts at offset 21; anything that ends there or earlier is a wrap */
+    if (ret >= 0 && ret <= 21) {
+        fprintf(stderr, "box end %d wrapped around\n", ret);
+        return 1;
+    }
+    return 0;
+}
