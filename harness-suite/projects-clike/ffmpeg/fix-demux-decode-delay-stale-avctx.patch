+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "libavformat/avformat.h"
+#include "libavutil/mem.h"
+
+/*
+ * Two Ogg pages, reduced from a fuzzer input: a Vorbis BOS page with a
+ * comment header carrying a picture, then a page with an OGM video header
+ * for H.264 on a new serial. avformat_find_stream_info() reaches EOF with
+ * codecpar already switched to H.264 while the internal codec context still
+ * holds the previous codec, closed; has_decode_delay_been_guessed() used to
+ * fail av_assert0() on that.
+ */
+static const uint8_t ogg[] = {
+    0x4f, 0x67, 0x67, 0x53, 0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xc1, 0x14,
+    0x78, 0x22, 0x03, 0x06, 0x63, 0x02, 0x01, 0x61, 0x75, 0x64, 0x69, 0x6f,
+    0x03, 0x76, 0x6f, 0x72, 0x62, 0x69, 0x73, 0x00, 0x00, 0x00, 0x00, 0x01,
+    0x00, 0x00, 0x00, 0x4f, 0x00, 0x00, 0x00, 0x4d, 0x45, 0x54, 0x41, 0x44,
+    0x41, 0x54, 0x41, 0x5f, 0x42, 0x4c, 0x4f, 0x43, 0x4b, 0x5f, 0x50, 0x49,
+    0x43, 0x54, 0x55, 0x52, 0x45, 0x3d, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
+    0x41, 0x41, 0x41, 0x41, 0x6c, 0x70, 0x62, 0x57, 0x46, 0x6e, 0x5a, 0x53,
+    0x39, 0x6e, 0x61, 0x57, 0x59, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
+    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
+    0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
+    0x46, 0x45, 0x00, 0x74, 0x74, 0x4f, 0x67, 0x67, 0x53, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x3f, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x10, 0x85, 0x57, 0x1d, 0x01, 0x0d, 0x01, 0x76, 0x69,
+    0x64, 0x65, 0x6f, 0x6f, 0x6f, 0x6f, 0x48, 0x32, 0x36, 0x34,
+};
+
+typedef struct MemIO {
+    const uint8_t *data;
+    int size, pos;
+} MemIO;
+
+static int mem_read(void *opaque, uint8_t *buf, int buf_size)
+{
+    MemIO *m = opaque;
+
+    buf_size = FFMIN(buf_size, m->size - m->pos);
+    if (!buf_size)
+        return AVERROR_EOF;
+    memcpy(buf, m->data + m->pos, buf_size);
+    m->pos += buf_size;
+    return buf_size;
+}
+
+int main(void)
+{
+    MemIO m = { ogg, sizeof(ogg), 0 };
+    AVFormatContext *s = avformat_alloc_context();
+    uint8_t *buf = av_malloc(sizeof(ogg));
+    /* not seekable, so that the demuxer cannot read the file twice */
+    AVIOContext *pb = avio_alloc_context(buf, sizeof(ogg), 0, &m, mem_read, NULL, NULL);
+    AVPacket *pkt = av_packet_alloc();
+    int ret;
+
+    if (!s || !buf || !pb || !pkt) {
+        fprintf(stderr, "allocation failed\n");
+        return 1;
+    }
+    av_log_set_level(AV_LOG_FATAL);
+    s->pb = pb;
+    ret = avformat_open_input(&s, NULL, av_find_input_format("ogg"), NULL);
+    if (ret < 0) {
+        fprintf(stderr, "avformat_open_input() failed: %d\n", ret);
+        return 1;
+    }
+    ret = avformat_find_stream_info(s, NULL);
+    printf("avformat_find_stream_info(): %d, %u streams\n", ret, s->nb_streams);
+    while (av_read_frame(s, pkt) >= 0)
+        av_packet_unref(pkt);
+
+    av_packet_free(&pkt);
+    avformat_close_input(&s);
+    av_freep(&pb->buffer);
+    avio_context_free(&pb);
+    return 0;
+}
