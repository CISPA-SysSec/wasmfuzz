+TESTPROGS-$(CONFIG_OGG_DEMUXER)          += ogg_ogm_h264
 
 TOOLS     = aviocat                                                     \
             ismindex                                                    \
diff --git a/libavformat/demux.c b/libavformat/demux.c
index c593e7b317..8176ffd42d 100644
--- a/libavformat/demux.c
+++ b/libavformat/demux.c
@@ -785,7 +785,12 @@ static int has_decode_delay_been_guessed(AVStream *st)
     if (st->codecpar->codec_id != AV_CODEC_ID_H264) return 1;
     if (!sti->info) // if we have left find_stream_info then nb_decoded_frames won't increase anymore for stream copy
         return 1;
-    av_assert0(sti->avctx->codec_id == AV_CODEC_ID_H264 || (sti->avctx->codec_id == AV_CODEC_ID_NONE && !avcodec_is_open(sti->avctx)));
+    /* The demuxer can switch codecpar to H.264 after the internal context
+     * was set up for another codec (e.g. a new Ogg link with an OGM header);
+     * the context only follows with the next packet. An opened decoder of
+     * another codec tells nothing about the H.264 reorder delay. */
+    if (sti->avctx->codec_id != AV_CODEC_ID_H264 && avcodec_is_open(sti->avctx))
+        return 1;
 #if CONFIG_H264_DECODER
     if (sti->avctx->has_b_frames && avcodec_is_open(sti->avctx) &&
         avpriv_h264_has_num_reorder_frames(sti->avctx) == sti->avctx->has_b_frames)
diff --git a/libavformat/tests/ogg_ogm_h264.c b/libavformat/tests/ogg_ogm_h264.c
new file mode 100644
index 0000000000..db2dd06104
--- /dev/null
+++ b/libavformat/tests/ogg_ogm_h264.c
@@ -0,0 +1,98 @@
+/*
