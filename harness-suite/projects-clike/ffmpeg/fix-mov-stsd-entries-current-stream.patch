+#include <stdio.h>
+#include <string.h>
+
+#include "libavformat/avformat.h"
+#include "libavutil/mem.h"
+
+/*
+ * A HEIF meta box, reduced from a fuzzer input: an item list followed by an
+ * item property container with an stsd box of two entries, associated with
+ * an item through ipma. mov_read_stsd() sizes the per-entry arrays of the
+ * item's stream; ff_mov_read_stsd_entries() must fill and count the entries
+ * of that same stream, or freeing the stream context reads past the arrays
+ * (heap-buffer-overflow, reported under AddressSanitizer or valgrind).
+ */
+static const uint8_t heif[] = {
+    0x00, 0x00, 0x00, 0x10, 0x66, 0x74, 0x79, 0x70, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x6d, 0x65, 0x74, 0x61,
+    0x00, 0x00, 0x00, 0x08, 0x68, 0x64, 0x6c, 0x72, 0x00, 0x00, 0x00, 0x64,
+    0x69, 0x69, 0x6e, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00,
+    0x00, 0x15, 0x69, 0x6e, 0x66, 0x65, 0x02, 0x00, 0x00, 0x00, 0x00, 0x01,
+    0x00, 0x00, 0x68, 0x76, 0x63, 0x31, 0x00, 0x00, 0x00, 0x00, 0x15, 0x69,
+    0x6e, 0x66, 0x65, 0x02, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x68,
+    0x76, 0x63, 0x31, 0x00, 0x00, 0x00, 0x00, 0x16, 0x69, 0x6e, 0x66, 0x65,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x16, 0x69, 0x6e, 0x66, 0x65, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x81, 0x69, 0x70, 0x72, 0x70, 0x00, 0x00, 0x00, 0x61,
+    0x69, 0x70, 0x63, 0x6f, 0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x20, 0x73, 0x74, 0x73, 0x64, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x02, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08, 0x6d, 0x6d, 0x6d,
+    0x72, 0x00, 0x00, 0x00, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x18, 0x69, 0x70, 0x6d, 0x61, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x02, 0x00, 0x01, 0x01, 0x03, 0x00, 0x02, 0x01, 0x03,
+};
+
+typedef struct MemIO {
+    const uint8_t *data;
+    int size, pos;
+} MemIO;
+
+static int mem_read(void *opaque, uint8_t *buf, int buf_size)
+{
+    MemIO *m = opaque;
+
+    buf_size = FFMIN(buf_size, m->size - m->pos);
+    if (!buf_size)
+        return AVERROR_EOF;
+    memcpy(buf, m->data + m->pos, buf_size);
+    m->pos += buf_size;
+    return buf_size;
+}
+
+static int64_t mem_seek(void *opaque, int64_t offset, int whence)
+{
+    MemIO *m = opaque;
+
+    if (whence == AVSEEK_SIZE)
+        return m->size;
+    if (whence == SEEK_CUR)
+        offset += m->pos;
+    else if (whence == SEEK_END)
+        offset += m->size;
+    if (offset < 0 || offset > m->size)
+        return AVERROR(EINVAL);
+    m->pos = offset;
+    return offset;
+}
+
+int main(void)
+{
+    MemIO m = { heif, sizeof(heif), 0 };
+    AVFormatContext *s = avformat_alloc_context();
+    uint8_t *buf = av_malloc(4096);
+    AVIOContext *pb = avio_alloc_context(buf, 4096, 0, &m, mem_read, NULL, mem_seek);
+    AVPacket *pkt = av_packet_alloc();
+    int ret;
+
+    if (!s || !buf || !pb || !pkt) {
+        fprintf(stderr, "allocation failed\n");
+        return 1;
+    }
+    av_log_set_level(AV_LOG_FATAL);
+    s->pb = pb;
+    /* the file is broken, only the cleanup matters */
+    ret = avformat_open_input(&s, NULL, av_find_input_format("mov"), NULL);
+    printf("avformat_open_input(): %d\n", ret);
+    if (ret >= 0) {
+        while (av_read_frame(s, pkt) >= 0)
+            av_packet_unref(pkt);
+        avformat_close_input(&s);
+    }
+
+    av_packet_free(&pkt);
+    av_freep(&pb->buffer);
+    avio_context_free(&pb);
+    return 0;
+}
