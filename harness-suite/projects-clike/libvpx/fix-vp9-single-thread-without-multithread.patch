diff --git a/vp9/vp9_dx_iface.c b/vp9/vp9_dx_iface.c
index bad113595..87fd57112 100644
--- a/vp9/vp9_dx_iface.c
+++ b/vp9/vp9_dx_iface.c
@@ -270,7 +270,16 @@ static vpx_codec_err_t init_decoder(vpx_codec_alg_priv_t *ctx) {
     set_error_detail(ctx, "Failed to allocate decoder");
     return VPX_CODEC_MEM_ERROR;
   }
+#if CONFIG_MULTITHREAD
   ctx->pbi->max_threads = ctx->cfg.threads;
+#else
+  // Without thread support the tile and loop filter workers run one after
+  // another, which breaks the row synchronization the multi-threaded tile,
+  // row-mt and loop filter paths rely on: the loop filter reads tile columns
+  // that are not decoded yet and the row-mt workers wait forever. Decode
+  // single-threaded, as VP8 does.
+  ctx->pbi->max_threads = 1;
+#endif
   ctx->pbi->inv_tile_order = ctx->invert_tile_order;
 
   RANGE_CHECK(ctx, row_mt, 0, 1);
