+
+static unsigned r32le(const uint8_t *const p) {
+    return ((unsigned)p[3] << 24) | (p[2] << 16) | (p[1] << 8) | p[0];
+}
+
+int main(void) {
+    Dav2dSettings settings = { 0 };
+    Dav2dContext *ctx = NULL;
+    const uint8_t *ptr = k_mhccp_422;
+    const size_t size = sizeof(k_mhccp_422);
+    int have_seq_hdr = 0;
+    int err;
+
+    if (size < 32)
+        return 1;
+    ptr += 32;
+
+    dav2d_default_settings(&settings);
+    settings.max_frame_delay = settings.n_threads = 1;
+    if (dav2d_open(&ctx, &settings) < 0)
+        return 1;
+
+    while (ptr <= k_mhccp_422 + size - 12) {
+        Dav2dData buf;
+        uint8_t *p;
+        size_t frame_size = r32le(ptr);
+        ptr += 12;
+
+        if (frame_size > size || ptr > k_mhccp_422 + size - frame_size)
+            break;
+        if (!frame_size)
+            continue;
+
+        if (!have_seq_hdr) {
+            Dav2dSequenceHeader seq;
+            if (dav2d_parse_sequence_header(&seq, ptr, frame_size) != 0) {
+                ptr += frame_size;
+                continue;
+            }
+            have_seq_hdr = 1;
+        }
+
+        p = dav2d_data_create(&buf, frame_size);
+        if (!p)
+            goto cleanup;
+        memcpy(p, ptr, frame_size);
+        ptr += frame_size;
+
+        do {
+            if ((err = dav2d_send_data(ctx, &buf)) < 0) {
+                if (err != DAV2D_ERR(EAGAIN))
+                    break;
+            }
+            for (;;) {
+                Dav2dPicture pic;
+                memset(&pic, 0, sizeof(pic));
+                err = dav2d_get_picture(ctx, &pic);
+                if (err == 0)
+                    dav2d_picture_unref(&pic);
+                else if (err != DAV2D_ERR(EAGAIN))
+                    goto next_frame;
+            }
+        } while (buf.sz > 0);
+
+    next_frame:
+        if (buf.sz > 0)
+            dav2d_data_unref(&buf);
+    }
+
+cleanup:
+    if (ctx)
+        dav2d_close(&ctx);
+    /* Reaching here without abort/SIGSEGV is success; a decode error is OK. */
+    return 0;
+}
