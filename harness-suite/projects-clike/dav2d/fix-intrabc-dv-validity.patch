+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <dav2d/dav2d.h>
+
+/*
+ * Intra frame with allow_intrabc: a 16x8 intrabc block at x=304 resolves to
+ * dv (-15, 0) px, so its source overlaps the block itself (not yet
+ * reconstructed). AVM rejects such dvs (av2_is_dv_valid(): 'Invalid intrabc
+ * dv'); dav2d's dv check was disabled, so the bilinear copy memcpy()ed
+ * between overlapping rows (ASan memcpy-param-overlap in put_c) and other
+ * such dvs read unreconstructed pixels.
+ */
+static const uint8_t k_input0[] = {
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x26, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0c, 0x00, 0x82, 0x0a,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x04, 0x88,
+    0x49, 0x15, 0x93, 0x80, 0x3c, 0x6f, 0xc8, 0x00, 0x0c, 0x3e, 0xd9, 0x03,
+    0xcd, 0x00, 0x5f, 0x19, 0x98, 0x00, 0x00, 0x2d, 0x0d, 0x00, 0x12, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x11, 0x10,
+    0xe0, 0x00, 0x00, 0x1f, 0xff, 0x00, 0x00, 0x61, 0x00, 0x01, 0x61, 0x62,
+    0x80, 0x00, 0x00, 0x0c,
+};
+
+static unsigned r32le(const uint8_t *const p) {
+    return ((unsigned)p[3] << 24) | (p[2] << 16) | (p[1] << 8) | p[0];
+}
+
+/* Decode an IVF stream the way tests/libfuzzer/dav2d_fuzzer.c does. */
+static int decode_ivf(const uint8_t *const data, const size_t size) {
+    Dav2dSettings settings = { 0 };
+    Dav2dContext *ctx = NULL;
+    Dav2dPicture pic;
+    const uint8_t *ptr = data + 32;
+    int have_seq_hdr = 0, err;
+
+    dav2d_default_settings(&settings);
+    settings.max_frame_delay = settings.n_threads = 1;
+    settings.frame_size_limit = 4096 * 4096;
+    if (dav2d_open(&ctx, &settings) < 0)
+        return 1;
+
+    while (ptr <= data + size - 12) {
+        Dav2dData buf;
+        uint8_t *p;
+        const size_t frame_size = r32le(ptr);
+        ptr += 12;
+        if (frame_size > size || ptr > data + size - frame_size)
+            break;
+        if (!frame_size)
+            continue;
+        if (!have_seq_hdr) {
+            Dav2dSequenceHeader seq;
+            if (dav2d_parse_sequence_header(&seq, ptr, frame_size)) {
+                ptr += frame_size;
+                continue;
+            }
+            have_seq_hdr = 1;
+        }
+        if (!(p = dav2d_data_create(&buf, frame_size)))
+            break;
+        memcpy(p, ptr, frame_size);
+        ptr += frame_size;
+        do {
+            if ((err = dav2d_send_data(ctx, &buf)) < 0 && err != DAV2D_ERR(EAGAIN))
+                break;
+            for (;;) {
+                memset(&pic, 0, sizeof(pic));
+                err = dav2d_get_picture(ctx, &pic);
+                if (err == 0)
+                    dav2d_picture_unref(&pic);
+                else if (err == DAV2D_ERR(EAGAIN))
+                    break;
+                else
+                    goto next_frame;
+            }
+        } while (buf.sz > 0);
+    next_frame:
+        if (buf.sz > 0)
+            dav2d_data_unref(&buf);
+    }
+    dav2d_send_data(ctx, NULL);
+    for (int n = 0; n < 64; n++) {
+        memset(&pic, 0, sizeof(pic));
+        if ((err = dav2d_get_picture(ctx, &pic)) == 0)
+            dav2d_picture_unref(&pic);
+        else if (err == DAV2D_EOF)
+            break;
+    }
+    dav2d_close(&ctx);
+    return 0;
+}
+
+int main(void) {
+    /* Reaching the end without a crash is success; decode errors are OK. */
+    if (decode_ivf(k_input0, sizeof(k_input0))) return 1;
+    return 0;
+}
