diff --git a/cpp/tests/poppler-movie-poster-test.cpp b/cpp/tests/poppler-movie-poster-test.cpp
new file mode 100644
index 000000000..ea18abdd7
--- /dev/null
+++ b/cpp/tests/poppler-movie-poster-test.cpp
@@ -0,0 +1,130 @@
+/*
+ * Regression test: the poster appearance that AnnotMovie::draw() builds is
+ * cached in the annotation, so it must not refer to the temporary XRef copy
+ * that Page::displaySlice() makes when copyXRef is set (as
+ * poppler::page_renderer::render_page() does). That copy is freed after the
+ * page is drawn; later users of the appearance (FontInfoScanner via
+ * page::text_list / document::fonts) then fetched the poster through the
+ * freed XRef (heap-use-after-free).
+ */
+
+#include <Annot.h>
+#include <FontInfo.h>
+#include <GlobalParams.h>
+#include <Object.h>
+#include <PDFDoc.h>
+#include <Page.h>
+#include <Stream.h>
+#include <TextOutputDev.h>
+
+#include <cstdio>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <vector>
+
+static std::string build_pdf()
+{
+    const std::vector<std::string> objs = {
+        "<< /Type /Catalog /Pages 2 0 R >>",
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+        "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Resources << >> /Annots [5 0 R] >>",
+        "<< /Type /XObject /Subtype /Form /BBox [0 0 1 1] /Resources << /Font << /F1 6 0 R >> >> /Length 13 >>\nstream\nBT /F1 1 Tf ET\nendstream",
+        "<< /Type /Annot /Subtype /Movie /Rect [10 10 74 58] /T (movie) /Movie << /F (movie.mov) /Aspect [64 48] /Poster 4 0 R >> >>",
+        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
+    };
+    std::string pdf = "%PDF-1.7\n";
+    std::vector<size_t> offsets;
+    for (size_t i = 0; i < objs.size(); ++i) {
+        offsets.push_back(pdf.size());
+        pdf += std::to_string(i + 1) + " 0 obj\n" + objs[i] + "\nendobj\n";
+    }
+    const size_t xrefOffset = pdf.size();
+    pdf += "xref\n0 " + std::to_string(objs.size() + 1) + "\n0000000000 65535 f \n";
+    for (size_t off : offsets) {
+        char line[21];
+        snprintf(line, sizeof(line), "%010zu 00000 n \n", off);
+        pdf += line;
+    }
+    pdf += "trailer\n<< /Size " + std::to_string(objs.size() + 1) + " /Root 1 0 R >>\nstartxref\n" + std::to_string(xrefOffset) + "\n%%EOF\n";
+    return pdf;
+}
+
+// Every dictionary reachable from obj without fetching must use xref.
+static int check_xref(const Object &obj, XRef *xref, const std::string &path)
+{
+    const Dict *dict = nullptr;
+    if (obj.isDict()) {
+        dict = obj.getDict();
+    } else if (obj.isStream()) {
+        dict = obj.getStream()->getDict();
+    } else {
+        return 0;
+    }
+    int failures = 0;
+    if (dict->getXRef() != xref) {
+        std::cerr << "  FAIL: " << path << " uses a different XRef than the document\n";
+        ++failures;
+    }
+    for (int i = 0; i < dict->getLength(); ++i) {
+        failures += check_xref(dict->getValNF(i), xref, path + "/" + dict->getKey(i));
+    }
+    return failures;
+}
+
+int main()
+{
+    GlobalParamsIniter globalParamsIniter(nullptr);
+    globalParams->setErrQuiet(true);
+
+    const std::string pdf = build_pdf();
+    PDFDoc doc(std::make_unique<MemStream>(pdf.data(), 0, pdf.size(), Object::null()));
+    if (!doc.isOk() || doc.getNumPages() != 1) {
+        std::cerr << "failed to load the test document\n";
+        return 1;
+    }
+
+    // Draw the page on a temporary XRef copy, as page_renderer::render_page() does.
+    TextOutputDev out(nullptr, false, 0, false, false);
+    doc.displayPageSlice(&out, 1, 72, 72, 0, false, true, false, -1, -1, -1, -1, nullptr, nullptr, nullptr, nullptr, true);
+
+    int failures = 0;
+    int movies = 0;
+    for (const std::shared_ptr<Annot> &annot : doc.getPage(1)->getAnnots()->getAnnots()) {
+        if (annot->getType() != Annot::typeMovie) {
+            continue;
+        }
+        ++movies;
+        const Object res = annot->getAppearanceResDict();
+        if (!res.isDict()) {
+            std::cerr << "  FAIL: movie annotation has no generated poster appearance\n";
+            ++failures;
+            continue;
+        }
+        failures += check_xref(res, doc.getXRef(), "AP/Resources");
+    }
+    if (movies != 1) {
+        std::cerr << "  FAIL: expected one movie annotation, got " << movies << "\n";
+        ++failures;
+    }
+
+    // The poster's font is only reachable through the generated appearance.
+    FontInfoScanner scanner(&doc, 0);
+    std::vector<FontInfo *> fonts = scanner.scan(1);
+    bool foundHelvetica = false;
+    for (FontInfo *f : fonts) {
+        foundHelvetica |= f->getName() && *f->getName() == "Helvetica";
+        delete f;
+    }
+    if (!foundHelvetica) {
+        std::cerr << "  FAIL: font scan did not find the poster's Helvetica\n";
+        ++failures;
+    }
+
+    if (failures) {
+        std::cerr << failures << " failure(s)\n";
+        return 1;
+    }
+    std::cout << "PASS\n";
+    return 0;
+}
