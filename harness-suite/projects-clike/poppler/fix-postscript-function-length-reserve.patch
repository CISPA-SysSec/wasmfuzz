--- /dev/null
+++ b/cpp/tests/poppler-postscript-length-test.cpp
@@ -0,0 +1,61 @@
+/*
+ * Regression test: PostScriptFunction used the stream dictionary's /Length,
+ * which comes straight from the file, to reserve its code buffers. A bogus
+ * /Length 2147483647 made it reserve 2 GB for the code string and 16 GB for
+ * the parsed code (std::bad_alloc, which ends the process) for a 9-byte
+ * function.
+ */
+
+#include <Array.h>
+#include <Dict.h>
+#include <Function.h>
+#include <GlobalParams.h>
+#include <Object.h>
+#include <Stream.h>
+
+#include <climits>
+#include <iostream>
+#include <memory>
+#include <string>
+
+static Object interval(int lo, int hi)
+{
+    auto a = std::make_unique<Array>(static_cast<XRef *>(nullptr));
+    a->add(Object(lo));
+    a->add(Object(hi));
+    return Object(std::move(a));
+}
+
+int main()
+{
+    GlobalParamsIniter globalParamsIniter(nullptr);
+    globalParams->setErrQuiet(true);
+
+    static const std::string code = "{ 1 add }";
+    auto dict = std::make_unique<Dict>(static_cast<XRef *>(nullptr));
+    dict->add("FunctionType", Object(4));
+    dict->add("Domain", interval(0, 1));
+    dict->add("Range", interval(0, 10));
+    dict->add("Length", Object(INT_MAX));
+    Object funcObj(std::make_unique<MemStream>(code.data(), 0, code.size(), Object(std::move(dict))));
+
+    // before the fix this died of std::bad_alloc (or reserved 2 GB of code string)
+    std::unique_ptr<Function> func = Function::parse(&funcObj);
+    if (!func || !func->isOk() || func->getType() != Function::Type::PostScript) {
+        std::cerr << "  FAIL: the PostScript function did not parse\n";
+        return 1;
+    }
+    const size_t capacity = static_cast<PostScriptFunction *>(func.get())->getCodeString().capacity();
+    if (capacity > 1024 * 1024) {
+        std::cerr << "  FAIL: code string reserved " << capacity << " bytes for a 9-byte function\n";
+        return 1;
+    }
+    double in = 0.5, out = 0;
+    func->transform(&in, &out);
+    if (out != 1.5) {
+        std::cerr << "  FAIL: { 1 add } (0.5) = " << out << "\n";
+        return 1;
+    }
+    std::cout << "PASS\n";
+    return 0;
+}
