--- /dev/null
+++ b/cpp/tests/poppler-predictor-row-test.cpp
@@ -0,0 +1,158 @@
+/*
+ * Regression test: StreamPredictor::getNextLine() read every row into a
+ * temporary array of ints, four times the row size, which /Columns can make
+ * ~256 MB: a 1 GB allocation per row, for a stream of a few bytes. It reads
+ * the row in chunks now. Every operator new larger than 256 MB fails in this
+ * test.
+ */
+
+#include <GlobalParams.h>
+#include <Object.h>
+#include <PDFDoc.h>
+#include <Stream.h>
+#include <XRef.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <vector>
+
+static const size_t allocLimit = 256u << 20;
+
+void *operator new(size_t size)
+{
+    if (size > allocLimit) {
+        fprintf(stderr, "  FAIL: allocation of %zu bytes\n", size);
+        std::_Exit(1);
+    }
+    if (void *p = std::malloc(size ? size : 1)) {
+        return p;
+    }
+    std::abort();
+}
+
+void operator delete(void *p) noexcept
+{
+    std::free(p);
+}
+
+void operator delete(void *p, size_t) noexcept
+{
+    std::free(p);
+}
+
+// zlib stream with one stored block
+static std::string zlib_stored(const std::string &raw)
+{
+    std::string data = "\x78\x01";
+    data += '\x01';
+    data += static_cast<char>(raw.size() & 0xff);
+    data += static_cast<char>(raw.size() >> 8);
+    data += static_cast<char>(~raw.size() & 0xff);
+    data += static_cast<char>((~raw.size() >> 8) & 0xff);
+    return data + raw;
+}
+
+static const int smallColumns = 10000; // rows span several of the chunks the predictor reads
+
+static std::string small_rows()
+{
+    // a PNG "Sub" row, then a PNG "Up" row
+    std::string raw(1, '\x01');
+    for (int i = 0; i < smallColumns; ++i) {
+        raw += static_cast<char>(i % 7 + 1);
+    }
+    raw += '\x02';
+    for (int i = 0; i < smallColumns; ++i) {
+        raw += static_cast<char>(i % 5);
+    }
+    return raw;
+}
+
+static std::string build_pdf()
+{
+    // the PNG "Up" tag byte and 8 bytes of a row that /Columns makes 200000000 bytes long
+    const std::string data = zlib_stored(std::string(1, '\x02') + "\x01\x02\x03\x04\x05\x06\x07\x08");
+    const std::string small = zlib_stored(small_rows());
+
+    const std::vector<std::string> objs = {
+        "<< /Type /Catalog /Pages 2 0 R >>",
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+        "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 10 10] >>",
+        "<< /Length " + std::to_string(data.size()) + " /Filter /FlateDecode /DecodeParms << /Predictor 12 /Columns 200000000 >> >>\nstream\n" + data + "\nendstream",
+        "<< /Length " + std::to_string(small.size()) + " /Filter /FlateDecode /DecodeParms << /Predictor 15 /Columns " + std::to_string(smallColumns) + " >> >>\nstream\n" + small + "\nendstream",
+    };
+    std::string pdf = "%PDF-1.7\n";
+    std::vector<size_t> offsets;
+    for (size_t i = 0; i < objs.size(); ++i) {
+        offsets.push_back(pdf.size());
+        pdf += std::to_string(i + 1) + " 0 obj\n" + objs[i] + "\nendobj\n";
+    }
+    const size_t xrefOffset = pdf.size();
+    pdf += "xref\n0 " + std::to_string(objs.size() + 1) + "\n0000000000 65535 f \n";
+    for (size_t off : offsets) {
+        char entry[32];
+        snprintf(entry, sizeof(entry), "%010zu 00000 n \n", off);
+        pdf += entry;
+    }
+    pdf += "trailer\n<< /Size " + std::to_string(objs.size() + 1) + " /Root 1 0 R >>\nstartxref\n" + std::to_string(xrefOffset) + "\n%%EOF\n";
+    return pdf;
+}
+
+int main()
+{
+    GlobalParamsIniter globalParamsIniter(nullptr);
+    globalParams->setErrQuiet(true);
+
+    const std::string pdf = build_pdf();
+    {
+        PDFDoc doc(std::make_unique<MemStream>(pdf.data(), 0, pdf.size(), Object::null()));
+        if (!doc.isOk()) {
+            std::cerr << "failed to load the test document\n";
+            return 1;
+        }
+        Object obj = doc.getXRef()->fetch(4, 0);
+        if (!obj.isStream() || !obj.getStream()->rewind()) {
+            std::cerr << "  FAIL: test stream not found\n";
+            return 1;
+        }
+        // PNG Up on the zero first row passes the bytes through
+        for (int i = 1; i <= 8; ++i) {
+            const int c = obj.getStream()->getChar();
+            if (c != i) {
+                std::cerr << "  FAIL: byte " << i << " of the row decoded as " << c << "\n";
+                return 1;
+            }
+        }
+
+        Object small = doc.getXRef()->fetch(5, 0);
+        if (!small.isStream() || !small.getStream()->rewind()) {
+            std::cerr << "  FAIL: second test stream not found\n";
+            return 1;
+        }
+        std::vector<unsigned char> prev(smallColumns, 0);
+        unsigned char left = 0;
+        for (int i = 0; i < smallColumns; ++i) {
+            left = static_cast<unsigned char>(left + i % 7 + 1);
+            prev[i] = left;
+        }
+        for (int row = 0; row < 2; ++row) {
+            for (int i = 0; i < smallColumns; ++i) {
+                const int expected = row == 0 ? prev[i] : static_cast<unsigned char>(prev[i] + i % 5);
+                const int c = small.getStream()->getChar();
+                if (c != expected) {
+                    std::cerr << "  FAIL: row " << row << " byte " << i << " decoded as " << c << ", expected " << expected << "\n";
+                    return 1;
+                }
+            }
+        }
+        if (small.getStream()->getChar() != EOF) {
+            std::cerr << "  FAIL: data past the second row\n";
+            return 1;
+        }
+    }
+    std::cout << "PASS\n";
+    return 0;
+}
