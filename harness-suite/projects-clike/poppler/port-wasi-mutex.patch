diff --git a/poppler/PopplerMutex.h b/poppler/PopplerMutex.h
new file mode 100644
index 0000000..692cb70
--- /dev/null
+++ b/poppler/PopplerMutex.h
@@ -0,0 +1,44 @@
+//========================================================================
+//
+// PopplerMutex.h - WASI-compatible mutex stubs for single-threaded builds
+//
+//========================================================================
+
+#ifndef POPPLER_MUTEX_H
+#define POPPLER_MUTEX_H
+
+#include <mutex>
+
+namespace poppler_mutex_detail {
+
+#ifdef __wasi__
+
+class RecursiveMutex
+{
+public:
+    void lock() noexcept {}
+    void unlock() noexcept {}
+    bool try_lock() noexcept { return true; }
+};
+
+class Mutex
+{
+public:
+    void lock() noexcept {}
+    void unlock() noexcept {}
+    bool try_lock() noexcept { return true; }
+};
+
+#else
+
+using RecursiveMutex = std::recursive_mutex;
+using Mutex = std::mutex;
+
+#endif
+
+} // namespace poppler_mutex_detail
+
+using PopplerRecursiveMutex = poppler_mutex_detail::RecursiveMutex;
+using PopplerMutex = poppler_mutex_detail::Mutex;
+
+#endif
