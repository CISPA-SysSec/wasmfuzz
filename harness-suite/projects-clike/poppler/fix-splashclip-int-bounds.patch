+namespace {
+// splashFloor/splashCeil of a value outside the int range is undefined (and in practice gives
+// INT_MIN, which the "- 1" of the max bounds then wraps to INT_MAX, turning an empty clip into
+// an unbounded one), so clamp coordinates into a range where the integer bounds cannot overflow
+double clampCoord(double v)
+{
+    if (!(v > INT_MIN + 1.0)) {
+        return INT_MIN + 1.0;
+    }
+    if (!(v < INT_MAX)) {
+        return INT_MAX;
+    }
+    return v;
+}
+}
