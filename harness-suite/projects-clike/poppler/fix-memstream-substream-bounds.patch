index 00000000..18482a4b
--- /dev/null
+++ b/cpp/tests/poppler-memstream-substream-test.cpp
@@ -0,0 +1,59 @@
+/*
+ * Regression test: BaseMemStream::makeSubStream() stored an unchecked start
+ * offset, so a substream for an offset outside the buffer pointed outside it.
+ * A bogus startxref such as 4294967295 makes XRef do exactly that; on 32-bit
+ * hosts buf + 4294967295 wraps to buf - 1, and the xref parser then read the
+ * byte before the buffer and reparsed the file from there forever. Start
+ * offsets outside the buffer now give an empty stream.
+ *
+ * The test puts a marker byte in front of the stream's buffer, so reading
+ * before the buffer is caught without memory errors. On 64-bit hosts the
+ * wrapped pointer of a 32-bit host is reproduced by a start offset of -1.
+ */
+
+#include <Object.h>
+#include <Stream.h>
+
+#include <iostream>
+#include <memory>
+#include <string>
+
+static int check(BaseStream &str, Goffset start, bool limited, Goffset length)
+{
+    std::unique_ptr<Stream> sub = str.makeSubStream(start, limited, length, Object::null());
+    if (!sub->rewind()) {
+        return 0;
+    }
+    const int c = sub->getChar();
+    if (c != EOF) {
+        std::cerr << "  FAIL: substream at " << start << (limited ? " (limited)" : "") << " reads 0x" << std::hex << c << std::dec << "\n";
+        return 1;
+    }
+    return 0;
+}
+
+int main()
+{
+    // the marker byte 'X' lies in front of the stream's buffer "abc"
+    static const char data[] = "Xabc";
+    MemStream str(data + 1, 0, 3, Object::null());
+
+    int failures = 0;
+    failures += check(str, -1, false, 0);
+    failures += check(str, -1, true, 2);
+    failures += check(str, 4, false, 0);
+    failures += check(str, 4294967295LL, false, 0);
+
+    // offsets inside the buffer still work
+    std::unique_ptr<Stream> sub = str.makeSubStream(1, true, 1, Object::null());
+    if (!sub->rewind() || sub->getChar() != 'b' || sub->getChar() != EOF) {
+        std::cerr << "  FAIL: substream at 1 (limited to 1 byte) is not \"b\"\n";
+        ++failures;
+    }
+
+    if (failures) {
+        return 1;
+    }
+    std::cout << "PASS\n";
+    return 0;
+}
