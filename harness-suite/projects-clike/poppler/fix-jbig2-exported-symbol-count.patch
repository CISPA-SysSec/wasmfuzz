@@ -0,0 +1,80 @@
+/*
+ * Regression test: a JBIG2 symbol dictionary exports a subset of its input
+ * and new symbols, but readSymbolDictSeg() sized the exported symbol table
+ * with SDNUMEXSYMS from the stream before checking it against them. A
+ * dictionary without any symbols that claims 0xffffffff exported symbols
+ * allocated a table of 2^32 - 1 bitmap pointers.
+ * Every operator new larger than 256 MB fails in this test.
+ */
+
+#include <GlobalParams.h>
+#include <JBIG2Stream.h>
+#include <Object.h>
+#include <Stream.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <string>
+
+static const size_t allocLimit = 256u << 20;
+
+void *operator new(size_t size)
+{
+    if (size > allocLimit) {
+        fprintf(stderr, "  FAIL: allocation of %zu bytes\n", size);
+        std::_Exit(1);
+    }
+    if (void *p = std::malloc(size ? size : 1)) {
+        return p;
+    }
+    std::abort();
+}
+
+void operator delete(void *p) noexcept
+{
+    std::free(p);
+}
+
+void operator delete(void *p, size_t) noexcept
+{
+    std::free(p);
+}
+
+static void put32(std::string &s, unsigned int v)
+{
+    for (int shift = 24; shift >= 0; shift -= 8) {
+        s += static_cast<char>((v >> shift) & 0xff);
+    }
+}
+
+// embedded JBIG2 stream (no file header): a Huffman-coded symbol dictionary
+// with no input and no new symbols that exports 0xffffffff symbols
+static std::string build_jbig2()
+{
+    std::string s;
+    put32(s, 0); // segment number
+    s += '\x00'; // segment type: symbol dictionary
+    s += '\x00'; // no referred-to segments
+    s += '\x01'; // page 1
+    put32(s, 10); // data length
+    s += '\x00';
+    s += '\x01'; // flags: SDHUFF
+    put32(s, 0xffffffff); // SDNUMEXSYMS
+    put32(s, 0); // SDNUMNEWSYMS
+    return s;
+}
+
+int main()
+{
+    GlobalParamsIniter globalParamsIniter(nullptr);
+    globalParams->setErrQuiet(true);
+
+    static const std::string data = build_jbig2();
+    JBIG2Stream str(std::make_unique<MemStream>(data.data(), 0, data.size(), Object::null()), Object::null(), nullptr);
+    (void)str.rewind(); // decodes the segments; failing is fine
+    while (str.getChar() != EOF) { }
+    std::cout << "PASS\n";
+    return 0;
+}
