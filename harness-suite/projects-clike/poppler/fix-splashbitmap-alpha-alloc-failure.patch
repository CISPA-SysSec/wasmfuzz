--- /dev/null
+++ b/cpp/tests/poppler-splashbitmap-alpha-test.cpp
@@ -0,0 +1,30 @@
+/*
+ * Regression test: when SplashBitmap gets its colour data but not the alpha
+ * channel it was asked for, it must report failure through getDataPtr().
+ * Callers such as Splash::scaleImage() only check getDataPtr() and then write
+ * the alpha channel through the null getAlphaPtr().
+ *
+ * A 65536 x 32768 mono bitmap needs 256 MB of colour data, but its alpha
+ * channel (one byte per pixel) overflows the int allocation size, so the
+ * second allocation fails deterministically without touching memory.
+ */
+
+#include <splash/SplashBitmap.h>
+
+#include <iostream>
+
+int main()
+{
+    SplashBitmap bitmap(65536, 32768, 1, splashModeMono1, true);
+    if (bitmap.getDataPtr() != nullptr && bitmap.getAlphaPtr() == nullptr) {
+        std::cerr << "  FAIL: bitmap with colour data but without the requested alpha channel\n";
+        return 1;
+    }
+    SplashBitmap small(16, 16, 1, splashModeRGB8, true);
+    if (small.getDataPtr() == nullptr || small.getAlphaPtr() == nullptr) {
+        std::cerr << "  FAIL: small bitmap with alpha could not be allocated\n";
+        return 1;
+    }
+    std::cout << "PASS\n";
+    return 0;
+}
