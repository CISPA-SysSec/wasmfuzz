diff --git a/splash/SplashMath.h b/splash/SplashMath.h
index 9d60c4119..f641a842b 100644
--- a/splash/SplashMath.h
+++ b/splash/SplashMath.h
@@ -25,6 +25,7 @@
 
 #include "poppler-config.h"
 
+#include <climits>
 #include <cmath>
 #include "SplashTypes.h"
 
@@ -72,10 +73,12 @@ static inline int splashFloor(double x)
     __asm fldcw WORD PTR oldCW;
     return result;
 #else
+    // saturate instead of an undefined out-of-range conversion (NaN -> INT_MIN)
     if (x > 0) {
-        return static_cast<int>(x);
+        return x < static_cast<double>(INT_MAX) ? static_cast<int>(x) : INT_MAX;
     }
-    return static_cast<int>(floor(x));
+    const double f = floor(x);
+    return f > static_cast<double>(INT_MIN) ? static_cast<int>(f) : INT_MIN;
 
 #endif
 }
@@ -119,7 +122,12 @@ static inline int splashCeil(double x)
     __asm fldcw WORD PTR oldCW;
     return result;
 #else
-    return static_cast<int>(ceil(x));
+    // saturate instead of an undefined out-of-range conversion (NaN -> INT_MIN)
+    const double c = ceil(x);
+    if (c >= static_cast<double>(INT_MAX)) {
+        return INT_MAX;
+    }
+    return c > static_cast<double>(INT_MIN) ? static_cast<int>(c) : INT_MIN;
 #endif
 }
 
