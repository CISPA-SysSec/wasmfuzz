+ * ANY SPECIAL, INCIDENTAL, INDIRECT OR CONSEQUENTIAL DAMAGES OF ANY KIND,
+ * OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS,
+ * WHETHER OR NOT ADVISED OF THE POSSIBILITY OF DAMAGE, AND ON ANY THEORY OF
+ * LIABILITY, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE
+ * OF THIS SOFTWARE.
+ */
+
+/*
+ * TIFF Library
+ *
+ * TIFFReadScanline() of a non-native byte order YCbCr image with 1x4
+ * subsampling. TIFFScanlineSize() divides the size of a row of sampling
+ * blocks by the vertical subsampling, so with an odd width the scanline
+ * size is not a multiple of the sample size, and the byte swapping
+ * post-decode routines (_TIFFSwab16BitData() etc.) failed their assertion
+ * on it. Cf https://gitlab.com/libtiff/libtiff/-/issues/669
+ */
+
+#include "tif_config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef HAVE_UNISTD_H
+#include <unistd.h>
+#endif
+
+#include "tiffio.h"
+
+#define FILENAME "test_swab_odd_size.tif"
+
+static int test(const char *mode, uint16_t bitspersample)
+{
+    const uint32_t width = 1, height = 4;
+    TIFF *tif;
+    tmsize_t size;
+    unsigned char *buf;
+    uint32_t row;
+
+    tif = TIFFOpen(FILENAME, mode);
+    if (!tif)
+    {
+        fprintf(stderr, "Cannot create %s\n", FILENAME);
+        return 1;
+    }
+    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, width);
+    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, height);
+    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, bitspersample);
+    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 3);
+    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_YCBCR);
+    TIFFSetField(tif, TIFFTAG_YCBCRSUBSAMPLING, 1, 4);
+    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
+    TIFFSetField(tif, TIFFTAG_COMPRESSION, COMPRESSION_NONE);
+    TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, height);
+    size = TIFFStripSize(tif);
+    buf = (unsigned char *)calloc(1, (size_t)size);
+    if (!buf || TIFFWriteEncodedStrip(tif, 0, buf, size) != size)
+    {
+        fprintf(stderr, "Cannot write %s (mode %s, %u bits)\n", FILENAME,
+                mode, bitspersample);
+        free(buf);
+        TIFFClose(tif);
+        return 1;
+    }
+    free(buf);
+    TIFFClose(tif);
+
+    tif = TIFFOpen(FILENAME, "r");
+    if (!tif)
+    {
+        fprintf(stderr, "Cannot open %s\n", FILENAME);
+        return 1;
+    }
+    size = TIFFScanlineSize(tif);
+    buf = (unsigned char *)malloc((size_t)size);
+    if (!buf)
+    {
+        TIFFClose(tif);
+        return 1;
+    }
+    /* Reading may fail or succeed, but must not abort. */
+    for (row = 0; row < height; row++)
+        (void)TIFFReadScanline(tif, buf, row, 0);
+    free(buf);
+    TIFFClose(tif);
+    unlink(FILENAME);
+    return 0;
+}
+
+int main(void)
+{
+    static const uint16_t bits[] = {16, 24, 32, 64};
+    size_t i;
+    int ret = 0;
+
+    for (i = 0; i < sizeof(bits) / sizeof(bits[0]); i++)
+    {
+        /* One of the two is the non-native byte order. */
+        ret |= test("wb", bits[i]);
+        ret |= test("wl", bits[i]);
+    }
+    return ret;
+}
