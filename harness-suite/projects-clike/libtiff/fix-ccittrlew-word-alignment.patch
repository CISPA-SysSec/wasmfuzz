diff --git a/test/test_ccitt_rlew.c b/test/test_ccitt_rlew.c
new file mode 100644
index 00000000..1e054f04
--- /dev/null
+++ b/test/test_ccitt_rlew.c
@@ -0,0 +1,186 @@
+/*
