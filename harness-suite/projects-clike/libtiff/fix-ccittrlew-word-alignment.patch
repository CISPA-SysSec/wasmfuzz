+ * EXPRESS, IMPLIED OR OTHERWISE, INCLUDING WITHOUT LIMITATION, ANY
+ * WARRANTY OF MERCHANTABILITY OR FITNESS FOR A PARTICULAR PURPOSE.
+ *
+ * IN NO EVENT SHALL SAM LEFFLER OR SILICON GRAPHICS BE LIABLE FOR
+ * ANY SPECIAL, INCIDENTAL, INDIRECT OR CONSEQUENTIAL DAMAGES OF ANY KIND,
+ * OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS,
+ * WHETHER OR NOT ADVISED OF THE POSSIBILITY OF DAMAGE, AND ON ANY THEORY OF
+ * LIABILITY, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE
+ * OF THIS SOFTWARE.
+ */
+
+/*
+ * TIFF Library
+ *
+ * Write/read round trip of the CCITT modified Huffman RLE codecs
+ * (COMPRESSION_CCITTRLE and the 16-bit word aligned COMPRESSION_CCITTRLEW).
+ * Fax3DecodeRLE() used to compute the 16-bit row alignment of
+ * COMPRESSION_CCITTRLEW from the bits left in its bit accumulator only, and
+ * so lost sync when a row ended with a whole byte still buffered.
+ */
+
+#include "tif_config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef HAVE_UNISTD_H
+#include <unistd.h>
+#endif
+
+#include "tiffio.h"
+
+#define FILENAME "test_ccitt_rlew.tif"
+
+static uint32_t rng_state = 1;
+
+static uint32_t rng(void)
+{
+    rng_state = rng_state * 1103515245U + 12345U;
+    return (rng_state >> 16) & 0x7fff;
+}
+
+static void fill_row(unsigned char *buf, tmsize_t size, int pattern)
+{
+    tmsize_t i;
+    for (i = 0; i < size; i++)
+    {
+        switch (pattern)
+        {
+            case 0:
+                buf[i] = 0;
+                break;
+            case 1:
+                buf[i] = (unsigned char)((rng() % 4 == 0) ? rng() : 0);
+                break;
+            default:
+                buf[i] = (unsigned char)rng();
+                break;
+        }
+    }
+}
+
+static int test(uint16_t compression, uint32_t width, uint32_t height,
+                uint32_t rowsperstrip, const char *readmode)
+{
+    TIFF *tif;
+    tmsize_t scanline_size;
+    unsigned char *ref;
+    unsigned char *buf;
+    uint32_t row;
+    int ret = 0;
+
+    tif = TIFFOpen(FILENAME, "w");
+    if (!tif)
+    {
+        fprintf(stderr, "Cannot create %s\n", FILENAME);
+        return 1;
+    }
+    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, width);
+    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, height);
+    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, 1);
+    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 1);
+    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_MINISWHITE);
+    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
+    TIFFSetField(tif, TIFFTAG_COMPRESSION, compression);
+    TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, rowsperstrip);
+
+    scanline_size = TIFFScanlineSize(tif);
+    ref = (unsigned char *)malloc((size_t)scanline_size * height);
+    buf = (unsigned char *)malloc((size_t)scanline_size);
+    if (!ref || !buf)
+    {
+        fprintf(stderr, "Out of memory\n");
+        free(ref);
+        free(buf);
+        TIFFClose(tif);
+        return 1;
+    }
+    for (row = 0; row < height; row++)
+    {
+        unsigned char *line = ref + (size_t)row * scanline_size;
+        fill_row(line, scanline_size, (int)(row % 3));
+        /* Pixels beyond the image width are not encoded */
+        if (width % 8)
+            line[scanline_size - 1] &= (unsigned char)(0xff << (8 - width % 8));
+        memcpy(buf, line, (size_t)scanline_size);
+        if (TIFFWriteScanline(tif, buf, row, 0) < 0)
+        {
+            fprintf(stderr, "TIFFWriteScanline() failed at row %u\n", row);
+            ret = 1;
+            break;
+        }
+    }
+    TIFFClose(tif);
+
+    if (ret == 0)
+    {
+        tif = TIFFOpen(FILENAME, readmode);
+        if (!tif)
+        {
+            fprintf(stderr, "Cannot open %s\n", FILENAME);
+            ret = 1;
+        }
+        else
+        {
+            for (row = 0; row < height; row++)
+            {
+                if (TIFFReadScanline(tif, buf, row, 0) < 0 ||
+                    memcmp(buf, ref + (size_t)row * scanline_size,
+                           (size_t)scanline_size) != 0)
+                {
+                    fprintf(stderr,
+                            "compression=%u width=%u height=%u "
+                            "rowsperstrip=%u mode=%s: row %u differs\n",
+                            compression, width, height, rowsperstrip,
+                            readmode, row);
+                    ret = 1;
+                    break;
+                }
+            }
+            TIFFClose(tif);
+        }
+    }
+
+    free(ref);
+    free(buf);
+    unlink(FILENAME);
+    return ret;
+}
+
+int main(void)
+{
+    static const uint16_t compressions[] = {COMPRESSION_CCITTRLE,
+                                            COMPRESSION_CCITTRLEW};
+    static const uint32_t widths[] = {1,  7,  8,  9,   15,
+                                      16, 17, 31, 64, 100, 1728};
+    static const char *const readmodes[] = {"r", "rm"};
+    size_t i, j, k;
+    int ret = 0;
+
+    for (i = 0; i < sizeof(compressions) / sizeof(compressions[0]); i++)
+    {
+        if (!TIFFIsCODECConfigured(compressions[i]))
+            continue;
+        for (j = 0; j < sizeof(widths) / sizeof(widths[0]); j++)
+        {
+            for (k = 0; k < sizeof(readmodes) / sizeof(readmodes[0]); k++)
+            {
+                ret |= test(compressions[i], widths[j], 50, 50, readmodes[k]);
+                ret |= test(compressions[i], widths[j], 50, 7, readmodes[k]);
+            }
+        }
+    }
+    return ret;
+}
