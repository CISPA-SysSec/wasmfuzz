+// The JXL decoder marks the ICC as primary but leaves it empty if the ICC
+// profile in the codestream has an unknown color space.
+TEST(CodecTest, ConvertEmptyPrimaryICC) {
+  const char* pgm = "P5\n1 1\n255\n\x80";
+  PackedPixelFile ppf;
+  ASSERT_TRUE(DecodeBytes(MakeSpan(pgm), ColorHints(), &ppf));
+  ppf.primary_color_representation = PackedPixelFile::kIccIsPrimary;
+  ppf.icc.clear();
+  auto io = jxl::make_unique<CodecInOut>(jxl::test::MemoryManager());
+  ASSERT_TRUE(ConvertPackedPixelFileToCodecInOut(ppf, nullptr, io.get()));
+  EXPECT_TRUE(io->metadata.m.color_encoding.IsGray());
+  EXPECT_FALSE(io->metadata.m.color_encoding.WantICC());
+}
