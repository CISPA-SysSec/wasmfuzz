+// A failed allocation in PrepareForThreads must not leave the input buffers of
+// a thread partially allocated: the next call skipped them, and the decoder
+// then wrote group data into empty planes.
+TEST(RenderPipelineTest, PrepareForThreadsAfterFailedAllocation) {
+  struct FailingAllocator {
+    size_t num_allocs = 0;
+    size_t fail_at = 0;  // 0: never fail.
+  };
+  constexpr size_t kNumThreads = 2;
+  constexpr size_t kNumChannels = 3;
+  for (size_t fail_at = 1;; ++fail_at) {
+    FailingAllocator state;
+    JxlMemoryManager memory_manager;
+    memory_manager.opaque = &state;
+    memory_manager.alloc = [](void* opaque, size_t size) -> void* {
+      auto* s = static_cast<FailingAllocator*>(opaque);
+      if (s->fail_at != 0 && ++s->num_allocs == s->fail_at) return nullptr;
+      return malloc(size);
+    };
+    memory_manager.free = [](void* opaque, void* address) { free(address); };
+    RenderPipeline::Builder builder(&memory_manager, kNumChannels);
+    ASSERT_TRUE(builder.AddStage(jxl::make_unique<Check0FinalStage>()));
+    FrameDimensions frame_dimensions;
+    frame_dimensions.Set(/*xsize_px=*/256, /*ysize_px=*/256,
+                         /*group_size_shift=*/0,
+                         /*max_hshift=*/0, /*max_vshift=*/0,
+                         /*modular_mode=*/false, /*upsampling=*/1);
+    JXL_TEST_ASSIGN_OR_DIE(auto pipeline,
+                           std::move(builder).Finalize(frame_dimensions));
+    state.fail_at = fail_at;
+    bool prepared = static_cast<bool>(
+        pipeline->PrepareForThreads(kNumThreads, /*use_group_ids=*/false));
+    state.fail_at = 0;
+    // Stop once PrepareForThreads makes fewer than `fail_at` allocations.
+    if (prepared) break;
+    ASSERT_TRUE(
+        pipeline->PrepareForThreads(kNumThreads, /*use_group_ids=*/false));
+    for (size_t t = 0; t < kNumThreads; t++) {
+      auto input_buffers = pipeline->GetInputBuffers(0, t);
+      for (size_t c = 0; c < kNumChannels; c++) {
+        const auto& buffer = input_buffers.GetBuffer(c);
+        EXPECT_LE(buffer.second.x1(), buffer.first->xsize())
+            << "fail_at " << fail_at << " thread " << t << " channel " << c;
+        EXPECT_LE(buffer.second.y1(), buffer.first->ysize())
+            << "fail_at " << fail_at << " thread " << t << " channel " << c;
+      }
+    }
+  }
+}
+
 TEST(RenderPipelineTest, BuildFast) {
   JxlMemoryManager* memory_manager = jxl::test::MemoryManager();
   RenderPipeline::Builder builder(memory_manager, /*num_c=*/1);
