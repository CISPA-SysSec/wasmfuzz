Subject: [PATCH] decode: Skip a jbrd box that comes after the first frame header

The JPEG reconstruction data is attached to the frame when its header is
decoded. A jbrd box that only follows the first frame header (for example
between two jxlp boxes) was still parsed, so the decoder emitted
JXL_DEC_JPEG_RECONSTRUCTION and accepted a JPEG buffer, but then decoded
pixels and returned JXL_DEC_FULL_IMAGE without writing any JPEG bytes. Skip
such a box like an unknown one; the image is decoded to pixels as before.

Found with djxl_fuzzer ("JXL_DEC_FULL_IMAGE" during JPEG reconstruction).
Test: DecodeTest.JPEGReconstructionLateBoxTest.

diff --git a/lib/jxl/decode.cc b/lib/jxl/decode.cc
index 6b911285..2951f992 100644
--- a/lib/jxl/decode.cc
+++ b/lib/jxl/decode.cc
@@ -1919,7 +1919,15 @@ static JxlDecoderStatus HandleBoxes(JxlDecoder* dec) {
           return JXL_INPUT_ERROR(
               "multiple JPEG reconstruction boxes not supported");
         }
-        dec->box_stage = BoxStage::kJpegRecon;
+        if (dec->internal_frames > 0) {
+          // The reconstruction data is attached to the first frame when its
+          // header is decoded. After that, it can no longer be used and the
+          // frame is decoded to pixels: skip the box instead of announcing a
+          // JPEG reconstruction that will not happen.
+          dec->box_stage = BoxStage::kSkip;
+        } else {
+          dec->box_stage = BoxStage::kJpegRecon;
+        }
 #endif
       } else {
         dec->box_stage = BoxStage::kSkip;
diff --git a/lib/jxl/decode_test.cc b/lib/jxl/decode_test.cc
index 1e6f1dea..8d87a7dc 100644
--- a/lib/jxl/decode_test.cc
+++ b/lib/jxl/decode_test.cc
@@ -5247,6 +5247,93 @@ JXL_TRANSCODE_JPEG_TEST(DecodeTest, JPEGReconstructionTest) {
   VerifyJPEGReconstruction(jxl::Bytes(container), jxl::Bytes(orig));
 }
 
+// A jbrd box that comes after the first frame header can no longer be used:
+// the frame is decoded to pixels, so the decoder must not announce a JPEG
+// reconstruction (found by djxl_fuzzer).
+JXL_TRANSCODE_JPEG_TEST(DecodeTest, JPEGReconstructionLateBoxTest) {
+  JxlMemoryManager* memory_manager = jxl::test::MemoryManager();
+  const std::string jpeg_path = "jxl/flower/flower.png.im_q85_420.jpg";
+  const std::vector<uint8_t> orig = jxl::test::ReadTestData(jpeg_path);
+  auto orig_io = jxl::make_unique<jxl::CodecInOut>(memory_manager);
+  JXL_TEST_ASSIGN_OR_DIE(std::unique_ptr<jxl::jpeg::JPEGData> jpeg_data,
+                         jxl::jpeg::ParseJPG(memory_manager, jxl::Bytes(orig)));
+  ASSERT_TRUE(
+      jxl::test::JpegDataToCodecInOut(std::move(jpeg_data), orig_io.get()));
+  jxl::jpeg::JPEGData jpeg_data_copy = *orig_io->Main().jpeg_data;
+  orig_io->metadata.m.xyb_encoded = false;
+  jxl::BitWriter writer{memory_manager};
+  ASSERT_TRUE(WriteCodestreamHeaders(&orig_io->metadata, &writer, nullptr));
+  writer.ZeroPadToByte();
+  jxl::CompressParams cparams;
+  cparams.color_transform = jxl::ColorTransform::kNone;
+  ASSERT_TRUE(jxl::EncodeFrame(memory_manager, cparams, jxl::FrameInfo{},
+                               &orig_io->metadata, orig_io->Main(),
+                               *JxlGetDefaultCms(),
+                               /*pool=*/nullptr, &writer,
+                               /*aux_out=*/nullptr));
+  std::vector<uint8_t> encoded_jpeg_data;
+  ASSERT_TRUE(EncodeJPEGData(memory_manager, jpeg_data_copy, &encoded_jpeg_data,
+                             cparams));
+  jxl::PaddedBytes padded = std::move(writer).TakeBytes();
+  std::vector<uint8_t> codestream(padded.data(), padded.data() + padded.size());
+
+  // Split the codestream after the TOC of the first frame and put the jbrd
+  // box between the two parts.
+  StreamPositions streampos;
+  AnalyzeCodestream(codestream, &streampos);
+  ASSERT_EQ(1u, streampos.frames.size());
+  const size_t split = streampos.frames[0].toc_end;
+  ASSERT_LT(split, codestream.size());
+  std::vector<uint8_t> container = jxl::MakeContainerHeader(0);
+  jxl::AppendBoxHeader(jxl::MakeBoxType("jxlp"), split + 4, false, &container);
+  AppendU32BE(0, &container);
+  container.insert(container.end(), codestream.begin(),
+                   codestream.begin() + split);
+  jxl::AppendBoxHeader(jxl::MakeBoxType("jbrd"), encoded_jpeg_data.size(),
+                       false, &container);
+  jxl::Bytes(encoded_jpeg_data).AppendTo(container);
+  jxl::AppendBoxHeader(jxl::MakeBoxType("jxlp"), 0, true, &container);
+  AppendU32BE(0x80000001, &container);
+  container.insert(container.end(), codestream.begin() + split,
+                   codestream.end());
+
+  JxlPixelFormat format = {3, JXL_TYPE_UINT8, JXL_LITTLE_ENDIAN, 0};
+  const auto decode = [&](const std::vector<uint8_t>& data,
+                          std::vector<uint8_t>* pixels) {
+    JxlDecoderPtr dec = JxlDecoderMake(nullptr);
+    ASSERT_EQ(JXL_DEC_SUCCESS,
+              JxlDecoderSubscribeEvents(
+                  dec.get(), JXL_DEC_JPEG_RECONSTRUCTION | JXL_DEC_FULL_IMAGE));
+    ASSERT_EQ(JXL_DEC_SUCCESS,
+              JxlDecoderSetInput(dec.get(), data.data(), data.size()));
+    JxlDecoderCloseInput(dec.get());
+    for (;;) {
+      JxlDecoderStatus status = JxlDecoderProcessInput(dec.get());
+      ASSERT_NE(JXL_DEC_JPEG_RECONSTRUCTION, status);
+      if (status == JXL_DEC_NEED_IMAGE_OUT_BUFFER) {
+        size_t buffer_size;
+        ASSERT_EQ(JXL_DEC_SUCCESS, JxlDecoderImageOutBufferSize(
+                                       dec.get(), &format, &buffer_size));
+        pixels->resize(buffer_size);
+        ASSERT_EQ(JXL_DEC_SUCCESS,
+                  JxlDecoderSetImageOutBuffer(dec.get(), &format,
+                                              pixels->data(), pixels->size()));
+      } else if (status == JXL_DEC_FULL_IMAGE) {
+        continue;
+      } else {
+        ASSERT_EQ(JXL_DEC_SUCCESS, status);
+        break;
+      }
+    }
+  };
+  std::vector<uint8_t> expected;
+  ASSERT_NO_FATAL_FAILURE(decode(codestream, &expected));
+  std::vector<uint8_t> pixels;
+  ASSERT_NO_FATAL_FAILURE(decode(container, &pixels));
+  ASSERT_FALSE(expected.empty());
+  EXPECT_EQ(expected, pixels);
+}
+
 JXL_TRANSCODE_JPEG_TEST(DecodeTest, JPEGReconstructionMetadataTest) {
   const std::string jpeg_path = "jxl/jpeg_reconstruction/1x1_exif_xmp.jpg";
   const std::string jxl_path = "jxl/jpeg_reconstruction/1x1_exif_xmp.jxl";
