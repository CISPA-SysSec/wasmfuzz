 }
 
-inline std::string_view StrictSubstr(std::string_view data, size_t off,
-                                     size_t n) {
+// Offsets and sizes come from 64-bit file fields: take them as uint64_t so
+// that a 32-bit size_t cannot truncate them before the bounds check.
+inline std::string_view StrictSubstr(std::string_view data, uint64_t off,
+                                     uint64_t n) {
   uint64_t end = CheckedAdd(off, n);
   if (end > data.size()) {
     THROW("region out-of-bounds");
   }
-  return data.substr(off, n);
+  return data.substr(static_cast<size_t>(off), static_cast<size_t>(n));
 }
 
-inline std::string_view StrictSubstr(std::string_view data, size_t off) {
+inline std::string_view StrictSubstr(std::string_view data, uint64_t off) {
   if (off > data.size()) {
     THROW("region out-of-bounds");
   }
-  return data.substr(off);
+  return data.substr(static_cast<size_t>(off));
 }
 
