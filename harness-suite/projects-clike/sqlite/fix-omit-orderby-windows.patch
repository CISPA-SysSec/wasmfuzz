diff --git a/test/omitorderby1.sql b/test/omitorderby1.sql
new file mode 100644
index 0000000..8c78619
--- /dev/null
+++ b/test/omitorderby1.sql
@@ -0,0 +1,81 @@
+#!sqlite3
+#
+# 2026-11-23
+#
+# The author disclaims copyright to this source code.  In place of
+# a legal notice, here is a blessing:
+#
+#    May you do good and not evil.
+#    May you find forgiveness for yourself and forgive others.
+#    May you share freely, never taking more than you give.
+#
+
+#***********************************************************************
+#
+# A superfluous ORDER BY clause, on an EXISTS subquery or on a FROM-clause
+# subquery, is removed by sqlite3Select() but freed only at the end of the
+# parse.  Window functions in that ORDER BY must also be removed from the
+# Select.pWin list.  Otherwise sqlite3WindowRewrite() still rewrites
+# them.  For a window function with the SQLITE_SUBTYPE property (such as
+# json_group_array()) the rewrite changes its arguments in place, and if
+# an argument is an aggregate of an outer query, the AggInfo of the
+# outer query is left pointing at changed or freed expressions.  An
+# SQLITE_DEBUG build fails an assert() in the self-checks at the end of
+# sqlite3Select().
+#
+.open :memory:
+.mode -reset list -colsep ' ' -rowsep ' '
+
+.testcase 100
+CREATE TABLE t1(x);
+CREATE TABLE t2(y);
+INSERT INTO t1 VALUES(1),(2);
+.check ''
+
+# EXISTS subquery
+.testcase 110
+SELECT EXISTS(SELECT 1 ORDER BY json_group_array(avg(x)) OVER ()) FROM t1;
+.check '1'
+
+.testcase 120
+SELECT EXISTS(SELECT 1 ORDER BY 1, json_group_object('a',avg(x)) OVER ()),
+       avg(x)
+  FROM t1;
+.check '1 1.5'
+
+.testcase 130
+SELECT x FROM t1 GROUP BY x
+ HAVING EXISTS(SELECT 1 ORDER BY jsonb_group_array(sum(x)) OVER ());
+.check '1 2'
+
+.testcase 140
+SELECT EXISTS(SELECT 1 FROM t1 AS a ORDER BY json_group_array(a.x+avg(t1.x)) OVER ())
+  FROM t1;
+.check '1'
+
+.testcase 150
+SELECT EXISTS(SELECT 1 ORDER BY json_group_array(avg(y)) OVER ()) FROM t2;
+.check '1'
+
+# FROM-clause subquery
+.testcase 200
+SELECT (SELECT count(*) FROM (SELECT 1 ORDER BY json_group_array(avg(x)) OVER ()), t1 AS b)
+  FROM t1;
+.check '2'
+
+.testcase 210
+SELECT (SELECT a FROM (SELECT 7 AS a ORDER BY json_group_array(avg(x)) OVER ()) ORDER BY a)
+  FROM t1;
+.check '7'
+
+.testcase 220
+.testctrl opt -OmitOrderBy
+SELECT (SELECT a FROM (SELECT 7 AS a ORDER BY json_group_array(avg(x)) OVER ()) ORDER BY a)
+  FROM t1;
+.testctrl opt +All
+.check '+All -OmitOrderBy 7 +All'
+
+# The test case found by fuzzing
+.testcase 300
+SELECT EXISTS(SELECT ? ORDER BY ?, json_group_array((avg(sql))) OVER ()) FROM sqlite_schema;
+.check '1'
