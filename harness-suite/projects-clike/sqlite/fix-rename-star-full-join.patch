Subject: [PATCH] resolve: handle a FULL JOIN coalesce() in resolveRenameStarTerm()

While parsing a view or trigger for ALTER TABLE, selectExpander() expands
"*" into "tbl.col" terms and marks them bStarName, so that an ORDER BY
identifier matching such a name can be turned into a direct column
reference that RENAME COLUMN then rewrites (check-in 0c0b346b86, upstream
f4ebb99, 2026-11-04). resolveRenameStarTerm() assumes the resolved term is
a TK_COLUMN, and check-in 7a751f226c (upstream 04f1c2c) wrapped that test
in ALWAYS(). It is not always true: if two FROM terms with the same name
are joined by a FULL JOIN with USING or NATURAL, "tbl.col" matches both
and lookupName() turns it into coalesce(tbl.col, tbl.col) (TK_FUNCTION).
Debug builds then fail "assert(0)" in resolveRenameStarTerm() on any
ALTER TABLE that re-parses the view:

    CREATE TABLE t(i);
    CREATE VIEW v AS SELECT * FROM t NATURAL FULL JOIN t ORDER BY i;
    ALTER TABLE t RENAME TO w;

Release builds skip the conversion. RENAME TO is unaffected, but RENAME
COLUMN leaves "ORDER BY i" alone and the statement fails with "error in
view v after rename: no such column: i" (or "1st ORDER BY term does not
match any column" for a compound SELECT), the failure that f4ebb99 fixed
for the other "*" cases. No memory-safety impact.

The coalesce() arguments are TK_COLUMN expressions in FROM-clause order,
and the left-most one is the column whose name "*" put into the result
set, so use it. RENAME COLUMN now rewrites the ORDER BY term, as it does
for "t NATURAL JOIN t". Regression test test/alterfjstar.sql (asserts on
the unpatched debug CLI; testcases 110-130 fail on an unpatched release
CLI).

Upstream: not reported; not fixed as of dc9b322 (master 2026-11-23). The
assert came in with 04f1c2c "Put ALWAYS() around two recently added
conditionals that cannot be FALSE" on top of f4ebb99 (bug report
2026-11-03T01:27:10Z); the GitHub mirror shows no later change to
resolveRenameStarTerm() (checked through 795e28a, 2026-11-23 19:49Z).
---
diff --git a/src/resolve.c b/src/resolve.c
index 792ab05..fbc4db9 100644
--- a/src/resolve.c
+++ b/src/resolve.c
@@ -1634,6 +1634,20 @@ static void resolveRenameStarTerm(
 ){
   if( IN_RENAME_OBJECT && pEList->a[iCol-1].fg.bStarName ){
     Expr *pX = pEList->a[iCol-1].pExpr;
+    if( pX->op==TK_FUNCTION ){
+      /* The "tbl.col" term generated by expanding "*" matched columns
+      ** of two or more FROM-clause terms named "tbl" joined by a FULL
+      ** JOIN with USING or NATURAL. Example:
+      **
+      **     SELECT * FROM t1 NATURAL FULL JOIN t1 ORDER BY a;
+      **
+      ** lookupName() has converted it into a coalesce() of all matching
+      ** columns, left-most first. The left-most column is the one that
+      ** supplied the result-set name that pE matched, so use it.  */
+      assert( sqlite3_stricmp(pX->u.zToken, "coalesce")==0 );
+      assert( ExprUseXList(pX) && pX->x.pList->nExpr>=2 );
+      pX = pX->x.pList->a[0].pExpr;
+    }
     if( ALWAYS(pX->op==TK_COLUMN) && ALWAYS(pE->op==TK_ID) ){
       pE->op = TK_COLUMN;
       pE->iTable = pX->iTable;
diff --git a/test/alterfjstar.sql b/test/alterfjstar.sql
new file mode 100644
index 0000000..31c397d
--- /dev/null
+++ b/test/alterfjstar.sql
@@ -0,0 +1,58 @@
+#!sqlite3
+#
+# 2026-11-23
+#
+# The author disclaims copyright to this source code.  In place of
+# a legal notice, here is a blessing:
+#
+#    May you do good and not evil.
+#    May you find forgiveness for yourself and forgive others.
+#    May you share freely, never taking more than you give.
+#
+#***********************************************************************
+#
+# ALTER TABLE on a view or trigger whose SELECT expands "*" over a FULL
+# JOIN with USING or NATURAL of two FROM-clause terms with the same name,
+# and has an ORDER BY term that matches the name of a column from the
+# USING clause.  While parsing for ALTER TABLE, "*" expands to "tbl.col"
+# and that term resolves to a coalesce() of the matching columns, not to
+# a TK_COLUMN.  Check-in [0c0b346b86b60dd3] (2026-11-04) did not expect
+# this: an assert() fails in resolveRenameStarTerm() and, in builds
+# without assert(), RENAME COLUMN fails with "no such column".
+#
+.open :memory:
+.mode list
+
+.testcase 100
+CREATE TABLE t(i);
+CREATE VIEW v AS SELECT * FROM t NATURAL FULL JOIN t ORDER BY 1,i;
+ALTER TABLE t RENAME TO w;
+SELECT sql FROM sqlite_schema WHERE name='v';
+.check 'CREATE VIEW v AS SELECT * FROM "w" NATURAL FULL JOIN "w" ORDER BY 1,i'
+
+.testcase 110
+CREATE TABLE t1(i, x);
+INSERT INTO t1 VALUES(2,'a'),(1,'b'),(3,'c');
+CREATE VIEW v1 AS SELECT * FROM t1 NATURAL FULL JOIN t1 ORDER BY i;
+ALTER TABLE t1 RENAME COLUMN i TO j;
+SELECT sql FROM sqlite_schema WHERE name='v1';
+SELECT x FROM v1;
+.check -glob 'CREATE VIEW v1 AS SELECT * FROM t1 NATURAL FULL JOIN t1 ORDER BY j*b*a*c*'
+
+.testcase 120
+CREATE TABLE t2(i);
+CREATE VIEW v2 AS
+  SELECT * FROM t2 NATURAL FULL JOIN t2 UNION ALL SELECT 1 ORDER BY i;
+ALTER TABLE t2 RENAME COLUMN i TO j;
+SELECT sql FROM sqlite_schema WHERE name='v2';
+.check -glob '*SELECT * FROM t2 NATURAL FULL JOIN t2 UNION ALL SELECT 1 ORDER BY j'
+
+.testcase 130
+CREATE TABLE t3(i);
+CREATE TRIGGER r3 AFTER INSERT ON t3 BEGIN
+  SELECT * FROM t3 NATURAL FULL JOIN t3 NATURAL FULL JOIN t3 ORDER BY i DESC;
+END;
+ALTER TABLE t3 RENAME COLUMN i TO j;
+ALTER TABLE t3 RENAME TO t3x;
+SELECT sql FROM sqlite_schema WHERE name='r3';
+.check -glob '*FROM "t3x" NATURAL FULL JOIN "t3x" NATURAL FULL JOIN "t3x" ORDER BY j DESC;*'
