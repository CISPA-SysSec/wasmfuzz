Subject: [PATCH] os_unix: fix SQLITE_DEBUG builds for WASI

A SQLITE_DEBUG build with the wasi-sdk (configure --with-wasi-sdk,
CFLAGS=-DSQLITE_DEBUG=1) fails, or links with unresolved imports, because
three debug-only bits of os_unix.c use code that WASI builds leave out:

- sqlite3_os_init() checks UNIX_SHM_BASE and UNIX_SHM_DMS in assert()s
  guarded by !SQLITE_OMIT_WAL, but the macros are only defined in the
  shared-memory section, which is compiled for
  !defined(SQLITE_WASI) && !defined(SQLITE_OMIT_WAL):
  "use of undeclared identifier 'UNIX_SHM_BASE'".
- SQLITE_FCNTL_FILESTAT (the debug-only sqlite_filestat() SQL function)
  calls unixDescribeShm(), which is defined in that same section:
  undefined symbol at link time.
- unixPosixAdvisoryLocks() calls getpid(), which wasi-libc only provides
  with -D_WASI_EMULATED_GETPID: undefined symbol at link time, reachable
  through sqlite_filestat() on a locked file. Use osGetpid(), as the rest
  of the file does; it is 1 for WASI, so the /proc lookup then fails and
  the function returns SQLITE_ERROR_UNABLE.

Use the shm code's guard for the first two. Release builds (NDEBUG,
no SQLITE_ENABLE_FILESTAT) compile the same code.

Applied only to the SQLITE_DEBUG tree (repo-debug) so that the release
modules stay byte-identical.

Not fixed upstream as of dc9b322 (master on 2026-11-23).
Upstream context: SQLite does not take pull requests; no matching
GitHub issue or PR found.
---
diff --git a/src/os_unix.c b/src/os_unix.c
index 15ef9ed..d6de2e4 100644
--- a/src/os_unix.c
+++ b/src/os_unix.c
@@ -647,7 +647,7 @@ static int unixPosixAdvisoryLocks(
         /*             1     */
         /*   012 4 678 01234 */
   memcpy(a, "---/-.---.-----", 16);
-  sqlite3_snprintf(sizeof(z), z, "/proc/%d/fdinfo/%d", getpid(), fd);
+  sqlite3_snprintf(sizeof(z), z, "/proc/%d/fdinfo/%d", osGetpid(0), fd);
   in = osOpen(z, O_RDONLY, 0);
   if( in<0 ){
     return SQLITE_ERROR_UNABLE;
@@ -4294,10 +4294,12 @@ static int unixFileControl(sqlite3_file *id, int op, void *pArg){
         }
       }
       unixEnterMutex();
+#if !defined(SQLITE_WASI) && !defined(SQLITE_OMIT_WAL)
       if( pFile->pShm ){
         sqlite3_str_appendall(pStr, ",\"shm\":");
         unixDescribeShm(pStr, pFile->pShm);
       }
+#endif
 #if SQLITE_MAX_MMAP_SIZE>0
       if( pFile->mmapSize ){
         sqlite3_str_appendf(pStr, ",\"mmapSize\":%lld", pFile->mmapSize);
@@ -8565,7 +8567,7 @@ int sqlite3_os_init(void){
   vxworksMutex = sqlite3MutexAlloc(SQLITE_MUTEX_STATIC_VFS2);
 #endif
 
-#ifndef SQLITE_OMIT_WAL
+#if !defined(SQLITE_WASI) && !defined(SQLITE_OMIT_WAL)
   /* Validate lock assumptions */
   assert( SQLITE_SHM_NLOCK==8 );  /* Number of available locks */
   assert( UNIX_SHM_BASE==120  );  /* Start of locking area */
