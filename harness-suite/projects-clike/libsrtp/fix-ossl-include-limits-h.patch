+++ b/crypto/cipher/aes_gcm_ossl.c
@@ -49,6 +49,7 @@
 #endif
 
 #include <openssl/evp.h>
+#include <limits.h>
 #include "aes_gcm.h"
 #include "alloc.h"
 #include "err.h" /* for srtp_debug */
