diff --git a/oss-fuzz/seek.cc b/oss-fuzz/seek.cc
index 0295eb88..49e52a1d 100644
--- a/oss-fuzz/seek.cc
+++ b/oss-fuzz/seek.cc
@@ -78,6 +78,62 @@ static void error_callback(const FLAC__StreamDecoder *decoder, FLAC__StreamDecod
 	errors_received_counter++;
 }
 
+#ifdef __wasi__
+/* wasm32-wasip1 port: instead of round-tripping the input through
+ * /tmp/tmp.flac and FLAC__stream_decoder_init_file(), serve it from memory
+ * with the same read/seek/tell/length/eof semantics as the stdio callbacks. */
+struct mem_source { const uint8_t *data; size_t size; size_t pos; };
+
+static FLAC__StreamDecoderReadStatus mem_read_callback(const FLAC__StreamDecoder *decoder, FLAC__byte buffer[], size_t *bytes, void *client_data)
+{
+	(void)decoder;
+	struct mem_source *src = (struct mem_source *)client_data;
+	if(*bytes == 0)
+		return FLAC__STREAM_DECODER_READ_STATUS_ABORT;
+	size_t n = src->size - src->pos;
+	if(n > *bytes)
+		n = *bytes;
+	memcpy(buffer, src->data + src->pos, n);
+	src->pos += n;
+	*bytes = n;
+	if(n == 0)
+		return FLAC__STREAM_DECODER_READ_STATUS_END_OF_STREAM;
+	return FLAC__STREAM_DECODER_READ_STATUS_CONTINUE;
+}
+
+static FLAC__StreamDecoderSeekStatus mem_seek_callback(const FLAC__StreamDecoder *decoder, FLAC__uint64 absolute_byte_offset, void *client_data)
+{
+	(void)decoder;
+	struct mem_source *src = (struct mem_source *)client_data;
+	/* fseeko() allows seeking past the end; reads then return EOF */
+	if(absolute_byte_offset > (FLAC__uint64)INT64_MAX)
+		return FLAC__STREAM_DECODER_SEEK_STATUS_ERROR;
+	src->pos = absolute_byte_offset > src->size ? src->size : (size_t)absolute_byte_offset;
+	return FLAC__STREAM_DECODER_SEEK_STATUS_OK;
+}
+
+static FLAC__StreamDecoderTellStatus mem_tell_callback(const FLAC__StreamDecoder *decoder, FLAC__uint64 *absolute_byte_offset, void *client_data)
+{
+	(void)decoder;
+	*absolute_byte_offset = ((struct mem_source *)client_data)->pos;
+	return FLAC__STREAM_DECODER_TELL_STATUS_OK;
+}
+
+static FLAC__StreamDecoderLengthStatus mem_length_callback(const FLAC__StreamDecoder *decoder, FLAC__uint64 *stream_length, void *client_data)
+{
+	(void)decoder;
+	*stream_length = ((struct mem_source *)client_data)->size;
+	return FLAC__STREAM_DECODER_LENGTH_STATUS_OK;
+}
+
+static FLAC__bool mem_eof_callback(const FLAC__StreamDecoder *decoder, void *client_data)
+{
+	(void)decoder;
+	struct mem_source *src = (struct mem_source *)client_data;
+	return src->pos >= src->size;
+}
+#endif
+
 
 extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
 {
@@ -120,12 +176,16 @@ extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
 	if(command_length >= size - 1 - CONFIG_LENGTH)
 		command_length = size - 1 - CONFIG_LENGTH;
 
+#ifdef __wasi__
+	struct mem_source src = { data+CONFIG_LENGTH+command_length, size-CONFIG_LENGTH-command_length, 0 };
+#else
 	/* Dump decoder input to file */
 	{
 		FILE * file_to_decode = fopen("/tmp/tmp.flac","w");
 		fwrite(data+CONFIG_LENGTH+command_length,1,size-CONFIG_LENGTH-command_length,file_to_decode);
 		fclose(file_to_decode);
 	}
+#endif
 
 	ogg = init_bools[0];
 
@@ -140,10 +200,17 @@ extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
 	/* initialize decoder */
 	if(decoder_valid) {
 		FLAC__StreamDecoderInitStatus init_status;
+#ifdef __wasi__
+		if(ogg)
+			init_status = FLAC__stream_decoder_init_ogg_stream(decoder, mem_read_callback, mem_seek_callback, mem_tell_callback, mem_length_callback, mem_eof_callback, write_callback, NULL, error_callback, &src);
+		else
+			init_status = FLAC__stream_decoder_init_stream(decoder, mem_read_callback, mem_seek_callback, mem_tell_callback, mem_length_callback, mem_eof_callback, write_callback, NULL, error_callback, &src);
+#else
 		if(ogg)
 			init_status = FLAC__stream_decoder_init_ogg_file(decoder, "/tmp/tmp.flac", write_callback, NULL, error_callback, NULL);
 		else
 			init_status = FLAC__stream_decoder_init_file(decoder, "/tmp/tmp.flac", write_callback, NULL, error_callback, NULL);
+#endif
 		if(init_status != FLAC__STREAM_DECODER_INIT_STATUS_OK) {
 			decoder_valid = false;
 		}
