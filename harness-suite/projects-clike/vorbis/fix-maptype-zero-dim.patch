--- /dev/null
+++ b/test/test_codebook_zero_dim.c
@@ -0,0 +1,222 @@
+/********************************************************************
+ *                                                                  *
+ * THIS FILE IS PART OF THE OggVorbis SOFTWARE CODEC SOURCE CODE.   *
+ * USE, DISTRIBUTION AND REPRODUCTION OF THIS LIBRARY SOURCE IS     *
+ * GOVERNED BY A BSD-STYLE SOURCE LICENSE INCLUDED WITH THIS SOURCE *
+ * IN 'COPYING'. PLEASE READ THESE TERMS BEFORE DISTRIBUTING.       *
+ *                                                                  *
+ * THE OggVorbis SOURCE CODE IS (C) COPYRIGHT 1994-2007             *
+ * by the Xiph.Org Foundation https://xiph.org/                     *
+ *                                                                  *
+ ********************************************************************
+
+ function: check that setup headers with value-mapped codebooks of
+           dimension 0 are rejected.
+
+ A codebook with lookup type 1 or 2 and dimension 0 used to be
+ accepted by vorbis_synthesis_headerin(). With lookup type 1,
+ vorbis_synthesis_init() then never returned (_book_maptype1_quantvals()
+ with dim 0); used as a residue 0 stage book, the first audio packet
+ divided by zero in vorbis_book_decodevs_add().
+
+ ********************************************************************/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <ogg/ogg.h>
+#include "vorbis/codec.h"
+
+static void write_magic(oggpack_buffer *opb, int type) {
+  const char *magic = "vorbis";
+  int i;
+  oggpack_write(opb, type, 8);
+  for (i = 0; i < 6; i++)
+    oggpack_write(opb, magic[i], 8);
+}
+
+static void build_id_header(oggpack_buffer *opb) {
+  oggpack_writeinit(opb);
+  write_magic(opb, 0x01);
+  oggpack_write(opb, 0, 32);      /* version */
+  oggpack_write(opb, 1, 8);       /* channels */
+  oggpack_write(opb, 48000, 32);  /* sample rate */
+  oggpack_write(opb, 0, 32);      /* bitrate_upper */
+  oggpack_write(opb, 0, 32);      /* bitrate_nominal */
+  oggpack_write(opb, 0, 32);      /* bitrate_lower */
+  oggpack_write(opb, 6, 4);       /* blocksize_0 = 64 */
+  oggpack_write(opb, 6, 4);       /* blocksize_1 = 64 */
+  oggpack_write(opb, 1, 1);       /* framing bit */
+}
+
+static void build_comment_header(oggpack_buffer *opb) {
+  oggpack_writeinit(opb);
+  write_magic(opb, 0x03);
+  oggpack_write(opb, 0, 32);      /* vendor string length */
+  oggpack_write(opb, 0, 32);      /* user comment list length */
+  oggpack_write(opb, 1, 1);       /* framing bit */
+}
+
+/* A codebook of two entries of length 1. */
+static void write_book(oggpack_buffer *opb, int dim, int maptype) {
+  int i, quantvals = 0;
+  oggpack_write(opb, 0x564342, 24);  /* sync */
+  oggpack_write(opb, dim, 16);
+  oggpack_write(opb, 2, 24);         /* entries */
+  oggpack_write(opb, 0, 1);          /* unordered */
+  oggpack_write(opb, 0, 1);          /* no unused entries */
+  oggpack_write(opb, 0, 5);          /* length 1 */
+  oggpack_write(opb, 0, 5);          /* length 1 */
+  oggpack_write(opb, maptype, 4);
+  if (maptype == 0)
+    return;
+  oggpack_write(opb, 0, 32);         /* q_min */
+  oggpack_write(opb, 0, 32);         /* q_delta */
+  oggpack_write(opb, 0, 4);          /* q_quant = 1 bit */
+  oggpack_write(opb, 0, 1);          /* q_sequencep */
+  if ((dim & 0xff) > 0)
+    quantvals = maptype == 1 ? 2 : 2 * (dim & 0xff);
+  for (i = 0; i < quantvals; i++)
+    oggpack_write(opb, 0, 1);
+}
+
+/* Codebook 0 is a valid dim 1 book; codebook 1 has the given dimension
+   and lookup type. The residue uses codebook 0 as its classbook and
+   codebook <stagebook> as its only stage book. */
+static void build_setup_header(oggpack_buffer *opb, int dim, int maptype,
+                               int stagebook) {
+  oggpack_writeinit(opb);
+  write_magic(opb, 0x05);
+  oggpack_write(opb, 1, 8);    /* 2 codebooks */
+  write_book(opb, 1, 1);
+  write_book(opb, dim, maptype);
+
+  oggpack_write(opb, 0, 6);    /* 1 time backend */
+  oggpack_write(opb, 0, 16);   /* type 0 */
+
+  oggpack_write(opb, 0, 6);    /* 1 floor */
+  oggpack_write(opb, 1, 16);   /* floor1 */
+  oggpack_write(opb, 0, 5);    /* partitions = 0 */
+  oggpack_write(opb, 0, 2);    /* multiplier - 1 */
+  oggpack_write(opb, 0, 4);    /* rangebits */
+
+  oggpack_write(opb, 0, 6);    /* 1 residue */
+  oggpack_write(opb, 0, 16);   /* residue0 */
+  oggpack_write(opb, 0, 24);   /* begin */
+  oggpack_write(opb, 32, 24);  /* end */
+  oggpack_write(opb, 31, 24);  /* partition size - 1 */
+  oggpack_write(opb, 0, 6);    /* classifications - 1 */
+  oggpack_write(opb, 0, 8);    /* classbook */
+  oggpack_write(opb, 1, 3);    /* cascade[0]: stage 0 */
+  oggpack_write(opb, 0, 1);    /* no high cascade bits */
+  oggpack_write(opb, stagebook, 8);
+
+  oggpack_write(opb, 0, 6);    /* 1 mapping */
+  oggpack_write(opb, 0, 16);   /* type 0 */
+  oggpack_write(opb, 0, 1);    /* 1 submap */
+  oggpack_write(opb, 0, 1);    /* no coupling */
+  oggpack_write(opb, 0, 2);    /* reserved */
+  oggpack_write(opb, 0, 8);    /* time submap (unused) */
+  oggpack_write(opb, 0, 8);    /* floor */
+  oggpack_write(opb, 0, 8);    /* residue */
+
+  oggpack_write(opb, 0, 6);    /* 1 mode */
+  oggpack_write(opb, 0, 1);    /* blockflag */
+  oggpack_write(opb, 0, 16);   /* windowtype */
+  oggpack_write(opb, 0, 16);   /* transformtype */
+  oggpack_write(opb, 0, 8);    /* mapping */
+
+  oggpack_write(opb, 1, 1);    /* framing bit */
+}
+
+static int headerin(vorbis_info *vi, vorbis_comment *vc,
+                    oggpack_buffer *opb, int packetno) {
+  ogg_packet op;
+  memset(&op, 0, sizeof(op));
+  op.packet = oggpack_get_buffer(opb);
+  op.bytes = oggpack_bytes(opb);
+  op.b_o_s = packetno == 0;
+  op.packetno = packetno;
+  return vorbis_synthesis_headerin(vi, vc, &op);
+}
+
+/* Returns 0 if the setup header is accepted (and the decoder initializes)
+   or rejected as expected, 1 otherwise. */
+static int run_test(int dim, int maptype, int stagebook, int expect_ok) {
+  vorbis_info vi;
+  vorbis_comment vc;
+  vorbis_dsp_state vd;
+  oggpack_buffer opb_id, opb_comment, opb_setup;
+  int ret, result = 0;
+
+  printf("  dim=0x%x maptype=%d stagebook=%d: ", dim, maptype, stagebook);
+
+  vorbis_info_init(&vi);
+  vorbis_comment_init(&vc);
+  build_id_header(&opb_id);
+  build_comment_header(&opb_comment);
+  build_setup_header(&opb_setup, dim, maptype, stagebook);
+
+  if (headerin(&vi, &vc, &opb_id, 0) != 0 ||
+      headerin(&vi, &vc, &opb_comment, 1) != 0) {
+    printf("FAIL: id or comment header rejected\n");
+    result = 1;
+    goto cleanup;
+  }
+
+  ret = headerin(&vi, &vc, &opb_setup, 2);
+  if (!expect_ok) {
+    if (ret == 0) {
+      printf("FAIL: setup header accepted\n");
+      result = 1;
+    } else {
+      printf("PASS: setup header rejected (ret=%d)\n", ret);
+    }
+    goto cleanup;
+  }
+  if (ret != 0) {
+    printf("FAIL: setup header rejected (ret=%d)\n", ret);
+    result = 1;
+    goto cleanup;
+  }
+  if (vorbis_synthesis_init(&vd, &vi) != 0) {
+    printf("FAIL: vorbis_synthesis_init failed\n");
+    result = 1;
+    goto cleanup;
+  }
+  vorbis_dsp_clear(&vd);
+  printf("PASS: accepted\n");
+
+cleanup:
+  oggpack_writeclear(&opb_id);
+  oggpack_writeclear(&opb_comment);
+  oggpack_writeclear(&opb_setup);
+  vorbis_comment_clear(&vc);
+  vorbis_info_clear(&vi);
+  return result;
+}
+
+int main(void) {
+  static const struct {
+    int dim, maptype, stagebook, expect_ok;
+  } tests[] = {
+    { 1,     1, 1, 1 },  /* valid books */
+    { 2,     2, 1, 1 },
+    { 0,     0, 0, 1 },  /* dim 0 without a value mapping stays valid */
+    { 0,     1, 0, 0 },  /* dim 0 with a value mapping, unused by residue */
+    { 0x200, 1, 0, 0 },  /* 16-bit dim field truncated to 0 */
+    { 0,     2, 0, 0 },
+    { 0,     2, 1, 0 },  /* ... and as residue stage book */
+    { 0,     1, 1, 0 },
+  };
+  int i, n = sizeof(tests) / sizeof(tests[0]), failures = 0;
+
+  printf("Testing codebooks of dimension 0...\n");
+  for (i = 0; i < n; i++)
+    failures += run_test(tests[i].dim, tests[i].maptype, tests[i].stagebook,
+                         tests[i].expect_ok);
+
+  printf("%d/%d tests passed.\n", n - failures, n);
+  return failures ? 1 : 0;
+}
