Subject: [PATCH] parser: Don't normalize a CR at the end of partial push input

The push parser normalizes CRLF to LF in character data. xmlParseChunk holds
back a CR at the end of a raw chunk until the next chunk arrives, but this
only works without an encoder: with UTF-16 the CR is followed by a zero byte
in the raw input (UTF-16LE), or the decoded text otherwise ends with a CR. If
the CR is then the last available character and at least
XML_PARSER_BIG_BUFFER_SIZE bytes of text are buffered, xmlParseCharDataComplex
normalizes it to LF on its own, and the LF at the start of the next chunk is
reported again: the push parser returns one more line feed than the pull
parser. Stop before such a CR in partial mode, like for "]" and incomplete
UTF-8 sequences, so it is handled together with the next character.

Found with the xml fuzzer ("pull/push parser roundtrip mismatch", UTF-16
documents with CRLF in long text). Regression test testPushUtf16CrLf in
testparser.c.

Not fixed upstream as of 21c8223.
Upstream: none found.
---
diff --git a/parser.c b/parser.c
index c77f4e0..bf4ff80 100644
--- a/parser.c
+++ b/parser.c
@@ -4715,6 +4715,15 @@ xmlParseCharDataComplex(xmlParserCtxtPtr ctxt, int partial) {
                     xmlFatalErr(ctxt, XML_ERR_MISPLACED_CDATA_END, NULL);
             }
         }
+        /*
+         * A CR at the end of partial input can be the first half of a
+         * CRLF. Don't normalize it to LF before the next character is
+         * available, or the LF would be reported twice. The CR hack in
+         * xmlParseChunk only covers raw input without an encoder.
+         */
+        if ((partial) && (cur == 0xA) && (CUR == 0xD) &&
+            (ctxt->input->end - ctxt->input->cur < 2))
+            break;
 
 	COPY_BUF(buf, nbchar, cur);
 	/* move current position before possible calling of ctxt->sax->characters */
@@ -4747,7 +4756,8 @@ xmlParseCharDataComplex(xmlParserCtxtPtr ctxt, int partial) {
                         "Incomplete UTF-8 sequence starting with %02X\n", CUR);
                 NEXTL(1);
             }
-        } else if ((cur != '<') && (cur != '&') && (cur != ']')) {
+        } else if ((cur != '<') && (cur != '&') && (cur != ']') &&
+                   (!((partial) && (cur == 0xA)))) {
             /* Generate the error and skip the offending character */
             xmlFatalErrMsgInt(ctxt, XML_ERR_INVALID_CHAR,
                               "PCDATA invalid Char value %d\n", cur);
diff --git a/testparser.c b/testparser.c
index 9149245..8e1026a 100644
--- a/testparser.c
+++ b/testparser.c
@@ -914,6 +914,70 @@ testHugeEncodedChunk(void) {
     return err;
 }
 
+static int
+testPushUtf16CrLf(void) {
+    int err = 0;
+    int be;
+
+    for (be = 0; be < 2; be++) {
+        const char *text1, *text2;
+        xmlParserCtxtPtr ctxt;
+        xmlChar *content;
+        char *chunk;
+        int len = 0, split, i;
+
+        /*
+         * Push UTF-16 text data with a CRLF split across chunks.
+         * The first chunk ends with the CR and holds enough data
+         * to trigger a "characters" SAX callback.
+         * (XML_PARSER_BIG_BUFFER_SIZE = 300)
+         */
+        text1 = "<doc>x";
+        text2 = "\r\ny</doc>";
+        chunk = malloc(2 * (strlen(text1) + 2000 + strlen(text2)) + 2);
+        chunk[len++] = be ? '\xFE' : '\xFF';
+        chunk[len++] = be ? '\xFF' : '\xFE';
+        for (i = 0; text1[i] != 0; i++) {
+            chunk[len++] = be ? 0 : text1[i];
+            chunk[len++] = be ? text1[i] : 0;
+        }
+        for (i = 0; i < 2000; i++) {
+            chunk[len++] = be ? 0 : 'x';
+            chunk[len++] = be ? 'x' : 0;
+        }
+        for (i = 0; text2[i] != 0; i++) {
+            chunk[len++] = be ? 0 : text2[i];
+            chunk[len++] = be ? text2[i] : 0;
+        }
+        split = len - 2 * (strlen(text2) - 1);
+
+        ctxt = xmlCreatePushParserCtxt(NULL, NULL, NULL, 0, NULL);
+        xmlCtxtSetOptions(ctxt, XML_PARSE_NOERROR);
+        xmlParseChunk(ctxt, chunk, split, 0);
+        xmlParseChunk(ctxt, chunk + split, len - split, 1);
+
+        if ((ctxt->myDoc == NULL) || (!ctxt->wellFormed)) {
+            fprintf(stderr, "testPushUtf16CrLf: parse failed\n");
+            err = 1;
+        } else {
+            content = xmlNodeGetContent(xmlDocGetRootElement(ctxt->myDoc));
+            if ((xmlStrlen(content) != 2003) ||
+                (xmlStrcmp(content + 2001, BAD_CAST "\ny") != 0)) {
+                fprintf(stderr, "testPushUtf16CrLf: wrong line end "
+                        "normalization (be=%d)\n", be);
+                err = 1;
+            }
+            xmlFree(content);
+        }
+
+        xmlFreeDoc(ctxt->myDoc);
+        xmlFreeParserCtxt(ctxt);
+        free(chunk);
+    }
+
+    return err;
+}
+
 static int
 testPushCDataEnd(void) {
     int err = 0;
@@ -2112,6 +2176,7 @@ main(void) {
     err |= testHugePush();
     err |= testHugeEncodedChunk();
     err |= testPushCDataEnd();
+    err |= testPushUtf16CrLf();
     err |= testPushPIInIntSubset();
 #endif
 #ifdef LIBXML_HTML_ENABLED
