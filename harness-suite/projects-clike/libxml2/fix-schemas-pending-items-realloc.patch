     nbItems = con->pending->nbItems;
     /*
     * Now that we have parsed *all* the schema document(s) and converted
@@ -20538,7 +20543,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * 7. Attribute prohibitions which had a "ref" attribute.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
 	    case XML_SCHEMA_TYPE_ELEMENT:
 		xmlSchemaResolveElementReferences(
@@ -20609,7 +20614,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * TODO: check for circular substitution groups.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	/*
 	* Let's better stop on the first error here.
 	*/
@@ -20651,7 +20656,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * such particles to the model group of the model group definition.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
 	    case XML_SCHEMA_TYPE_SEQUENCE:
 	    case XML_SCHEMA_TYPE_CHOICE:
@@ -20668,7 +20673,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * Expand attribute group references of attribute group definitions.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
             case XML_SCHEMA_TYPE_ATTRIBUTEGROUP:
 		if ((! WXS_ATTR_GROUP_EXPANDED(item)) &&
@@ -20691,7 +20696,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * circular union types in all cases.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
             case XML_SCHEMA_TYPE_SIMPLE:
 		if (WXS_IS_TYPE_NOT_FIXED_1((xmlSchemaTypePtr) item)) {
@@ -20711,7 +20716,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * be already computed.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
             case XML_SCHEMA_TYPE_SIMPLE:
 		if (((xmlSchemaTypePtr) item)->memberTypes != NULL) {
@@ -20733,7 +20738,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * Do the complete type fixup for simple types.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
             case XML_SCHEMA_TYPE_SIMPLE:
 		if (WXS_IS_TYPE_NOT_FIXED(WXS_TYPE_CAST item)) {
@@ -20754,7 +20759,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * Apply constraints for attribute declarations.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
 	    case XML_SCHEMA_TYPE_ATTRIBUTE:
 		xmlSchemaCheckAttrPropsCorrect(pctxt, WXS_ATTR_CAST item);
@@ -20770,7 +20775,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * Apply constraints for attribute uses.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
 	    case XML_SCHEMA_TYPE_ATTRIBUTE_USE:
 		if (((xmlSchemaAttributeUsePtr)item)->defValue != NULL) {
@@ -20790,7 +20795,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * Apply constraints for attribute group definitions.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
 	case XML_SCHEMA_TYPE_ATTRIBUTEGROUP:
 	    if (( (WXS_ATTR_GROUP_CAST item)->attrUses != NULL) &&
@@ -20838,14 +20843,13 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     * The list could have changed, since xmlSchemaFixupComplexType()
     * will create particles and model groups in some cases.
     */
-    items = (xmlSchemaTreeItemPtr *) con->pending->items;
     nbItems = con->pending->nbItems;
 
     /*
     * Apply some constraints for element declarations.
     */
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
 	    case XML_SCHEMA_TYPE_ELEMENT:
 		elemDecl = (xmlSchemaElementPtr) item;
@@ -20886,7 +20890,7 @@ xmlSchemaFixupComponents(xmlSchemaParserCtxtPtr pctxt,
     */
 
     for (i = 0; i < nbItems; i++) {
-	item = items[i];
+	item = con->pending->items[i];
 	switch (item->type) {
 	    case XML_SCHEMA_TYPE_COMPLEX:
 		xmlSchemaBuildContentModel((xmlSchemaTypePtr) item, pctxt);
