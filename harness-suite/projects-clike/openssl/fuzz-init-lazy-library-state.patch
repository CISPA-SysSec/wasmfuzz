diff --git a/fuzz/server.c b/fuzz/server.c
index a06d872d1d..27deaa09a3 100644
--- a/fuzz/server.c
+++ b/fuzz/server.c
@@ -25,6 +25,8 @@
 #include <openssl/err.h>
 #include "fuzzer.h"
 
+static SSL_CTX *server_ctx_new(void);
+
 #ifndef OPENSSL_NO_DEPRECATED_3_0
 static const uint8_t kCertificateDER[] = {
     0x30, 0x82, 0x02, 0xff, 0x30, 0x82, 0x01, 0xe7,
@@ -578,6 +580,11 @@ time_t time(time_t *t) TIME_IMPL(t)
     FuzzerSetRand();
     OPENSSL_init_crypto(OPENSSL_INIT_LOAD_CRYPTO_STRINGS | OPENSSL_INIT_ASYNC, NULL);
     OPENSSL_init_ssl(OPENSSL_INIT_LOAD_SSL_STRINGS, NULL);
+    /*
+     * Do the provider fetches and key decodes of the input-independent
+     * server_ctx_new() once here.
+     */
+    SSL_CTX_free(server_ctx_new());
     ERR_clear_error();
     CRYPTO_free_ex_index(0, -1);
     if (SSL_get_ex_data_X509_STORE_CTX_idx() == 0) {
@@ -638,27 +645,21 @@ static int use_pem_cert(SSL_CTX *ctx, const void *pem, size_t pem_len)
 }
 #endif
 
-int FuzzerTestOneInput(const uint8_t *buf, size_t len)
+/* The server context with its fixed keys and certificates. */
+static SSL_CTX *server_ctx_new(void)
 {
-    SSL *server = NULL;
-    BIO *in;
-    BIO *out;
     SSL_CTX *ctx;
 #ifndef OPENSSL_NO_DEPRECATED_3_0
     const uint8_t *bufp;
     RSA *privkey = NULL;
     EVP_PKEY *pkey = NULL;
     X509 *cert = NULL;
-#endif
-    uint8_t opt;
     int ret;
-
-    if (len < 2 || len > INT_MAX)
-        return 0;
+#endif
 
     ctx = SSL_CTX_new(TLS_method());
     if (ctx == NULL)
-        return 0;
+        return NULL;
     if (SSL_CTX_set_min_proto_version(ctx, 0) != 1)
         goto end;
     if (SSL_CTX_set_cipher_list(ctx, "ALL:eNULL:@SECLEVEL=0") != 1)
@@ -712,6 +713,29 @@ int FuzzerTestOneInput(const uint8_t *buf, size_t len)
         goto end;
 #endif
 
+    return ctx;
+
+end:
+    SSL_CTX_free(ctx);
+    return NULL;
+}
+
+int FuzzerTestOneInput(const uint8_t *buf, size_t len)
+{
+    SSL *server = NULL;
+    BIO *in;
+    BIO *out;
+    SSL_CTX *ctx;
+    uint8_t opt;
+    int ret;
+
+    if (len < 2 || len > INT_MAX)
+        return 0;
+
+    ctx = server_ctx_new();
+    if (ctx == NULL)
+        goto end;
+
     server = SSL_new(ctx);
     if (server == NULL)
         goto end;
