Subject: [PATCH] fuzz: build lazily initialised library state in FuzzerInitialize()

These fuzzers paid OpenSSL's one-time lazy initialisation in their first
FuzzerTestOneInput() call: the error strings and config (smime, x509v3,
cms_verify and pkcs7_verify had an empty FuzzerInitialize()), the namemap and
provider key managers/decoders behind the first public key decode (cms,
pkcs7_verify, cmp), the decoder-cache template of the constant
OSSL_DECODER_CTX_new_for_pkey() query (decoder; d2i_AutoPrivateKey() in asn1),
the encoders of EVP_PKEY_print_*() (decoder), the fetches of SSL_CTX_new()
(client, server) and OSSL_CMP_CTX_new() (cmp), and server's fixed key and
certificate decodes (moved unchanged into server_ctx_new()). Do that once in
FuzzerInitialize(), so a fresh process starts where a long-running fuzzer is
after its first input: every input runs the same code as before, on the
cache-hit paths. No related upstream PR or issue (gh, 2026-11-21); open
openssl/openssl#30439 adds SSL_COMP #ifdefs next to the client.c/server.c hunks.
Drop when upstream builds this state in FuzzerInitialize().

diff --git a/fuzz/asn1.c b/fuzz/asn1.c
index 2ceed4b548..a0ef2d2ada 100644
--- a/fuzz/asn1.c
+++ b/fuzz/asn1.c
@@ -36,6 +36,7 @@
 #include <openssl/rand.h>
 #include <openssl/bio.h>
 #include <openssl/evp.h>
+#include <openssl/decoder.h>
 #include <openssl/ssl.h>
 #include <openssl/x509_acert.h>
 #include "internal/nelem.h"
@@ -285,6 +286,8 @@ static ASN1_PCTX *pctx;
 
 int FuzzerInitialize(int *argc, char ***argv)
 {
+    EVP_PKEY *pkey = NULL;
+
     FuzzerSetRand();
     pctx = ASN1_PCTX_new();
     if (pctx == NULL)
@@ -294,6 +297,12 @@ int FuzzerInitialize(int *argc, char ***argv)
 
     OPENSSL_init_crypto(OPENSSL_INIT_LOAD_CRYPTO_STRINGS, NULL);
     OPENSSL_init_ssl(OPENSSL_INIT_LOAD_SSL_STRINGS, NULL);
+    /*
+     * Build the decoder context that d2i_AutoPrivateKey() gets from the
+     * decoder cache for input that is not PKCS#8 (see crypto/asn1/d2i_pr.c).
+     */
+    OSSL_DECODER_CTX_free(OSSL_DECODER_CTX_new_for_pkey(&pkey, "DER",
+        "type-specific", NULL, EVP_PKEY_KEYPAIR, NULL, NULL));
     ERR_clear_error();
     CRYPTO_free_ex_index(0, -1);
 
diff --git a/fuzz/client.c b/fuzz/client.c
index 8ed77ea8cd..47be7be317 100644
--- a/fuzz/client.c
+++ b/fuzz/client.c
@@ -45,6 +45,8 @@ time_t time(time_t *t) TIME_IMPL(t)
     FuzzerSetRand();
     OPENSSL_init_crypto(OPENSSL_INIT_LOAD_CRYPTO_STRINGS | OPENSSL_INIT_ASYNC, NULL);
     OPENSSL_init_ssl(OPENSSL_INIT_LOAD_SSL_STRINGS, NULL);
+    /* Fetch the provider algorithms that every SSL_CTX_new() fetches. */
+    SSL_CTX_free(SSL_CTX_new(TLS_method()));
     ERR_clear_error();
     CRYPTO_free_ex_index(0, -1);
     if (SSL_get_ex_data_X509_STORE_CTX_idx() != 0) {
diff --git a/fuzz/cmp.c b/fuzz/cmp.c
index ae4dcc033d..2e77f7c0b0 100644
--- a/fuzz/cmp.c
+++ b/fuzz/cmp.c
@@ -14,13 +14,30 @@
 #include <openssl/bio.h>
 #include <openssl/cmp.h>
 #include "../crypto/cmp/cmp_local.h"
+#include <openssl/decoder.h>
 #include <openssl/err.h>
 #include "fuzzer.h"
 
+static void prefetch_keymgmt(EVP_KEYMGMT *keymgmt, void *arg)
+{
+}
+
+static void prefetch_decoder(OSSL_DECODER *decoder, void *arg)
+{
+}
+
 int FuzzerInitialize(int *argc, char ***argv)
 {
     FuzzerSetRand();
     OPENSSL_init_crypto(OPENSSL_INIT_LOAD_CRYPTO_STRINGS, NULL);
+    /*
+     * Construct the provider key managers and decoders once here rather
+     * than in the first public key decode.
+     */
+    EVP_KEYMGMT_do_all_provided(NULL, prefetch_keymgmt, NULL);
+    OSSL_DECODER_do_all_provided(NULL, prefetch_decoder, NULL);
+    /* Fetch what every OSSL_CMP_CTX_new() fetches. */
+    OSSL_CMP_CTX_free(OSSL_CMP_CTX_new(NULL, NULL));
     ERR_clear_error();
     CRYPTO_free_ex_index(0, -1);
     return 1;
diff --git a/fuzz/cms.c b/fuzz/cms.c
