diff --git a/fuzz/decoder.c b/fuzz/decoder.c
index ab5dd3112b..2a739210b6 100644
--- a/fuzz/decoder.c
+++ b/fuzz/decoder.c
@@ -9,14 +9,21 @@
  */
 
 #include <openssl/decoder.h>
+#include <openssl/encoder.h>
 #include <openssl/err.h>
 #include <openssl/rand.h>
 #include "fuzzer.h"
 
 static ASN1_PCTX *pctx;
 
+static void prefetch_encoder(OSSL_ENCODER *encoder, void *arg)
+{
+}
+
 int FuzzerInitialize(int *argc, char ***argv)
 {
+    EVP_PKEY *pkey = NULL;
+
     FuzzerSetRand();
 
     OPENSSL_init_crypto(OPENSSL_INIT_LOAD_CRYPTO_STRINGS
@@ -30,6 +37,14 @@ int FuzzerInitialize(int *argc, char ***argv)
     ASN1_PCTX_set_flags(pctx, ASN1_PCTX_FLAGS_SHOW_ABSENT | ASN1_PCTX_FLAGS_SHOW_SEQUENCE | ASN1_PCTX_FLAGS_SHOW_SSOF | ASN1_PCTX_FLAGS_SHOW_TYPE | ASN1_PCTX_FLAGS_SHOW_FIELD_STRUCT_NAME);
     ASN1_PCTX_set_str_flags(pctx, ASN1_STRFLGS_UTF8_CONVERT | ASN1_STRFLGS_SHOW_TYPE | ASN1_STRFLGS_DUMP_ALL);
 
+    /*
+     * Build the decoder context that FuzzerTestOneInput() gets from the
+     * decoder cache, and construct the encoders that EVP_PKEY_print_*() use.
+     */
+    OSSL_DECODER_CTX_free(OSSL_DECODER_CTX_new_for_pkey(&pkey, NULL, NULL,
+        NULL, 0, NULL, NULL));
+    OSSL_ENCODER_do_all_provided(NULL, prefetch_encoder, NULL);
+
     ERR_clear_error();
     CRYPTO_free_ex_index(0, -1);
     return 1;
diff --git a/fuzz/pkcs7_verify.c b/fuzz/pkcs7_verify.c
index a167afb13d..bc1614af78 100644
--- a/fuzz/pkcs7_verify.c
+++ b/fuzz/pkcs7_verify.c
@@ -9,12 +9,32 @@
  */
 #include <limits.h>
 #include <openssl/bio.h>
+#include <openssl/decoder.h>
 #include <openssl/err.h>
+#include <openssl/evp.h>
 #include <openssl/pkcs7.h>
 #include "fuzzer.h"
 
+static void prefetch_keymgmt(EVP_KEYMGMT *keymgmt, void *arg)
+{
