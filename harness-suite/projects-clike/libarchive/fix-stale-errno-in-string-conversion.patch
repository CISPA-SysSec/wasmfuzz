+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 Florian Bauckholt
+ * All rights reserved.
+ */
+#include "test.h"
+
+#include <errno.h>
+#include <locale.h>
+
+/*
+ * Callers of the string conversion functions tell an allocation failure
+ * from a name that does not convert by checking errno == ENOMEM, but the
+ * conversions can fail without setting errno.  An ENOMEM left over from an
+ * unrelated earlier allocation failure then made archive_entry_pathname_utf8()
+ * call __archive_errx() ("No memory") and exit the process, and made format
+ * readers return ARCHIVE_FATAL ("Can't allocate memory for Pathname") instead
+ * of a warning.
+ */
+DEFINE_TEST(test_entry_stale_errno)
+{
+	struct archive_entry *e;
+
+	if (NULL == setlocale(LC_ALL, "en_US.UTF-8")) {
+		skipping("en_US.UTF-8 locale not available on this system.");
+		return;
+	}
+	assert((e = archive_entry_new()) != NULL);
+	/* Not valid UTF-8, so it does not convert to UTF-8. */
+	archive_entry_copy_pathname(e, "a\xff" "b");
+	errno = ENOMEM;
+	assert(archive_entry_pathname_utf8(e) == NULL);
+	assert(errno != ENOMEM);
+	archive_entry_free(e);
+}
