+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 Florian Bauckholt
+ * All rights reserved.
+ */
+#include "test.h"
+
+/*
+ * A directory extent is a 32-bit byte count.  read_children() rounds it up
+ * to whole logical blocks and stores the result in a size_t.  With a size
+ * of 0xFFFFFFFF and a logical block size that is not a power of two (2080
+ * here, which the PVD checks accept), the rounded value exceeds 4 GiB and a
+ * 32-bit size_t truncates it to 1824, less than one block.  The loop that
+ * walks the blocks then subtracts a whole block from that step, wraps
+ * around, and reads past the end of the read-ahead buffer.
+ *
+ * The reader must fail with ARCHIVE_FATAL instead.  On 64-bit hosts the
+ * oversized read-ahead fails anyway, so only 32-bit builds can fail here
+ * without the fix (with an out-of-bounds read).
+ */
+
+#define BS 2080
+#define IMG_SIZE 49152
+
+static void
+set723(unsigned char *p, unsigned v)
+{
+	p[0] = v & 0xff; p[1] = (v >> 8) & 0xff;
+	p[2] = (v >> 8) & 0xff; p[3] = v & 0xff;
+}
+
+static void
+set733(unsigned char *p, unsigned long v)
+{
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		p[i] = (v >> (8 * i)) & 0xff;
+		p[7 - i] = (v >> (8 * i)) & 0xff;
+	}
+}
+
+static void
+make_dir_record(unsigned char *p, unsigned extent, unsigned long size,
+    unsigned char name)
+{
+	p[0] = 34;			/* record length */
+	set733(p + 2, extent);
+	set733(p + 10, size);
+	p[25] = 2;			/* directory */
+	set723(p + 28, 1);		/* volume sequence number */
+	p[32] = 1;			/* name length */
+	p[33] = name;
+}
+
+DEFINE_TEST(test_read_format_iso_dir_size_overflow)
+{
+	struct archive_entry *ae;
+	struct archive *a;
+	unsigned char *img, *pvd, *term;
+
+	assert((img = calloc(1, IMG_SIZE)) != NULL);
+	pvd = img + 16 * 2048;
+	term = img + 17 * 2048;
+
+	pvd[0] = 1;
+	memcpy(pvd + 1, "CD001", 5);
+	pvd[6] = 1;
+	set733(pvd + 80, 0x400000);	/* volume space size, in blocks */
+	set723(pvd + 120, 1);		/* volume set size */
+	set723(pvd + 124, 1);		/* volume sequence number */
+	set723(pvd + 128, BS);		/* logical block size */
+	set733(pvd + 132, 10);		/* path table size */
+	pvd[140] = 18;			/* type L path table location */
+	make_dir_record(pvd + 156, 20, 2048, 0);
+	pvd[881] = 1;			/* file structure version */
+	term[0] = 255;
+	memcpy(term + 1, "CD001", 5);
+	term[6] = 1;
+	/* The root directory's own "." record claims 0xFFFFFFFF bytes. */
+	make_dir_record(img + 20 * 2048, 20, 0xFFFFFFFFUL, 0);
+	make_dir_record(img + 20 * 2048 + 34, 20, 2048, 1);
+
+	assert((a = archive_read_new()) != NULL);
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_support_format_iso9660(a));
+	assertEqualIntA(a, ARCHIVE_OK,
+	    archive_read_open_memory(a, img, IMG_SIZE));
+	assertEqualIntA(a, ARCHIVE_FATAL, archive_read_next_header(a, &ae));
+	assertEqualInt(ARCHIVE_OK, archive_read_free(a));
+	free(img);
+}
