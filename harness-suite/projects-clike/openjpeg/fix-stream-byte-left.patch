+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED.  IN NO EVENT SHALL THE COPYRIGHT OWNER OR CONTRIBUTORS BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * Non-regression test: a TLM marker whose tile-part lengths add up to more
+ * than the codestream makes the decoder seek to a tile-part offset past the
+ * end of the stream. The seek callback below keeps the position in 32 bits,
+ * as the in-memory callbacks of tests/fuzzers/ do on hosts with a 32-bit
+ * size_t, so the seek "succeeds" at offset mod 2^32 and the next reads return
+ * data. opj_stream_get_number_byte_left() then saw a byte offset beyond the
+ * declared stream length and failed an assert(); decoding must fail or stop
+ * cleanly instead.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "openjpeg.h"
+
+static void quiet_callback(const char *msg, void *client_data)
+{
+    (void)msg;
+    (void)client_data;
+}
+
+typedef struct {
+    const unsigned char *data;
+    OPJ_UINT32 len;
+    OPJ_UINT32 pos; /* 32-bit position, as with a 32-bit size_t */
+} mem_stream_t;
+
+static OPJ_SIZE_T mem_read(void *buf, OPJ_SIZE_T n, void *user)
+{
+    mem_stream_t *m = (mem_stream_t *)user;
+    OPJ_UINT32 avail;
+    if (m->pos >= m->len) {
+        return (OPJ_SIZE_T) - 1;
+    }
+    avail = m->len - m->pos;
+    if (n > avail) {
+        n = avail;
+    }
+    memcpy(buf, m->data + m->pos, n);
+    m->pos += (OPJ_UINT32)n;
+    return n;
+}
+
+static OPJ_OFF_T mem_skip(OPJ_OFF_T n, void *user)
+{
+    mem_stream_t *m = (mem_stream_t *)user;
+    m->pos += (OPJ_UINT32)n;
+    return n;
+}
+
+static OPJ_BOOL mem_seek(OPJ_OFF_T n, void *user)
+{
+    mem_stream_t *m = (mem_stream_t *)user;
+    m->pos = (OPJ_UINT32)n;
+    return OPJ_TRUE;
+}
+
+static void put16(unsigned char **p, OPJ_UINT32 v)
+{
+    *(*p)++ = (unsigned char)(v >> 8);
+    *(*p)++ = (unsigned char)v;
+}
+
+static void put32(unsigned char **p, OPJ_UINT32 v)
+{
+    put16(p, v >> 16);
+    put16(p, v & 0xffff);
+}
+
+/* SOT + SOD of an empty tile-part */
+static void put_tile_part(unsigned char **p, OPJ_UINT32 tile,
+                          OPJ_UINT32 psot, OPJ_UINT32 tpsot,
+                          OPJ_UINT32 tnsot)
+{
+    put16(p, 0xff90);
+    put16(p, 10);
+    put16(p, tile);
+    put32(p, psot);
+    *(*p)++ = (unsigned char)tpsot;
+    *(*p)++ = (unsigned char)tnsot;
+    put16(p, 0xff93);
+}
+
+int main(void)
+{
+    unsigned char cs[256];
+    unsigned char *p = cs;
+    OPJ_UINT32 main_header_end, tp1_offset;
+    mem_stream_t m;
+    opj_codec_t *codec;
+    opj_stream_t *stream;
+    opj_image_t *image = NULL;
+    opj_dparameters_t params;
+
+    /* Main header: 2x1 tiles of 16x16, one 8-bit component. */
+    put16(&p, 0xff4f);              /* SOC */
+    put16(&p, 0xff51);              /* SIZ */
+    put16(&p, 41);
+    put16(&p, 0);                   /* Rsiz */
+    put32(&p, 32);                  /* Xsiz */
+    put32(&p, 16);                  /* Ysiz */
+    put32(&p, 0);                   /* XOsiz */
+    put32(&p, 0);                   /* YOsiz */
+    put32(&p, 16);                  /* XTsiz */
+    put32(&p, 16);                  /* YTsiz */
+    put32(&p, 0);                   /* XTOsiz */
+    put32(&p, 0);                   /* YTOsiz */
+    put16(&p, 1);                   /* Csiz */
+    *p++ = 7;                       /* Ssiz: 8 bits unsigned */
+    *p++ = 1;                       /* XRsiz */
+    *p++ = 1;                       /* YRsiz */
+    put16(&p, 0xff52);              /* COD */
+    put16(&p, 12);
+    *p++ = 0;                       /* Scod */
+    *p++ = 0;                       /* LRCP */
+    put16(&p, 1);                   /* layers */
+    *p++ = 0;                       /* no MCT */
+    *p++ = 0;                       /* 0 decomposition levels */
+    *p++ = 4;                       /* code-block 64x64 */
+    *p++ = 4;
+    *p++ = 0;                       /* code-block style */
+    *p++ = 1;                       /* 5-3 reversible */
+    put16(&p, 0xff5c);              /* QCD */
+    put16(&p, 4);
+    *p++ = 0;                       /* no quantization, 0 guard bits */
+    *p++ = 8 << 3;
+    /* TLM, Stlm: 8-bit Ttlm, 32-bit Ptlm. Tile 0 is split into the two
+     * tile-parts at the start of the tile data, but the TLM entries put a
+     * tile-part of tile 1 of 2^32 - 1 bytes between them, so the second
+     * tile-part of tile 0 is announced 2^32 bytes after its real offset. */
+    put16(&p, 0xff55);
+    put16(&p, 4 + 3 * 5);
+    *p++ = 0;                       /* Ztlm */
+    *p++ = 0x50;                    /* Stlm */
+    *p++ = 0;                       /* tile 0, first tile-part */
+    put32(&p, 0xffffffffU);
+    *p++ = 1;                       /* tile 1 */
+    put32(&p, 15);
+    *p++ = 0;                       /* tile 0, second tile-part */
+    put32(&p, 0);
+    main_header_end = (OPJ_UINT32)(p - cs);
+
+    /* the real tile-parts */
+    put_tile_part(&p, 0, 14, 0, 2);
+    tp1_offset = (OPJ_UINT32)(p - cs);
+    put_tile_part(&p, 0, 0, 1, 2);
+    put16(&p, 0xffd9);              /* EOC */
+
+    /* TLM puts the second tile-part of tile 0 at
+     * main_header_end + (2^32 - 1) + 15 == tp1_offset + 2^32 */
+    if (tp1_offset != main_header_end + 14) {
+        fprintf(stderr, "test_tlm_seek_past_end: bad layout\n");
+        return EXIT_FAILURE;
+    }
+
+    m.data = cs;
+    m.len = (OPJ_UINT32)(p - cs);
+    m.pos = 0;
+
+    codec = opj_create_decompress(OPJ_CODEC_J2K);
+    opj_set_info_handler(codec, quiet_callback, NULL);
+    opj_set_warning_handler(codec, quiet_callback, NULL);
+    opj_set_error_handler(codec, quiet_callback, NULL);
+    opj_set_default_decoder_parameters(&params);
+    opj_setup_decoder(codec, &params);
+
+    stream = opj_stream_create(1024, OPJ_TRUE);
+    opj_stream_set_user_data(stream, &m, NULL);
+    opj_stream_set_user_data_length(stream, m.len);
+    opj_stream_set_read_function(stream, mem_read);
+    opj_stream_set_skip_function(stream, mem_skip);
+    opj_stream_set_seek_function(stream, mem_seek);
+
+    if (!opj_read_header(stream, codec, &image)) {
+        fprintf(stderr, "test_tlm_seek_past_end: opj_read_header failed\n");
+        opj_stream_destroy(stream);
+        opj_destroy_codec(codec);
+        return EXIT_FAILURE;
+    }
+    /* Decode tile 0 only: the decoder then seeks to its tile-parts by the
+     * TLM offsets. The result does not matter, only that it returns. */
+    if (opj_set_decode_area(codec, image, 0, 0, 16, 16)) {
+        (void)opj_decode(codec, stream, image);
+        (void)opj_end_decompress(codec, stream);
+    }
+
+    opj_image_destroy(image);
+    opj_stream_destroy(stream);
+    opj_destroy_codec(codec);
+    printf("test_tlm_seek_past_end: OK\n");
+    return EXIT_SUCCESS;
+}
